---
import '../styles/global.css';
// One family, two axes (weight and width): display type is the same face pulled narrower and tighter.
import fontUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-standard-normal.woff2?url';
import routes from '../data/routes.json';
import logoLight from '../assets/brand/me2-logo-light.svg?raw';
import { config, flags, isFixture, siteUrl } from '../config';

interface Props {
  /** Path as listed in src/data/routes.json */
  path: string;
  /** JSON-LD objects for this page */
  schema?: object[];
}
const { path, schema = [] } = Astro.props;
const route = routes.find((r) => r.path === path);
if (!route) throw new Error(`No entry for ${path} in src/data/routes.json`);

const base = isFixture ? 'https://example.com' : siteUrl;
const canonical = new URL(path === '/404.html' ? '/' : path, base).href;
const ogImage = new URL(route.ogImage, base).href;
const ogTitle = route.ogTitle ?? route.title;
const noindex = route.noindex || isFixture;
const fontFace = `@font-face{font-family:'Instrument Sans Variable';font-style:normal;font-display:swap;font-weight:400 700;font-stretch:75% 100%;src:url(${fontUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}`;
---
<!doctype html>
<html lang={config.LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{route.title}</title>
    <meta name="description" content={route.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f2ea" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.SITE_NAME} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={route.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={config.LOCALE.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={route.description} />
    <meta name="twitter:image" content={ogImage} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {flags.enableTracking && config.GA4_MEASUREMENT_ID && (
      <script define:vars={{ ga4Id: config.GA4_MEASUREMENT_ID, liveHost: config.SITE_DOMAIN }}>
        // Google Analytics 4 (EC, 22 Oct 2026; docs/analytics.md): Google's gtag snippet, run only on the live domain so
        // previews and local checks never count as visits. The Google hosts it talks to are allowed in public/_headers.
        if (location.hostname === liveHost) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', ga4Id);
          const tag = document.createElement('script');
          tag.async = true;
          tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
          document.head.appendChild(tag);
        }
      </script>
    )}
  </head>
  <body>
    <!-- The logo's paths, once. Logo.astro points at this group, so the large traced path isn't repeated in every logo. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><g id="me2-logo-light" set:html={logoLight.replace(/^[\s\S]*?<\/title>/, '').replace(/<\/svg>\s*$/, '')} /></defs></svg>
    <slot />
    <script>
      // Sections marked .render-later are only laid out near the screen (faster loading). Before any jump
      // to a section, by link or by an address with #, lay everything out so the jump lands in the right place.
      const renderAll = () => document.documentElement.classList.add('render-all');
      if (location.hash) renderAll();
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (a && a.pathname === location.pathname) renderAll();
      }, { capture: true });
      addEventListener('hashchange', renderAll);
    </script>
  </body>
</html>
