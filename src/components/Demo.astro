---
import Emph from './Emph.astro';
import { content } from '../content/site';
interface Props { n: number }
const { n } = Astro.props;
const c = content.demo;
---
<section id="demo" class="section demo on-dark" aria-labelledby="demo-title">
  <div class="wrap">
    <p class="label">{c.eyebrow}<sup>{n}</sup></p>
    <div class="head">
      <h2 id="demo-title"><Emph text={c.h2} /></h2>
      <p class="lede">{c.intro}</p>
    </div>

    <!-- Plain-language version of the animation for screen readers. -->
    <p class="sr-only">{c.srSummary}</p>

    <div class="doc reveal" data-demo aria-hidden="true">
      <div class="doc-bar">
        <span class="doc-title">{c.windowTitle}</span>
        <span class="status" data-status><i></i><span data-status-text>{c.status.done}</span></span>
      </div>
      <div class="panes">
        <div class="pane">
          <p class="pane-label">{c.roleLabel}</p>
          <p class="doc-heading">{c.draftTitle}</p>
          <ul class="lines">
            {c.lines.map((l, i) => (
              <li class="line" data-line={i}>
                <span class="unit">{l.unit}</span>
                <span class="days">{l.days}</span>
                {l.amountFixed ? (
                  <span class="amount" data-amount><s class="wrong">{l.amount}</s><b class="right">{l.amountFixed}</b></span>
                ) : (
                  <span class="amount">{l.amount}</span>
                )}
              </li>
            ))}
            <li class="line suggestion" data-line={c.lines.length}>{c.suggestion}</li>
          </ul>
          <div class="ledger">
            <p class="pane-label">{c.ledgerTitle}</p>
            <table>
              <tbody>
                {c.ledger.map((r, i) => (
                  <tr data-ledger={i}><td>{r.unit}</td><td>{r.days}</td><td>{r.amount}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="pane">
          <p class="pane-label">{c.operatorLabel}</p>
          <ol class="checks">
            {c.checks.map((label, i) => (
              <li class="check" data-check={i} data-fails={i === c.failIndex ? 'true' : undefined}>
                <span class="box"></span>
                <span class="check-label">{label}</span>
                {i === c.failIndex && <span class="fix-note">{c.failNote}</span>}
              </li>
            ))}
          </ol>
          <p class="signoff" data-signoff><span class="seal"></span>{c.signoff}</p>
        </div>
      </div>
    </div>
    <div class="below">
      <p class="note">{c.note}</p>
      <button type="button" class="replay tlink" data-replay>{c.replay}</button>
    </div>
  </div>
</section>
<script type="application/json" data-demo-labels set:html={JSON.stringify(c.status)} />

<script>
  // Plays once when it scrolls into view; "Replay" runs it again. Reduced motion: finished state.
  type Phase = 'drafting' | 'checking' | 'done';
  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    const statusText = root.querySelector<HTMLElement>('[data-status-text]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const lines = [...root.querySelectorAll<HTMLElement>('[data-line]')];
    const checks = [...root.querySelectorAll<HTMLElement>('[data-check]')];
    const amount = root.querySelector<HTMLElement>('[data-amount]');
    const ledgerRow = root.querySelector<HTMLElement>('[data-ledger="0"]');
    const signoff = root.querySelector<HTMLElement>('[data-signoff]')!;
    const labels = JSON.parse(document.querySelector<HTMLScriptElement>('[data-demo-labels]')!.textContent!);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timers: number[] = [];
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const phase = (p: Phase) => { status.dataset.phase = p; statusText.textContent = labels[p]; };

    const reset = () => {
      timers.forEach(clearTimeout); timers = [];
      root.classList.add('is-playing');
      lines.forEach((l) => l.classList.remove('shown'));
      checks.forEach((c) => c.classList.remove('checking', 'pass', 'fail', 'is-fixed'));
      amount?.classList.remove('flag', 'is-fixed');
      ledgerRow?.classList.remove('flag');
      signoff.classList.remove('shown');
    };
    const finish = () => {
      lines.forEach((l) => l.classList.add('shown'));
      checks.forEach((c) => c.classList.add(c.dataset.fails ? 'is-fixed' : 'pass'));
      amount?.classList.add('is-fixed');
      signoff.classList.add('shown');
      phase('done');
    };
    const play = () => {
      reset();
      phase('drafting');
      let t = 500;
      lines.forEach((l) => { at(t, () => l.classList.add('shown')); t += 700; });
      t += 400;
      at(t, () => phase('checking'));
      checks.forEach((c) => {
        at(t, () => c.classList.add('checking'));
        t += 800;
        if (c.dataset.fails) {
          at(t, () => { c.classList.remove('checking'); c.classList.add('fail'); amount?.classList.add('flag'); ledgerRow?.classList.add('flag'); });
          t += 1500;
          at(t, () => { c.classList.remove('fail'); c.classList.add('is-fixed'); amount?.classList.remove('flag'); amount?.classList.add('is-fixed'); ledgerRow?.classList.remove('flag'); });
          t += 700;
        } else {
          at(t, () => { c.classList.remove('checking'); c.classList.add('pass'); });
          t += 200;
        }
      });
      at(t + 300, () => { signoff.classList.add('shown'); phase('done'); });
    };

    document.querySelector('[data-replay]')!.addEventListener('click', () => (reduce ? finish() : play()));
    if (reduce) finish();
    else {
      reset();
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { play(); io.disconnect(); } }, { threshold: 0.45 });
      io.observe(root);
    }
  }
</script>

<style>
  .head { margin-top: 56px; display: grid; gap: 28px; align-items: end; }
  .head h2 { max-width: 12ch; }
  .doc {
    margin-top: 80px;
    background: var(--color-ink-2);
    border: 1px solid var(--color-line-dark);
  }
  .doc-bar {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;
    padding: 18px 28px; border-bottom: 1px solid var(--color-line-dark);
    font-size: var(--text-small); color: var(--color-muted-dark);
  }
  .doc-title { font-family: var(--font-display); font-style: italic; font-size: 1.15rem; color: var(--color-on-dark); }
  .status { display: inline-flex; align-items: center; gap: 10px; }
  .status i { width: 8px; height: 8px; background: var(--color-sage); }
  .status[data-phase='drafting'] i, .status[data-phase='checking'] i { background: var(--color-on-dark); animation: blink 1s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }

  .panes { display: grid; }
  .pane { padding: 32px 28px 36px; }
  .pane + .pane { border-top: 1px solid var(--color-line-dark); }
  .pane-label { font-size: var(--text-label); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-muted-dark); margin-bottom: 18px; }
  .doc-heading { font-family: var(--font-display); font-size: 1.9rem; line-height: 1.1; margin-bottom: 18px; }
  .lines { list-style: none; margin: 0; padding: 0; }
  .line {
    display: grid; grid-template-columns: 1fr auto auto; gap: 18px; align-items: baseline;
    padding: 14px 0; border-bottom: 1px solid var(--color-line-dark);
    transition: opacity 500ms var(--ease), transform 500ms var(--ease);
  }
  .line.suggestion { grid-template-columns: 1fr; border-bottom: 0; color: var(--color-muted-dark); padding-top: 16px; }
  .unit { font-weight: 600; }
  .days { color: var(--color-muted-dark); font-size: var(--text-small); }
  .amount { font-variant-numeric: tabular-nums; font-weight: 600; }
  .amount .right { display: none; }
  .amount .wrong { text-decoration: none; }
  .amount.flag .wrong { color: var(--color-coral); }
  .amount.is-fixed .wrong { text-decoration: line-through; color: var(--color-muted-dark); font-weight: 400; margin-right: 10px; }
  .amount.is-fixed .right { display: inline; }

  .ledger { margin-top: 28px; padding-top: 22px; border-top: 1px dashed var(--color-line-dark); }
  .ledger table { width: 100%; border-collapse: collapse; font-size: var(--text-small); }
  .ledger td { padding: 7px 0; color: var(--color-muted-dark); font-variant-numeric: tabular-nums; }
  .ledger td:last-child { text-align: right; color: var(--color-on-dark); }
  .ledger tr.flag td { color: var(--color-coral); }

  .checks { list-style: none; margin: 0; padding: 0; }
  .check {
    display: grid; grid-template-columns: 18px 1fr; gap: 4px 16px; align-items: center;
    padding: 16px 0; border-bottom: 1px solid var(--color-line-dark);
  }
  .box { width: 14px; height: 14px; border: 1px solid rgb(236 231 222 / 0.45); transition: background-color 300ms var(--ease), border-color 300ms var(--ease); }
  .check.checking .box { border-color: var(--color-on-dark); animation: blink 0.8s ease-in-out infinite; }
  .check.pass .box, .check.is-fixed .box { background: var(--color-on-dark); border-color: var(--color-on-dark); }
  .check.fail .box { background: var(--color-coral); border-color: var(--color-coral); }
  .fix-note { grid-column: 2; font-size: var(--text-small); color: var(--color-coral); display: none; }
  .check.fail .fix-note, .check.is-fixed .fix-note { display: block; }
  .check.is-fixed .fix-note { color: var(--color-sage); }
  .signoff {
    margin-top: 28px; display: flex; align-items: center; gap: 14px;
    font-family: var(--font-display); font-size: 1.45rem; line-height: 1.25;
    transition: opacity 600ms var(--ease), transform 600ms var(--ease);
  }
  .seal { flex: none; width: 14px; height: 14px; background: var(--color-sage); position: relative; }
  .seal::after { content: ''; position: absolute; width: 7px; height: 7px; background: var(--color-coral); top: -9px; right: -9px; }

  .is-playing .line:not(.shown) { opacity: 0; transform: translateY(8px); }
  .is-playing .signoff:not(.shown) { opacity: 0; transform: translateY(8px); }

  .below { margin-top: 22px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; }
  .note { font-size: var(--text-small); color: var(--color-muted-dark); }
  .replay { font: inherit; font-size: var(--text-small); font-weight: 500; color: var(--color-on-dark); background: none; border: 0; cursor: pointer; min-height: 32px; }

  @media (min-width: 1000px) {
    .head { grid-template-columns: 1.2fr 1fr; }
    .panes { grid-template-columns: 1.1fr 1fr; }
    .pane { padding: 44px 48px 48px; }
    .pane + .pane { border-top: 0; border-left: 1px solid var(--color-line-dark); }
  }
  @media (max-width: 520px) {
    .line { grid-template-columns: 1fr auto; }
    .days { grid-column: 1; grid-row: 2; }
    .amount { grid-row: 1 / span 2; grid-column: 2; align-self: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .status i, .check.checking .box { animation: none; }
  }
</style>
