---
import { content } from '../content/site';
const c = content.problem;
// The headline is split into words so each one can light up as it scrolls into view.
const words = c.h2.replaceAll('**', '').split(' ');
---
<section id="problem" class="statement on-dark" aria-labelledby="problem-title" data-statement>
  <div class="wrap">
    <span class="eyebrow">{c.eyebrow}</span>
    <h2 id="problem-title" class="big">
      {words.map((w, i) => <span class="w" style={`--i:${i}`}>{w}{i < words.length - 1 ? ' ' : ''}</span>)}
    </h2>
    <div class="cols">
      {c.paragraphs.map((p, i) => <p class="para" style={`--d:${i}`}>{p}</p>)}
    </div>
    <ul class="pile" aria-label={c.pileLabel}>
      {c.pile.map((label, i) => (
        <li style={`--n:${i}`}>
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{label}</span>
          <span class="status">{c.pileStatus}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Light each word as the headline moves up the screen. Static (all lit) for reduced motion.
  const section = document.querySelector<HTMLElement>('[data-statement]');
  if (section && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...section.querySelectorAll<HTMLElement>('.w')];
    section.classList.add('is-scrubbing');
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = section.getBoundingClientRect();
      const vh = innerHeight;
      // 0 when the section top reaches 85% of the viewport, 1 when it reaches 25%.
      const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (vh * 0.6)));
      const lit = p * words.length;
      words.forEach((w, i) => w.style.setProperty('--lit', String(Math.min(1, Math.max(0, lit - i)))));
      section.style.setProperty('--progress', String(p));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

<style>
  .statement {
    position: relative;
    background:
      radial-gradient(40% 50% at 100% 0%, rgb(36 82 122 / 0.35), transparent 70%),
      var(--color-abyss);
    padding-block: clamp(96px, 14vw, 180px);
  }
  .big {
    margin-top: 10px; max-width: 16ch;
    font-size: clamp(2.6rem, 7.4vw, 7rem); line-height: 1; letter-spacing: -0.035em; font-weight: 600;
    color: #fff;
  }
  .w { --lit: 1; color: rgb(255 255 255 / calc(0.14 + 0.86 * var(--lit))); transition: color 120ms linear; }
  .cols { margin-top: 56px; display: grid; gap: 22px; max-width: 64rem; }
  .para { color: var(--color-on-dark); font-size: clamp(1.0625rem, 1.4vw, 1.3rem); max-width: 46ch; }
  .pile {
    list-style: none; margin: 64px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 12px;
  }
  .pile li {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 12px 18px; border-radius: 14px;
    background: rgb(255 255 255 / 0.04); border: 1px solid var(--color-line-dark);
    color: #fff; font-family: var(--font-display); font-weight: 500;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-coral); box-shadow: 0 0 12px rgb(231 120 92 / 0.8); }
  .status { color: var(--color-on-dark); font-size: 0.85rem; font-weight: 400; }
  @media (min-width: 900px) {
    .cols { grid-template-columns: 1fr 1fr; gap: 48px; }
  }
</style>
