---
import { content } from '../content/site';
interface Props { n: number }
const { n } = Astro.props;
const c = content.problem;
// The headline is split into words so each can come into focus as it scrolls up the screen.
const words = c.h2.replaceAll('**', '').split(' ');
---
<section id="problem" class="section statement bg-ivory" aria-labelledby="problem-title" data-statement>
  <div class="wrap">
    <p class="label">{c.eyebrow}<sup>{n}</sup></p>
    <h2 id="problem-title" class="big">
      {words.map((w, i) => <span class="w">{w}{i < words.length - 1 ? ' ' : ''}</span>)}
    </h2>
    <div class="cols">
      <div class="paras">
        {c.paragraphs.map((p) => <p class="reveal">{p}</p>)}
      </div>
      <div class="queue reveal" style="--d:1">
        <p class="queue-title">{c.pileLabel}</p>
        <ul>
          {c.pile.map((label) => (
            <li><span>{label}</span><span class="status"><i></i>{c.pileStatus}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // Each word comes into focus as the headline moves up the screen. All in focus for reduced motion.
  // Starts only after the visitor's first scroll (so nothing loads dimmed), and only while the
  // headline is still below the fold. A word that has come into focus stays in focus.
  const section = document.querySelector<HTMLElement>('[data-statement]');
  if (section && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...section.querySelectorAll<HTMLElement>('.w')];
    const best = words.map(() => 0);
    let ticking = false, armed = false;
    const update = () => {
      ticking = false;
      const r = section.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.9 - r.top) / (innerHeight * 0.55)));
      const lit = p * words.length;
      words.forEach((w, i) => {
        best[i] = Math.max(best[i], Math.min(1, Math.max(0, lit - i)));
        w.style.setProperty('--lit', String(best[i]));
      });
      if (best.every((b) => b === 1)) removeEventListener('scroll', onScroll);
    };
    const onScroll = () => {
      if (!armed) {
        armed = true;
        // Already on screen when the visitor starts scrolling: leave it fully in focus.
        if (section.getBoundingClientRect().top < innerHeight * 0.9) { removeEventListener('scroll', onScroll); return; }
      }
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    };
    addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .big {
    margin-top: 56px; max-width: 13ch;
    font-size: clamp(3.2rem, 9.4vw, 9.5rem); line-height: 0.94; letter-spacing: -0.025em;
  }
  .w { --lit: 1; color: rgb(17 20 24 / calc(0.12 + 0.88 * var(--lit))); }
  .cols { margin-top: 88px; display: grid; gap: 56px; }
  .paras { display: grid; gap: 24px; max-width: 40ch; font-size: clamp(1.1rem, 1.4vw, 1.3rem); color: var(--color-muted); }
  .queue-title {
    font-size: var(--text-label); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-muted); padding-bottom: 14px; border-bottom: 1px solid var(--color-text);
  }
  .queue ul { list-style: none; margin: 0; padding: 0; }
  .queue li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 20px;
    padding: 18px 0; border-bottom: 1px solid var(--color-line);
    font-family: var(--font-display); font-size: clamp(1.4rem, 2vw, 1.75rem); line-height: 1.2;
  }
  .status {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-sans); font-size: var(--text-small); color: var(--color-muted);
  }
  .status i { width: 8px; height: 8px; border: 1px solid var(--color-coral-deep); display: inline-block; }
  @media (min-width: 1000px) {
    .cols { grid-template-columns: 1fr 1fr; gap: 120px; align-items: start; }
  }
</style>
