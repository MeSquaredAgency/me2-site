---
import { content } from '../content/site';
const c = content.statement;
const words = c.text.split(' ');
---
<!-- Why one partner: one paragraph, read as you scroll. Each word lights up as it passes the middle of the screen. -->
<section class="statement on-dark" aria-label={c.label} data-statement>
  <div class="wrap">
    <p class="kicker">{c.label}</p>
    <p class="text">
      {words.map((w, i) => <span class="w" style={`--k:${i}`}>{w} </span>)}
    </p>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('[data-statement]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...el.querySelectorAll<HTMLElement>('.w')];
    let lit = -1, ticking = false;
    const update = () => {
      ticking = false;
      const r = el.querySelector('.text')!.getBoundingClientRect();
      // 0 when the paragraph's top reaches 80% down the screen, 1 when its bottom reaches 45%.
      const start = innerHeight * 0.8, end = innerHeight * 0.45;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height)));
      const n = Math.round(p * words.length);
      if (n === lit) return;
      words.forEach((w, i) => w.classList.toggle('on', i < n));
      lit = n;
    };
    // The words only dim once the visitor is scrolling toward them, so the text is never left faint for anyone who isn't.
    const onScroll = () => {
      el.classList.add('is-live');
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    };
    new IntersectionObserver(([e]) => {
      e.isIntersecting ? addEventListener('scroll', onScroll, { passive: true }) : removeEventListener('scroll', onScroll);
    }, { rootMargin: '0px 0px 25% 0px' }).observe(el);
  }
</script>

<style>
  .statement { padding-block: clamp(120px, 18vh, 220px); border-top: 1px solid var(--color-line-dark); }
  .kicker { margin-bottom: clamp(28px, 4vw, 48px); }
  .text {
    font-size: clamp(1.8rem, 3.7vw, 4.1rem); font-weight: 480; font-stretch: 92%;
    line-height: 1.1; letter-spacing: -0.03em; max-width: 26ch; color: var(--color-mist);
  }
  .is-live .w { color: rgb(232 237 241 / 0.16); transition: color 500ms var(--ease); }
  .is-live .w.on { color: var(--color-mist); }
</style>
