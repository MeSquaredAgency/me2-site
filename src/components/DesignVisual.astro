---
import { content } from '../content/site';
const c = content.visuals.design;
---
<!-- Design: a web page assembling itself, block by block, in a browser window. Decorative. -->
<figure class="design-visual" data-visual="design">
  <p class="sr-only">{c.srSummary}</p>
  <svg viewBox="0 0 640 460" aria-hidden="true" focusable="false">
    <rect class="win" x="1" y="1" width="638" height="458" rx="10" />
    <line class="win-line" x1="1" y1="38" x2="639" y2="38" />
    <rect class="dot" x="18" y="15" width="9" height="9" />
    <rect class="dot" x="33" y="15" width="9" height="9" />
    <rect class="dot" x="48" y="15" width="9" height="9" />
    <rect class="url" x="210" y="11" width="220" height="17" rx="8.5" />
    <text class="url-text" x="320" y="23.5" text-anchor="middle">{c.url}</text>

    <!-- The page: nav, headline, line, button, image, three columns. Each block has its turn. -->
    <g class="b" style="--n:0"><rect class="ink" x="36" y="62" width="44" height="10" rx="2" /><rect class="soft" x="420" y="64" width="40" height="6" rx="3" /><rect class="soft" x="472" y="64" width="40" height="6" rx="3" /><rect class="soft" x="524" y="64" width="40" height="6" rx="3" /><rect class="coral" x="578" y="60" width="26" height="14" rx="7" /></g>
    <g class="b" style="--n:1"><rect class="ink" x="36" y="108" width="300" height="26" rx="3" /></g>
    <g class="b" style="--n:2"><rect class="ink" x="36" y="142" width="236" height="26" rx="3" /></g>
    <g class="b" style="--n:3"><rect class="soft" x="36" y="184" width="270" height="8" rx="4" /><rect class="soft" x="36" y="200" width="220" height="8" rx="4" /></g>
    <g class="b" style="--n:4"><rect class="pill" x="36" y="224" width="92" height="28" rx="14" /><rect class="coral" x="50" y="235" width="7" height="7" /></g>
    <g class="b" style="--n:5">
      <rect class="img" x="364" y="100" width="240" height="156" rx="4" />
      <rect class="img-sq" x="548" y="114" width="14" height="14" />
      <path class="img-line" d="M378 238 L430 196 L470 222 L520 170 L590 238" />
    </g>
    <g class="b" style="--n:6"><rect class="card" x="36" y="290" width="176" height="132" rx="4" /><rect class="soft" x="52" y="384" width="110" height="7" rx="3.5" /><rect class="soft" x="52" y="398" width="80" height="7" rx="3.5" /></g>
    <g class="b" style="--n:7"><rect class="card" x="232" y="290" width="176" height="132" rx="4" /><rect class="soft" x="248" y="384" width="110" height="7" rx="3.5" /><rect class="soft" x="248" y="398" width="80" height="7" rx="3.5" /></g>
    <g class="b" style="--n:8"><rect class="card" x="428" y="290" width="176" height="132" rx="4" /><rect class="soft" x="444" y="384" width="110" height="7" rx="3.5" /><rect class="soft" x="444" y="398" width="80" height="7" rx="3.5" /></g>

    <!-- The designer's cursor, placing each block. -->
    <g class="pointer"><path d="M0 0 L0 17 L5 13 L8.5 20 L11.5 18.5 L8 11.8 L14 11.5 Z" /></g>
  </svg>
</figure>

<style>
  .design-visual { margin: 0; width: 100%; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .win { fill: #0c1824; stroke: rgb(232 237 241 / 0.16); }
  .win-line { stroke: rgb(232 237 241 / 0.12); }
  .dot { fill: rgb(232 237 241 / 0.22); }
  .url { fill: rgb(232 237 241 / 0.06); }
  .url-text { fill: var(--color-haze); font-size: 9.5px; font-family: var(--font-sans); letter-spacing: 0.02em; }
  .ink { fill: var(--color-mist); }
  .soft { fill: rgb(232 237 241 / 0.28); }
  .coral { fill: var(--color-coral); }
  .pill { fill: var(--color-mist); }
  .img { fill: #1b3853; }
  .img-sq { fill: var(--color-coral); }
  .img-line { fill: none; stroke: rgb(232 237 241 / 0.4); stroke-width: 1.5; }
  .card { fill: rgb(232 237 241 / 0.05); stroke: rgb(232 237 241 / 0.14); }
  .pointer { fill: var(--color-mist); stroke: var(--color-abyss); stroke-width: 1; opacity: 0; }

  /* An 8-second loop: blocks land one after another, hold, then clear for the next build. */
  .b { transform-box: fill-box; transform-origin: 0 0; }
  :global([data-active='design']) .b { animation: place 8s var(--ease-out) infinite both; animation-delay: calc(var(--n) * 0.32s); }
  :global([data-active='design']) .pointer { animation: guide 8s var(--ease-out) infinite both; }
  @keyframes place {
    0% { opacity: 0; transform: translate(10px, 14px); }
    9%, 82% { opacity: 1; transform: none; }
    92%, 100% { opacity: 0; transform: none; }
  }
  @keyframes guide {
    0% { opacity: 0; transform: translate(120px, 300px); }
    6% { opacity: 1; transform: translate(80px, 74px); }
    14% { transform: translate(330px, 132px); }
    24% { transform: translate(300px, 196px); }
    32% { transform: translate(120px, 246px); }
    42% { transform: translate(560px, 230px); }
    56% { transform: translate(400px, 400px); }
    70% { opacity: 1; transform: translate(600px, 420px); }
    80%, 100% { opacity: 0; transform: translate(640px, 470px); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-active='design']) .b, :global([data-active='design']) .pointer { animation: none; }
  }
</style>
