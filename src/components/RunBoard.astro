---
import { content } from '../content/site';
const b = content.board;

// The board's timing, shared with the script below so the first paint and the animation agree.
// A task's stage depends only on its age (seconds since it arrived on the board).
const TIMING = { queued: 0.9, drafting: 4.2, checking: 7.4, caught: 8.4, every: 2.6, rows: 5 };
type Stage = keyof typeof b.stages;
const stageOf = (age: number, fix: boolean): Stage =>
  age < TIMING.queued ? 'queued'
  : age < TIMING.drafting ? 'drafting'
  : age < TIMING.checking ? 'checking'
  : fix && age < TIMING.caught ? 'caught'
  : fix ? 'fixed' : 'done';
// First paint: the five oldest sample tasks, newest at the top, at a spread of stages.
const first = Array.from({ length: TIMING.rows }, (_, i) => {
  const t = b.tasks[TIMING.rows - 1 - i];
  const age = 1.8 + i * TIMING.every;
  return { ...t, age, stage: stageOf(age, t.fix) };
});
---
<!--
  Run: the Command Centre board. Sample tasks from different kinds of business arrive at the top,
  are drafted by AI, checked by an operator and marked done; some are caught and corrected (coral).
  Decorative; the sr-only summary says it in words. Runs only while Run is the service on show.
-->
<figure class="board" data-visual="run" data-board data-stages={JSON.stringify(b.stages)} data-tasks={JSON.stringify(b.tasks)} data-timing={JSON.stringify(TIMING)}>
  <p class="sr-only">{b.srSummary}</p>
  <div class="top" aria-hidden="true">
    <span class="title">{b.title}</span>
    <span class="live"><i></i>{b.live}</span>
  </div>
  <div class="viewport" aria-hidden="true">
    <ol class="rows" data-rows>
      {first.map((r) => (
        <li class="task" data-stage={r.stage} data-fix={String(r.fix)} data-age={r.age}>
          <span class="mark"></span>
          <span class="what"><span class="name">{r.task}</span><span class="for">{r.for}</span></span>
          <span class="stage">{b.stages[r.stage]}</span>
          <span class="bar"></span>
        </li>
      ))}
    </ol>
  </div>
  <figcaption class="foot">{b.note}</figcaption>
</figure>

<script>
  const board = document.querySelector<HTMLElement>('[data-board]');
  const stage = board?.closest<HTMLElement>('[data-stage]');
  if (board && stage && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const list = board.querySelector<HTMLOListElement>('[data-rows]')!;
    const stages = JSON.parse(board.dataset.stages!) as Record<string, string>;
    const tasks = JSON.parse(board.dataset.tasks!) as { task: string; for: string; fix: boolean }[];
    const T = JSON.parse(board.dataset.timing!) as Record<string, number>;
    type Row = { el: HTMLLIElement; born: number; fix: boolean; stage: string };

    const stageOf = (age: number, fix: boolean) =>
      age < T.queued ? 'queued'
      : age < T.drafting ? 'drafting'
      : age < T.checking ? 'checking'
      : fix && age < T.caught ? 'caught'
      : fix ? 'fixed' : 'done';
    // The drafting bar and the check line are CSS animations: give each the stage's length and how far in the row is.
    const span: Record<string, [number, number]> = { drafting: [T.queued, T.drafting], checking: [T.drafting, T.checking] };
    const sync = (r: Row, age: number) => {
      const sp = span[r.stage];
      if (!sp) return;
      r.el.style.setProperty('--dur', `${sp[1] - sp[0]}s`);
      r.el.style.setProperty('--delay', `${-(age - sp[0]).toFixed(2)}s`);
    };

    let clock = 0, last = 0, timer = 0, running = false, synced = false, nextAt = T.every, next = T.rows;
    const rows: Row[] = [...list.children].map((el) => ({
      el: el as HTMLLIElement, born: -Number((el as HTMLElement).dataset.age), fix: (el as HTMLElement).dataset.fix === 'true', stage: (el as HTMLElement).dataset.stage!,
    }));

    const make = (i: number): Row => {
      const t = tasks[i % tasks.length];
      const el = document.createElement('li');
      el.className = 'task is-new';
      el.dataset.stage = 'queued';
      el.innerHTML = '<span class="mark"></span><span class="what"><span class="name"></span><span class="for"></span></span><span class="stage"></span><span class="bar"></span>';
      el.querySelector('.name')!.textContent = t.task;
      el.querySelector('.for')!.textContent = t.for;
      el.querySelector('.stage')!.textContent = stages.queued;
      return { el, born: clock, fix: t.fix, stage: 'queued' };
    };

    const arrive = () => {
      const row = make(next++);
      const h = (list.firstElementChild as HTMLElement).offsetHeight;
      list.prepend(row.el);
      rows.unshift(row);
      list.style.transition = 'none';
      list.style.transform = `translateY(${-h}px)`;
      void list.offsetHeight;
      list.style.transition = '';
      list.style.transform = '';
      while (rows.length > T.rows + 1) rows.pop()!.el.remove();
    };

    const tick = () => {
      const now = performance.now();
      clock += last ? Math.min(0.5, (now - last) / 1000) : 0;
      last = now;
      if (clock >= nextAt) { nextAt += T.every; arrive(); }
      for (const r of rows) {
        const age = clock - r.born;
        const s = stageOf(age, r.fix);
        if (s !== r.stage) {
          r.stage = s;
          r.el.dataset.stage = s;
          r.el.querySelector('.stage')!.textContent = stages[s];
          sync(r, age);
        }
      }
    };
    const play = () => {
      if (running) return;
      running = true; last = 0;
      board.classList.remove('is-paused');
      if (!synced) { synced = true; rows.forEach((r) => sync(r, clock - r.born)); }
      timer = window.setInterval(tick, 200);
    };
    const stop = () => { running = false; clearInterval(timer); board.classList.add('is-paused'); };
    board.classList.add('is-live', 'is-paused');

    // Run only while Run is the service on show, the stage is on screen and the tab is visible.
    let onScreen = false;
    const update = () => (onScreen && !document.hidden && stage.dataset.active === 'run' ? play() : stop());
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; update(); }).observe(stage);
    new MutationObserver(update).observe(stage, { attributes: true, attributeFilter: ['data-active'] });
    document.addEventListener('visibilitychange', update);
  }
</script>

<style>
  .board { --row: 60px; margin: 0; width: 100%; font-family: var(--font-sans); }
  .top { display: flex; justify-content: space-between; align-items: center; padding: 0 0 18px; border-bottom: 1px solid rgb(232 237 241 / 0.4); }
  .title { font-size: 1.25rem; font-weight: 560; font-stretch: 92%; letter-spacing: -0.02em; color: var(--color-mist); }
  .live { display: inline-flex; align-items: center; gap: 10px; font-size: 0.85rem; font-weight: 500; color: var(--color-haze); }
  .live i { width: 7px; height: 7px; background: var(--color-coral); animation: blink 2.4s var(--ease) infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .viewport { height: calc(var(--row) * 5); overflow: hidden; }
  .rows { list-style: none; margin: 0; padding: 0; transition: transform 900ms var(--ease-out); }
  .rows :global(.task) {
    position: relative; height: var(--row); box-sizing: border-box;
    display: grid; grid-template-columns: 10px 1fr auto; align-items: center; gap: 0 16px;
    border-bottom: 1px solid var(--color-line-dark);
    transition: background-color 500ms var(--ease);
  }
  .rows :global(.task.is-new) { animation: arrive 900ms var(--ease) both; }
  @keyframes arrive { from { opacity: 0; } }
  .rows :global(.what) { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .rows :global(.name) { font-size: 1rem; font-weight: 520; line-height: 1.25; color: var(--color-mist); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rows :global(.for) { font-size: 0.8rem; color: var(--color-haze); white-space: nowrap; }
  .rows :global(.stage) { font-size: 0.85rem; font-weight: 500; color: var(--color-haze); text-align: right; white-space: nowrap; }
  .rows :global(.mark) { width: 10px; height: 10px; box-sizing: border-box; border: 1px dashed rgb(232 237 241 / 0.45); transition: background-color 400ms var(--ease), border-color 400ms var(--ease); }
  .rows :global(.bar) { position: absolute; left: 26px; right: 0; bottom: -1px; height: 1px; pointer-events: none; overflow: hidden; opacity: 0; transition: opacity 400ms var(--ease); }
  .rows :global(.bar::before), .rows :global(.bar::after) { content: ''; position: absolute; inset: 0; }
  .rows :global(.task[data-stage='drafting'] .bar::before) { background: rgb(232 237 241 / 0.5); transform-origin: 0 0; transform: scaleX(0.5); }
  .is-live .rows :global(.task[data-stage='drafting'] .bar::before) { animation: fill var(--dur, 3s) linear var(--delay, 0s) both; }
  .rows :global(.task[data-stage='checking'] .bar::before) { background: rgb(232 237 241 / 0.5); }
  .rows :global(.task[data-stage='checking'] .bar::after) { background: linear-gradient(90deg, transparent calc(100% - 72px), rgb(232 237 241 / 0.95)); transform: translateX(-45%); }
  .is-live .rows :global(.task[data-stage='checking'] .bar::after) { animation: sweep var(--dur, 3s) linear var(--delay, 0s) both; }
  .is-paused .rows :global(.bar::before), .is-paused .rows :global(.bar::after) { animation-play-state: paused; }
  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes sweep { from { transform: translateX(-100%); } to { transform: translateX(0); } }
  .rows :global(.task[data-stage='drafting'] .mark) { border: 1px solid rgb(232 237 241 / 0.7); }
  .rows :global(.task[data-stage='drafting'] .bar) { opacity: 1; }
  .rows :global(.task[data-stage='checking'] .mark) { border: 1px solid var(--color-mist); background: linear-gradient(0deg, var(--color-mist) 50%, transparent 50%); }
  .rows :global(.task[data-stage='checking'] .stage) { color: var(--color-mist); }
  .rows :global(.task[data-stage='checking'] .bar) { opacity: 1; }
  .rows :global(.task[data-stage='checking']) { background: rgb(232 237 241 / 0.035); }
  .rows :global(.task[data-stage='caught']) { background: rgb(231 120 92 / 0.12); }
  .rows :global(.task[data-stage='caught'] .mark) { border-color: var(--color-coral); background: var(--color-coral); animation: blink 500ms steps(2) infinite; }
  .rows :global(.task[data-stage='caught'] .stage) { color: var(--color-coral); }
  .rows :global(.task[data-stage='done'] .mark) { border: 0; background: var(--color-mist); }
  .rows :global(.task[data-stage='fixed'] .mark) { border: 0; background: var(--color-coral); }
  .rows :global(.task[data-stage='done'] .stage), .rows :global(.task[data-stage='fixed'] .stage) { color: var(--color-mist); }
  .foot { padding-top: 16px; font-size: 0.8rem; color: var(--color-haze); }
  @media (max-width: 999px) {
    /* In the small screen on phones: four rows, no footnote (the summary above still says it is an illustration). */
    .board { --row: 44px; }
    .top { padding-bottom: 10px; }
    .title { font-size: 1rem; }
    .viewport { height: calc(var(--row) * 4); }
    .foot { display: none; }
    .rows :global(.name) { font-size: 0.85rem; }
    .rows :global(.for) { font-size: 0.72rem; }
    .rows :global(.stage) { font-size: 0.72rem; }
  }
</style>
