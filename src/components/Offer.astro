---
import EnquireLink from './EnquireLink.astro';
import { fill, flags } from '../config';
import { content } from '../content/site';
const c = content.offer;
// "From $3,000 + GST a month" → the figure set large, the words around it small.
// A price in words ("Quoted per job") is set like the websites panel's.
const price = (text: string) => {
  const m = text.match(/^(.*?)(\$[\d,]+)(.*)$/);
  return m ? { before: m[1].trim(), figure: m[2], after: m[3].trim(), words: false } : { before: '', figure: text, after: '', words: true };
};
// "back office" never splits across lines.
const keep = (t: string) => t.replace('back office', 'back office');
const officePrice = price(c.office.price);
const onePrice = price(c.one.price);
---
<!-- Start here: the whole back office (the big offer), an extra set of hands, or a website. One left edge for everything. -->
<section id="services" class="offer on-paper render-later" aria-labelledby="offer-title">
  <div class="wrap">
    <div class="head">
      <p class="kicker">{c.kicker}</p>
      <h2 id="offer-title">{keep(c.h2)}</h2>
      <p class="lede intro">{c.intro}</p>
    </div>

    <!-- The whole back office: people backed by AI, on dark glass like the mark. -->
    <article class="office on-dark" aria-labelledby="office-title">
      <div class="office-top">
        <div>
          <h3 id="office-title" class="tier">{keep(c.office.name)}</h3>
          {flags.showPricing && (
            <p class="price">{officePrice.before && <>{officePrice.before} </>}<span class:list={['figure', { 'figure-words': officePrice.words }]}>{officePrice.figure}</span>{officePrice.after && <> <span class="after">{officePrice.after}</span></>}</p>
          )}
        </div>
        <p class="body">{fill(c.office.body)}</p>
      </div>
      <ul class="areas">
        {c.office.areas.map((a) => (
          <li><span class="area"><a href={a.href} class="tlink">{a.name}</a></span><span class="area-eg">{a.example}</span></li>
        ))}
      </ul>
      <p class="coming">{c.office.coming}</p>
      <div class="office-foot">
        <p class="process"><span class="sq" aria-hidden="true"></span>{c.office.process}</p>
        <EnquireLink topic={c.office.topic} source="start-here" class="btn btn-light"><span class="dot" aria-hidden="true"></span>{c.office.button}</EnquireLink>
      </div>
    </article>

    <div class="pair">
      <article class="tier-panel one" aria-labelledby="one-title">
        <h3 id="one-title" class="tier tier-sm">{c.one.name}</h3>
        {flags.showPricing && (
          <p class="price">{onePrice.before && <>{onePrice.before} </>}<span class:list={['figure', { 'figure-words': onePrice.words }]}>{onePrice.figure}</span>{onePrice.after && <> <span class="after">{onePrice.after}</span></>}</p>
        )}
        <div class="panel-main"><p class="body">{fill(c.one.body)}</p></div>
        <div class="panel-foot"><EnquireLink topic={c.one.topic} source="start-here" class="btn btn-dark"><span class="dot" aria-hidden="true"></span>{c.one.button}</EnquireLink></div>
      </article>

      <article class="tier-panel web" aria-labelledby="web-title">
        <h3 id="web-title" class="tier tier-sm">{c.web.name}</h3>
        {flags.showPricing && <p class="price"><span class="figure figure-words">{c.web.price}</span></p>}
        <div class="panel-main">
          <p class="body">{c.web.body}</p>
          <ul class="includes">{c.web.includes.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="panel-foot"><EnquireLink topic={c.web.topic} source="start-here" class="btn btn-dark"><span class="dot" aria-hidden="true"></span>{c.web.button}</EnquireLink></div>
      </article>
    </div>

    <p class="also">{c.also} <EnquireLink topic="Something else" source="start-here" class="tlink">{content.header.button}</EnquireLink></p>
  </div>
</section>

<style>
  .offer { padding-block: var(--section-y); }
  .head { display: grid; justify-items: start; gap: 24px; margin-bottom: clamp(48px, 6vw, 88px); }
  .head h2 { max-width: 22ch; text-wrap: balance; }
  .intro { max-width: 52ch; }

  .tier { font-size: clamp(2.2rem, 3.6vw, 3.6rem); font-weight: 520; font-stretch: 88%; letter-spacing: -0.045em; line-height: 0.95; }
  .tier-sm { font-size: clamp(1.8rem, 2.6vw, 2.6rem); }
  .price { margin-top: 18px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 1rem; color: var(--color-slate); }
  .figure { font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 560; font-stretch: 90%; letter-spacing: -0.04em; color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .figure-words { font-size: clamp(1.5rem, 2.2vw, 2rem); }
  .body { margin-top: 18px; max-width: 46ch; font-size: 1.08rem; line-height: 1.6; color: var(--color-slate); }

  /* ---- The whole back office ---- */
  .office {
    position: relative; overflow: hidden; isolation: isolate; border-radius: 18px; padding: clamp(28px, 4vw, 56px);
    background: radial-gradient(70% 60% at 100% 0%, rgb(var(--glow) / 0.2), transparent 70%), linear-gradient(160deg, #10202f, var(--color-abyss) 70%);
    box-shadow: 0 40px 80px -30px rgb(18 29 40 / 0.5);
  }
  .office::after {
    content: ''; position: absolute; top: 28px; right: 28px; width: 14px; height: 14px; background: var(--color-coral);
    box-shadow: 0 0 24px 4px rgb(var(--glow) / 0.55);
  }
  .office .price, .office .body { color: var(--color-haze); }
  .office .figure { color: var(--color-mist); }
  .office .body { margin-top: 0; }
  .office .tier { padding-right: 32px; } /* clear of the glowing square */
  .office-top { display: grid; gap: 24px; }
  /* Everything the team takes on: one row per area, the area and an example of the work. */
  .areas { list-style: none; margin: clamp(36px, 4vw, 56px) 0 0; padding: 0; border-top: 1px solid var(--color-line-dark); }
  .areas li { display: grid; gap: 4px; padding-block: 18px; border-bottom: 1px solid var(--color-line-dark); }
  .area { font-size: 1.2rem; font-weight: 560; letter-spacing: -0.015em; color: var(--color-mist); }
  .area-eg { color: var(--color-haze); line-height: 1.5; max-width: 52ch; }
  .coming { margin-top: 18px; color: var(--color-haze); line-height: 1.5; }
  .office-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; margin-top: 32px; }
  /* Squares that mark a line of text sit on its first line, however many lines it wraps to. */
  .process { display: inline-flex; align-items: flex-start; gap: 12px; max-width: 48ch; color: var(--color-haze); line-height: 1.5; }
  .process .sq { width: 8px; height: 8px; flex: none; margin-top: calc(0.75em - 4px); background: var(--color-coral); }
  .office :focus-visible { outline-color: var(--color-mist); }

  /* ---- One job and websites ---- */
  .pair { display: grid; gap: 24px; margin-top: 24px; }
  /* The button sits at the foot of each panel, so side-by-side panels end on the same line. */
  .tier-panel { display: flex; flex-direction: column; align-items: flex-start; border-radius: 18px; padding: clamp(28px, 3.4vw, 48px); background: var(--color-paper-2); }
  .panel-foot { margin-top: auto; padding-top: 32px; }
  .panel-main { width: 100%; }
  .includes { list-style: none; margin: 26px 0 0; padding: 0; width: 100%; max-width: 44ch; border-top: 1px solid var(--color-line); }
  .includes li { display: flex; align-items: flex-start; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--color-line); font-weight: 500; line-height: 1.5; }
  .includes li::before { content: ''; width: 6px; height: 6px; margin-top: calc(0.75em - 3px); background: currentColor; flex: none; }
  .also { margin-top: clamp(32px, 4vw, 48px); max-width: 60ch; color: var(--color-slate); line-height: 1.6; }

  /* Phones: the panels' buttons run the full width, so their longer labels stay on one line. */
  @media (max-width: 559px) {
    .office, .tier-panel { padding: 28px 22px; }
    .office-foot, .panel-foot { align-self: stretch; }
    .office-foot :global(.btn), .panel-foot :global(.btn) { width: 100%; padding-inline: 16px; gap: 12px; font-size: 0.9rem; }
  }
  @media (min-width: 800px) {
    .areas li { grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); column-gap: 32px; align-items: baseline; }
    .pair { grid-template-columns: 1fr 1fr; }
    /* Side by side, the two panels share rows: names, prices and descriptions line up, and so do the buttons at the foot. */
    .tier-panel { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; justify-items: start; }
    .tier-panel .price { align-self: last baseline; }
    .panel-foot { grid-row: 4; }
  }
  @media (min-width: 1000px) {
    .office-top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; column-gap: clamp(40px, 5vw, 96px); }
  }
</style>
