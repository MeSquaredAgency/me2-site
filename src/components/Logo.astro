---
// The me² logo, inlined as SVG so it's sharp at any size and needs no extra request.
import navy from '../assets/brand/me2-logo.svg?raw';
import light from '../assets/brand/me2-logo-light.svg?raw';
import { fill } from '../config';
import { content } from '../content/site';

interface Props {
  /** "light" for dark backgrounds, "navy" for light ones */
  tone?: 'light' | 'navy';
  /** CSS height in px */
  height?: number;
  class?: string;
}
const { tone = 'light', height = 34, class: className } = Astro.props;
const label = fill(content.ui.logoLabel);
const svg = (tone === 'light' ? light : navy)
  .replace('aria-label="Me Squared"', `aria-label="${label}"`)
  .replace('<svg ', `<svg height="${height}" class="logo-svg" `);
---
<span class:list={['logo', className]} style={`--h:${height}px`} set:html={svg} />
<style>
  .logo { display: inline-flex; line-height: 0; }
  .logo :global(.logo-svg) { height: var(--h); width: auto; display: block; }
</style>
