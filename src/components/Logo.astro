---
// The me² logo as inline SVG, so it's sharp at any size and needs no extra request.
// The light version's paths live once in Base.astro as <g id="me2-logo-light"> (same coordinates as the file's viewBox); each logo here
// just points at it. The navy version (for light backgrounds) is still inlined in full when used.
import navy from '../assets/brand/me2-logo.svg?raw';
import light from '../assets/brand/me2-logo-light.svg?raw';
import { fill } from '../config';
import { content } from '../content/site';

interface Props {
  /** "light" for dark backgrounds, "navy" for light ones */
  tone?: 'light' | 'navy';
  /** CSS height in px */
  height?: number;
  class?: string;
}
const { tone = 'light', height = 34, class: className } = Astro.props;
const label = fill(content.ui.logoLabel);
const viewBox = light.match(/viewBox="([^"]+)"/)![1];
const navySvg = navy
  .replace('aria-label="Me Squared"', `aria-label="${label}"`)
  .replace('<svg ', `<svg height="${height}" class="logo-svg" `);
---
<span class:list={['logo', className]} style={`--h:${height}px`}>
  {tone === 'light'
    ? <svg class="logo-svg" viewBox={viewBox} height={height} role="img" aria-label={label}><use href="#me2-logo-light" /></svg>
    : <Fragment set:html={navySvg} />}
</span>
<style>
  .logo { display: inline-flex; line-height: 0; }
  .logo :global(.logo-svg) { height: var(--h); width: auto; display: block; }
</style>
