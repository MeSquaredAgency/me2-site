---
import EmailLink from './EmailLink.astro';
import { config, fill, flags } from '../config';
import { content } from '../content/site';
const c = content.finalCta;
// The ² square sits on the last word, so it stays tight to the full stop however the line wraps.
const words = c.h2.split(' ');
const last = words.pop();
---
<!-- The close: the promise in the brand's own word, with the ² square lit at its corner. -->
<section class="final on-dark render-later" aria-labelledby="final-title">
  <div class="light" aria-hidden="true"></div>
  <div class="wrap inner">
    <h2 id="final-title">{words.join(' ')} <span class="last">{last}<span class="sq" aria-hidden="true"></span></span></h2>
    <div class="row">
      <p class="lede">{c.body}</p>
      <div class="actions">
        <EmailLink subject={content.ui.subjects.general} class="btn btn-light btn-lg"><span class="dot" aria-hidden="true"></span>{c.button}</EmailLink>
        {flags.enableBooking && <a href={config.BOOKING_URL} class="btn btn-line btn-lg" target="_blank" rel="noopener">{c.booking}</a>}
        <p class="mail">{fill(c.emailLine).replace(config.CONTACT_EMAIL, '')}<a href={`mailto:${config.CONTACT_EMAIL}`} class="tlink">{config.CONTACT_EMAIL}</a></p>
      </div>
    </div>
  </div>
</section>

<style>
  .final { position: relative; overflow: hidden; isolation: isolate; padding-block: clamp(140px, 22vh, 260px) clamp(96px, 14vh, 160px); border-top: 1px solid var(--color-line-dark); }
  .light {
    position: absolute; z-index: -1; width: min(110vw, 1500px); aspect-ratio: 1; right: -30vw; top: -50%;
    background: radial-gradient(closest-side, rgb(var(--glow) / 0.22), rgb(var(--glow) / 0.07) 45%, transparent 100%);
    pointer-events: none;
  }
  h2 { font-size: clamp(3.2rem, 11.5vw, 13rem); line-height: 0.88; letter-spacing: -0.055em; font-stretch: 84%; max-width: none; }
  .last { position: relative; display: inline-block; }
  /* The ²: a lit square set as an exponent, tight to the full stop. */
  .sq {
    position: absolute; right: -0.3em; top: 0.06em; width: 0.2em; height: 0.2em; background: var(--color-coral);
    box-shadow: 0 0 0.3em 0.04em rgb(var(--glow) / 0.6), 0 0 1.2em 0.3em rgb(var(--glow) / 0.22);
  }
  .row { margin-top: clamp(48px, 7vw, 96px); display: grid; gap: 36px 72px; align-items: end; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; }
  .btn-lg { min-height: 58px; padding: 0 30px 0 26px; font-size: 1.05rem; }
  .mail { color: var(--color-haze); }
  .mail a { color: var(--color-mist); }
  @media (min-width: 1000px) { .row { grid-template-columns: minmax(0, 1fr) auto; } }
</style>
