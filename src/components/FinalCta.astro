---
import Emph from './Emph.astro';
import EmailLink from './EmailLink.astro';
import { config, fill, flags } from '../config';
import { content } from '../content/site';
const c = content.finalCta;
const mailto = `mailto:${config.CONTACT_EMAIL}?subject=${encodeURIComponent(content.ui.subjects.general)}`;
const [before, after] = fill(c.emailLine).split(config.CONTACT_EMAIL);
---
<section class="cta on-dark" aria-labelledby="cta-title">
  <div class="wrap inner">
    <h2 id="cta-title" class="reveal"><Emph text={c.h2} /></h2>
    <div class="side reveal" style="--d:1">
      <p class="body">{c.body}</p>
      <div class="actions">
        <EmailLink subject={content.ui.subjects.general} class="btn btn-solid btn-lg">{c.button}</EmailLink>
        {flags.enableBooking && config.BOOKING_URL && (
          <a href={config.BOOKING_URL} target="_blank" rel="noopener" class="btn btn-line btn-lg">{c.booking}</a>
        )}
      </div>
      <p class="email">{before}<a href={mailto} class="tlink">{config.CONTACT_EMAIL}</a>{after}</p>
    </div>
  </div>
</section>
<style>
  .cta { padding-block: clamp(120px, 16vw, 220px); }
  .inner { display: grid; gap: 56px; align-items: end; }
  h2 { font-size: clamp(3rem, 8vw, 8rem); line-height: 0.95; letter-spacing: -0.025em; max-width: 11ch; color: var(--color-on-dark); }
  h2 :global(strong) { color: #fff; }
  /* The ² mark, fixed to the last word so it never wraps on its own. */
  h2 :global(strong)::after {
    content: ''; display: inline-block; width: 0.17em; height: 0.17em; margin-left: 0.06em;
    background: var(--color-coral); vertical-align: 0.6em;
  }
  .side { display: grid; gap: 28px; max-width: 30rem; }
  .body { color: var(--color-muted-dark); font-size: 1.12rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .email { font-size: var(--text-small); color: var(--color-muted-dark); }
  .email a { color: var(--color-on-dark); }
  @media (min-width: 1000px) { .inner { grid-template-columns: 1.6fr 1fr; gap: 96px; } }
</style>
