---
import { content } from '../content/site';
const items = content.marquee.items;
---
<!-- The work Me² takes on, scrolling past. The list is also in the page once as plain text for screen readers. -->
<section class="marquee" aria-label={content.marquee.label}>
  <ul class="sr-only">
    {items.map((item) => <li>{item}</li>)}
  </ul>
  <div class="track" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="row">
        {items.map((item) => (
          <span class="item"><span class="spark">²</span>{item}</span>
        ))}
      </div>
    ))}
  </div>
</section>
<style>
  .marquee {
    position: relative; overflow: hidden;
    background: var(--color-abyss);
    border-top: 1px solid var(--color-line-dark);
    border-bottom: 1px solid var(--color-line-dark);
    padding-block: 26px;
  }
  /* Fade the words out at both edges, into the navy (not the page behind). */
  .marquee::before, .marquee::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 12%; z-index: 1; pointer-events: none;
  }
  .marquee::before { left: 0; background: linear-gradient(90deg, var(--color-abyss), transparent); }
  .marquee::after { right: 0; background: linear-gradient(270deg, var(--color-abyss), transparent); }
  .track { display: flex; width: max-content; animation: slide 48s linear infinite; }
  .row { display: flex; gap: 56px; padding-right: 56px; }
  .item {
    display: inline-flex; align-items: center; gap: 18px; white-space: nowrap;
    font-family: var(--font-display); font-weight: 300; font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    color: rgb(214 232 242 / 0.9); letter-spacing: -0.01em;
  }
  .spark { color: var(--color-coral); font-weight: 600; font-size: 0.7em; transform: translateY(-0.35em); }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
  @media (hover: hover) and (pointer: fine) { .marquee:hover .track { animation-play-state: paused; } }
</style>
