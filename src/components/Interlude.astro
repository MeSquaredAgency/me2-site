---
import { content } from '../content/site';
const c = content.interlude;
// Split into words so each can rise into place in turn; the **…** part is the italic half.
const [plain, emph] = c.h2.split('**').filter(Boolean);
const words = [
  ...plain.trim().split(' ').map((w) => ({ w, em: false })),
  ...emph.trim().split(' ').map((w) => ({ w, em: true })),
];
---
<section class="interlude bg-ivory" aria-labelledby="interlude-title">
  <div class="wrap">
    <h2 id="interlude-title" class="say" data-say>
      {words.map((x, i) => (
        <Fragment>{x.em && !words[i - 1]?.em && <br />}<span class:list={['wd', { em: x.em, last: i === words.length - 1 }]} style={`--i:${i}`}><span>{x.w}</span></span>{' '}</Fragment>
      ))}
    </h2>
    <p class="body reveal" style="--d:3">{c.body}</p>
  </div>
</section>

<script>
  // Words rise into place once the line is on screen. Visible straight away without JS or with reduced motion.
  const say = document.querySelector<HTMLElement>('[data-say]');
  if (say && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    say.classList.add('is-armed');
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { say.classList.add('is-said'); io.disconnect(); } }, { threshold: 0.35 });
    io.observe(say);
  }
</script>

<style>
  .interlude { padding-block: clamp(120px, 15vw, 220px); border-bottom: 1px solid var(--color-line); }
  .say {
    font-size: clamp(3.1rem, 9.6vw, 10.5rem); line-height: 0.95; letter-spacing: -0.035em;
    text-wrap: initial;
  }
  /* Each word is a little window its text rises through; padding leaves room for italic overhang. */
  .wd { display: inline-block; overflow: hidden; vertical-align: top; padding: 0 0.08em 0.1em 0; margin: 0 -0.08em -0.1em 0; }
  .wd > span { display: inline-block; }
  .em { font-style: italic; }
  .wd.last > span::after {
    content: ''; display: inline-block; width: 0.15em; height: 0.15em; margin-left: 0.05em;
    background: var(--color-coral); vertical-align: 0.62em;
  }
  .body { margin-top: 56px; max-width: 34ch; font-size: clamp(1.15rem, 1.6vw, 1.45rem); color: var(--color-muted); }

  .say.is-armed .wd > span { transform: translateY(105%); transition: transform 1100ms cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 70ms); }
  .say.is-armed.is-said .wd > span { transform: none; }
  @media (min-width: 1000px) {
    .body { margin-left: auto; margin-right: 8%; }
  }
</style>
