---
import EmailLink from './EmailLink.astro';
import DesignVisual from './DesignVisual.astro';
import BuildVisual from './BuildVisual.astro';
import RunBoard from './RunBoard.astro';
import { content } from '../content/site';
const c = content.services;
---
<!--
  Design, Build, Run. On wide screens a dark "screen" stays beside the text and shows each service at work
  as you read about it; on phones it stays at the top of the screen while the words pass below.
-->
<section id="services" class="services on-paper" aria-labelledby="services-title">
  <div class="wrap">
    <div class="head">
      <p class="kicker">{c.kicker}</p>
      <div>
        <h2 id="services-title">{c.h2}</h2>
        <p class="lede intro">{c.intro}</p>
      </div>
    </div>

    <div class="grid">
      <div class="stage-col">
        <div class="stage" data-stage data-active="design">
          <div class="vis" data-for="design"><DesignVisual /></div>
          <div class="vis" data-for="build"><BuildVisual /></div>
          <div class="vis vis-run" data-for="run"><RunBoard /></div>
          <ol class="pips" aria-hidden="true">{c.items.map((s) => <li data-for={s.key}>{s.name}</li>)}</ol>
        </div>
      </div>

      <div class="list">
        {c.items.map((s, i) => (
          <article class="svc" data-svc={s.key} aria-labelledby={`svc-${s.key}`}>
            <p class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 id={`svc-${s.key}`} class="name">{s.name}</h3>
            <p class="title">{s.title}</p>
            <p class="body">{s.body}</p>
            <ul class="includes">{s.includes.map((x) => <li>{x}</li>)}</ul>
            <EmailLink subject={content.ui.subjects[s.subject]} class="btn btn-dark"><span class="dot" aria-hidden="true"></span>{s.button}</EmailLink>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const blocks = [...document.querySelectorAll<HTMLElement>('[data-svc]')];
  if (stage && blocks.length) {
    // The service whose text crosses the middle of the screen is the one on show.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) stage.dataset.active = (e.target as HTMLElement).dataset.svc!;
    }, { rootMargin: '-48% 0px -48% 0px' });
    blocks.forEach((b) => io.observe(b));

    // The Build diagram is SMIL: pause it unless Build is on show (and always, for reduced motion).
    const svg = stage.querySelector<SVGSVGElement>('[data-build-svg]');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (svg) {
      const sync = () => (!still && stage.dataset.active === 'build' ? svg.unpauseAnimations() : svg.pauseAnimations());
      new MutationObserver(sync).observe(stage, { attributes: true, attributeFilter: ['data-active'] });
      sync();
      if (still) svg.setCurrentTime(2.2);
    }
  }
</script>

<style>
  .services { padding-block: var(--section-y); }
  .head { display: grid; gap: 28px; margin-bottom: clamp(56px, 8vw, 120px); }
  .head h2 { max-width: 16ch; }
  .intro { margin-top: 28px; }

  .grid { display: grid; gap: 40px; }

  /* The screen: dark glass on paper, lit faintly from its top-right corner like the mark. */
  .stage {
    position: relative; overflow: hidden; border-radius: 14px;
    background:
      radial-gradient(60% 60% at 100% 0%, rgb(var(--glow) / 0.16), transparent 70%),
      linear-gradient(160deg, #10202f, var(--color-abyss) 60%);
    box-shadow: 0 40px 80px -30px rgb(8 18 28 / 0.45), inset 0 1px 0 rgb(232 237 241 / 0.08);
    aspect-ratio: 4 / 3.3;
  }
  .vis {
    position: absolute; inset: 9% 8% 15%; display: grid; place-items: center;
    opacity: 0; transform: translateY(14px) scale(0.985);
    transition: opacity 700ms var(--ease-out), transform 900ms var(--ease-out);
  }
  .vis-run { inset: 11% 9% 15%; place-items: stretch; align-content: center; }
  .stage[data-active='design'] [data-for='design'],
  .stage[data-active='build'] [data-for='build'],
  .stage[data-active='run'] [data-for='run'] { opacity: 1; transform: none; }
  .pips {
    position: absolute; left: 8%; right: 8%; bottom: 5.5%; list-style: none; margin: 0; padding: 0;
    display: flex; gap: 22px; font-size: 0.85rem; font-weight: 500; color: rgb(232 237 241 / 0.4);
  }
  .pips li { display: inline-flex; align-items: center; gap: 8px; transition: color 500ms var(--ease); }
  .pips li::before { content: ''; width: 6px; height: 6px; border: 1px solid currentColor; transition: background-color 500ms var(--ease); }
  .stage[data-active='design'] .pips [data-for='design'],
  .stage[data-active='build'] .pips [data-for='build'],
  .stage[data-active='run'] .pips [data-for='run'] { color: var(--color-mist); }
  .stage[data-active='design'] .pips [data-for='design']::before,
  .stage[data-active='build'] .pips [data-for='build']::before,
  .stage[data-active='run'] .pips [data-for='run']::before { background: var(--color-coral); border-color: var(--color-coral); }

  .svc { padding-block: 40px 56px; border-top: 1px solid var(--color-line); }
  .idx { font-size: 0.95rem; font-weight: 500; color: var(--color-slate); font-variant-numeric: tabular-nums; }
  .name {
    margin-top: 10px; font-size: clamp(3.2rem, 6.6vw, 7.2rem); font-weight: 520; font-stretch: 86%;
    letter-spacing: -0.05em; line-height: 0.9;
  }
  .title { margin-top: 18px; font-size: clamp(1.25rem, 1.6vw, 1.6rem); font-weight: 520; letter-spacing: -0.02em; line-height: 1.25; }
  .body { margin-top: 16px; max-width: 46ch; color: var(--color-slate); font-size: 1.08rem; line-height: 1.6; }
  .includes { list-style: none; margin: 28px 0 36px; padding: 0; max-width: 46ch; border-top: 1px solid var(--color-line); }
  .includes li { display: flex; align-items: center; gap: 14px; padding: 13px 0; border-bottom: 1px solid var(--color-line); font-weight: 500; }
  .includes li::before { content: ''; width: 6px; height: 6px; background: var(--color-ink); flex: none; }

  @media (min-width: 1000px) {
    .head { grid-template-columns: 1fr 2.4fr; align-items: start; }
    .head .kicker { margin-top: 0.9em; }
    .grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: clamp(48px, 6vw, 112px); align-items: start; }
    .stage-col { position: sticky; top: max(96px, calc(50svh - 36vw * 0.42)); }
    .svc { min-height: 82svh; box-sizing: border-box; padding-block: 48px 72px; }
    .svc:first-child { border-top: 0; padding-top: 0; }
  }
  @media (max-width: 999px) {
    /* Phones and tablets: the screen stays at the top while the words pass beneath it. */
    .stage-col { position: sticky; top: 64px; z-index: 2; padding-block: 8px 12px; background: var(--color-paper); margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
    .stage { aspect-ratio: 4 / 3.4; max-height: 42svh; margin-inline: auto; }
    .vis-run { inset: 7% 7% 15%; }
    .pips { font-size: 0.75rem; gap: 14px; }
    .svc { padding-block: 32px 48px; }
  }
</style>
