---
import { content } from '../content/site';
const c = content.visuals.build;
// Each journey: in from one source, through the AI role and the check, out to one destination.
const ins = [122, 230, 338];
const outs = [122, 230, 338];
const journey = (a: number, b: number) =>
  `M150 ${ins[a]} C205 ${ins[a]} 205 230 250 230 L410 230 L470 230 C505 230 490 ${outs[b]} 520 ${outs[b]}`;
const packets = [
  { a: 0, b: 0, caught: false },
  { a: 1, b: 2, caught: false },
  { a: 2, b: 1, caught: true },
  { a: 0, b: 1, caught: false },
  { a: 1, b: 0, caught: false },
  { a: 2, b: 2, caught: false },
];
const DUR = 4.8;
---
<!-- Build: work flows in from your inboxes and forms, through an AI role and a person's check, out to your systems. Decorative. -->
<figure class="build-visual" data-visual="build">
  <p class="sr-only">{c.srSummary}</p>
  <svg viewBox="0 0 640 460" aria-hidden="true" focusable="false" data-build-svg>
    <g class="lanes">
      {ins.map((y) => <path d={`M150 ${y} C205 ${y} 205 230 250 230`} />)}
      <path d="M370 230 L410 230" />
      {outs.map((y) => <path d={`M470 230 C505 230 490 ${y} 520 ${y}`} />)}
    </g>

    {packets.map((p, i) => (
      <rect class:list={['pk', { caught: p.caught }]} x="-4.5" y="-4.5" width="9" height="9" opacity="0">
        <set attributeName="opacity" to="1" begin={`${(i * DUR) / packets.length}s`} />
        <animateMotion dur={`${DUR}s`} begin={`${(i * DUR) / packets.length}s`} repeatCount="indefinite" path={journey(p.a, p.b)} calcMode="spline" keyPoints="0;0.36;0.36;1" keyTimes="0;0.42;0.58;1" keySplines="0.3 0 0.5 1;0 0 1 1;0.3 0 0.5 1" />
        <animate attributeName="fill" dur={`${DUR}s`} begin={`${(i * DUR) / packets.length}s`} repeatCount="indefinite"
          values={p.caught ? 'rgba(0,0,0,0);rgba(0,0,0,0);#e7785c;#e7785c' : 'rgba(0,0,0,0);rgba(0,0,0,0);#e8edf1;#e8edf1'} keyTimes="0;0.6;0.62;1" />
      </rect>
    ))}

    {c.inputs.map((label, i) => (
      <g class="chip" transform={`translate(30 ${ins[i] - 22})`}>
        <rect width="120" height="44" rx="6" />
        <rect class="chip-sq" x="16" y="18" width="8" height="8" />
        <text x="34" y="26.5">{label}</text>
      </g>
    ))}

    <g class="core" transform="translate(250 170)">
      <rect width="120" height="120" rx="10" />
      <text x="16" y="28">{c.core}</text>
      {Array.from({ length: 16 }, (_, k) => (
        <rect class="cell" x={16 + (k % 4) * 23} y={44 + Math.floor(k / 4) * 17} width="11" height="11" style={`--k:${(k * 7) % 16}`} />
      ))}
    </g>

    <g class="check" transform="translate(410 200)">
      <rect width="60" height="60" rx="8" />
      <rect class="half" x="24" y="24" width="12" height="12" /><rect class="half-fill" x="24" y="30" width="12" height="6" />
      <text x="30" y="84" text-anchor="middle">{c.check}</text>
    </g>

    {c.outputs.map((label, i) => (
      <g class="chip out" transform={`translate(520 ${outs[i] - 22})`}>
        <rect width="104" height="44" rx="6" />
        <rect class="chip-sq" x="16" y="18" width="8" height="8" />
        <text x="34" y="26.5">{label}</text>
      </g>
    ))}
  </svg>
</figure>

<style>
  .build-visual { margin: 0; width: 100%; }
  svg { display: block; width: 100%; height: auto; overflow: visible; font-family: var(--font-sans); }
  .lanes path { fill: none; stroke: rgb(232 237 241 / 0.16); stroke-width: 1.2; stroke-dasharray: 3 5; }
  .pk { stroke: var(--color-mist); stroke-width: 1.2; }
  .pk.caught { stroke: var(--color-coral); }
  .chip rect:first-child { fill: rgb(232 237 241 / 0.04); stroke: rgb(232 237 241 / 0.16); }
  .chip text { fill: var(--color-mist); font-size: 13px; font-weight: 500; }
  .chip-sq { fill: none; stroke: rgb(232 237 241 / 0.6); }
  .out .chip-sq { fill: var(--color-mist); stroke: none; }
  .core > rect:first-child { fill: #12263a; stroke: rgb(232 237 241 / 0.28); }
  .core text { fill: var(--color-mist); font-size: 13px; font-weight: 600; }
  .cell { fill: rgb(232 237 241 / 0.12); }
  :global([data-active='build']) .cell { animation: think 1.6s ease-in-out infinite; animation-delay: calc(var(--k) * 0.1s); }
  @keyframes think { 0%, 100% { fill: rgb(232 237 241 / 0.1); } 40% { fill: rgb(232 237 241 / 0.75); } }
  .check > rect:first-child { fill: #0c1824; stroke: rgb(232 237 241 / 0.4); }
  .half { fill: none; stroke: var(--color-mist); }
  .half-fill { fill: var(--color-mist); }
  .check text { fill: var(--color-haze); font-size: 12px; font-weight: 500; }
  @media (prefers-reduced-motion: reduce) { :global([data-active='build']) .cell { animation: none; } }
</style>
