---
import EmailLink from './EmailLink.astro';
import Emph from './Emph.astro';
import { fill, flags } from '../config';
import { content } from '../content/site';
const c = content.hero;
---
<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="kicker">{c.kicker}</p>
      <h1 id="hero-title"><Emph text={c.h1} /></h1>
      <p class="subhead">{fill(c.subhead)}</p>
      <div class="actions">
        <EmailLink subject={content.ui.subjects.general} class="btn btn-solid btn-lg">{c.primary}</EmailLink>
        <a href="#demo" class="tlink see">{c.secondary}</a>
      </div>
      {flags.showLocations && <p class="location">{c.location}</p>}
    </div>

    <!--
      The signature: "me, squared". A square made of tasks. AI outlines them (the volume),
      a human-check line sweeps across and each square it passes becomes solid (checked, owned).
      Coral squares are errors, caught and corrected at the line. The small coral square at the
      top right is the "²". Decorative; the legend below says the same in words.
    -->
    <figure class="square" data-square aria-hidden="true">
      <canvas data-square-canvas></canvas>
    </figure>
    <ul class="legend" aria-label={c.legendLabel}>
      <li><span class="key key-draft"></span>{c.legend[0]}</li>
      <li><span class="key key-check"></span>{c.legend[1]}</li>
      <li><span class="key key-error"></span>{c.legend[2]}</li>
    </ul>
  </div>
</section>

<script>
  const fig = document.querySelector<HTMLElement>('[data-square]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-square-canvas]');
  if (fig && canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = 12;                 // 12 × 12 = 144 tasks
    const IVORY = '236,231,222', CORAL = '231,120,92';
    type Cell = { draftAt: number; err: boolean; checkedAt: number };
    let size = 0, cell = 0, gap = 0, pad = 0, dpr = 1, cells: Cell[] = [];
    let start = 0, raf = 0, running = false;
    const CYCLE = 10.5;           // seconds per cycle
    const SCAN_FROM = 1.4, SCAN_DUR = 5.2, HOLD_TO = 9.2;

    const seedCycle = () => {
      cells = Array.from({ length: N * N }, (_, i) => {
        const col = i % N;
        return { draftAt: col * 0.11 + Math.random() * 0.9, err: Math.random() < 0.07, checkedAt: Infinity };
      });
    };

    const resize = () => {
      const w = fig.clientWidth;
      dpr = Math.min(devicePixelRatio || 1, 2);
      size = w;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(w * dpr);
      canvas.style.width = w + 'px'; canvas.style.height = w + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      pad = w * 0.12;                         // room for the ² square, top right
      const grid = w - pad * 1.25;
      gap = Math.max(3, grid * 0.024);
      cell = (grid - gap * (N - 1)) / N;
    };

    const gx = (col: number) => pad * 0.25 + col * (cell + gap);
    const gy = (row: number) => pad + row * (cell + gap);
    const gridW = () => N * cell + (N - 1) * gap;

    const draw = (t: number) => {
      ctx.clearRect(0, 0, size, size);
      const fade = t > HOLD_TO ? Math.max(0, 1 - (t - HOLD_TO) / 1.1) : 1;
      const scanX = gx(0) + ((t - SCAN_FROM) / SCAN_DUR) * (gridW() + 12);
      const scanning = t >= SCAN_FROM && t <= SCAN_FROM + SCAN_DUR + 0.2;

      for (let i = 0; i < cells.length; i++) {
        const c = cells[i];
        const col = i % N, row = Math.floor(i / N);
        const x = gx(col), y = gy(row);
        if (t < c.draftAt) continue;
        const drafted = Math.min(1, (t - c.draftAt) / 0.35);
        if (c.checkedAt === Infinity && scanX >= x + cell / 2 && t >= SCAN_FROM) c.checkedAt = t;
        const since = t - c.checkedAt;
        ctx.globalAlpha = fade;
        if (since >= 0) {
          if (c.err && since < 0.55) {
            // Caught: a coral flash before it is put right.
            ctx.fillStyle = `rgba(${CORAL},${0.6 + 0.4 * Math.sin(since * 22)})`;
            ctx.fillRect(x, y, cell, cell);
          } else {
            const k = Math.min(1, (since - (c.err ? 0.55 : 0)) / 0.25);
            ctx.fillStyle = `rgba(${IVORY},${0.25 + 0.65 * k})`;
            ctx.fillRect(x, y, cell, cell);
          }
        } else {
          ctx.strokeStyle = c.err ? `rgba(${CORAL},${0.9 * drafted})` : `rgba(${IVORY},${0.42 * drafted})`;
          ctx.lineWidth = 1;
          ctx.strokeRect(x + 0.5, y + 0.5, cell - 1, cell - 1);
        }
      }

      // The human-check line.
      if (scanning) {
        ctx.globalAlpha = 1;
        const top = gy(0) - 18, bottom = gy(N - 1) + cell + 18;
        const g = ctx.createLinearGradient(0, top, 0, bottom);
        g.addColorStop(0, `rgba(${IVORY},0)`); g.addColorStop(0.5, `rgba(${IVORY},0.95)`); g.addColorStop(1, `rgba(${IVORY},0)`);
        ctx.fillStyle = g;
        ctx.fillRect(Math.min(scanX, gx(N - 1) + cell + 6), top, 1.2, bottom - top);
      }

      // The ²: once the square is complete, a small coral square settles at its top right.
      const done = t - (SCAN_FROM + SCAN_DUR);
      if (done > 0) {
        const k = Math.min(1, done / 0.6);
        const ease = 1 - Math.pow(1 - k, 3);
        const s = pad * 0.72;
        const ex = gx(N - 1) + cell + gap * 2.2, ey = gy(0) - s - gap * 2.2;
        ctx.globalAlpha = fade * ease;
        ctx.fillStyle = `rgb(${CORAL})`;
        ctx.fillRect(ex, ey + (1 - ease) * 10, s, s);
      }
      ctx.globalAlpha = 1;
    };

    const finalFrame = () => {
      seedCycle();
      cells.forEach((c) => { c.draftAt = 0; c.err = false; c.checkedAt = -10; });
      draw(SCAN_FROM + SCAN_DUR + 2);
    };

    const loop = (now: number) => {
      if (!start) { start = now; seedCycle(); }
      let t = (now - start) / 1000;
      if (t > CYCLE) { start = now; seedCycle(); t = 0; }
      draw(t);
      raf = requestAnimationFrame(loop);
    };
    const play = () => { if (!running && !reduce) { running = true; start = 0; raf = requestAnimationFrame(loop); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    resize();
    if (reduce) finalFrame();
    else {
      finalFrame(); // something to see straight away; the animation takes over once the page is idle
      setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(play, { timeout: 1500 }) : play()), 700);
      new IntersectionObserver(([e]) => (e.isIntersecting ? play() : stop())).observe(fig);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
    }
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { resize(); if (!running) finalFrame(); }, 150); });
  }
</script>

<style>
  .hero {
    position: relative; overflow: hidden;
    min-height: max(680px, 100svh);
    display: flex; align-items: center;
    background:
      radial-gradient(60% 70% at 85% 40%, rgb(236 231 222 / 0.05), transparent 70%),
      var(--color-ink);
  }
  .grid {
    display: grid; gap: 48px; align-items: center;
    padding-top: 120px; padding-bottom: 96px;
  }
  .kicker {
    font-size: var(--text-label); font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--color-muted-dark); margin-bottom: 36px;
    display: flex; align-items: center; gap: 14px;
  }
  .kicker::before { content: ''; width: 28px; height: 1px; background: var(--color-coral); }
  h1 { max-width: 11ch; color: var(--color-on-dark); }
  h1 :global(strong) { display: block; color: #fff; }
  .subhead { margin-top: 34px; max-width: 44ch; font-size: clamp(1.05rem, 1.25vw, 1.2rem); color: var(--color-muted-dark); }
  .actions { margin-top: 48px; display: flex; flex-wrap: wrap; align-items: center; gap: 22px 34px; }
  .see { font-weight: 500; color: var(--color-on-dark); }
  .location { margin-top: 28px; font-size: var(--text-small); color: var(--color-muted-dark); }

  .square { margin: 0; width: min(100%, 520px); justify-self: center; aspect-ratio: 1; }
  .square canvas { display: block; }
  .legend {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px 26px; justify-content: center;
    font-size: var(--text-label); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-muted-dark);
  }
  .legend li { display: inline-flex; align-items: center; gap: 10px; }
  .key { width: 10px; height: 10px; display: inline-block; }
  .key-draft { border: 1px solid rgb(236 231 222 / 0.6); }
  .key-check { background: var(--color-on-dark); }
  .key-error { background: var(--color-coral); }

  @media (min-width: 1000px) {
    .grid { grid-template-columns: 1.05fr 1fr; grid-template-rows: auto auto; column-gap: 72px; row-gap: 20px; }
    .copy { grid-row: 1 / span 2; }
    .square { grid-column: 2; align-self: end; }
    .legend { grid-column: 2; align-self: start; }
  }
  @media (max-width: 999px) {
    .grid { padding-top: 132px; gap: 40px; }
    .square { width: min(82vw, 380px); margin-top: 16px; }
    .legend { margin-top: -18px; }
  }
</style>
