---
import EmailLink from './EmailLink.astro';
import { fill, flags } from '../config';
import { content } from '../content/site';
const c = content.hero;
---
<section class="hero on-dark" aria-labelledby="hero-title">
  <!--
    The Me² mark in light: a dark glass square with the small coral square (the ²) glowing at its corner,
    drawn live in WebGL. It turns slowly, leans toward the pointer and tips back as the page scrolls.
    Decorative; the CSS mark underneath stands in without WebGL, and reduced motion gets one still frame.
  -->
  <div class="stage" aria-hidden="true">
    <div class="mark-fallback"><span class="big"></span><span class="small"></span></div>
    <canvas class="gl" data-mark></canvas>
  </div>
  <p class="sr-only">{fill(c.markSummary)}</p>

  <div class="wrap inner">
    <h1 id="hero-title" class="lines">
      {c.lines.map((l, i) => (
        <span class="line" style={`--i:${i}`}>
          <span class="mask"><span class="text">{l.text}</span></span>
          <span class="note" aria-hidden="true"><span class="note-sq"></span>{l.note}</span>
        </span>
      ))}
    </h1>
    <div class="foot">
      <p class="subhead">{fill(c.subhead)}</p>
      <div class="actions">
        <EmailLink subject={content.ui.subjects.general} class="btn btn-light btn-lg"><span class="dot" aria-hidden="true"></span>{c.primary}</EmailLink>
        <a href="#work" class="tlink see">{c.secondary}</a>
      </div>
      {flags.showLocations && <p class="location">{c.location}</p>}
    </div>
  </div>
</section>

<script>
  import { startMark } from '../lib/mark-gl';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-mark]');
  if (canvas) {
    // Start once the page has loaded and gone quiet, so the headline paints first.
    const go = () => startMark(canvas);
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 1200 }) : setTimeout(go, 120));
    document.readyState === 'complete' ? idle() : addEventListener('load', idle, { once: true });
  }
</script>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: max(680px, 100svh);
    display: flex; align-items: flex-end;
    background: radial-gradient(60% 75% at 80% 40%, #0e1f2f 0%, var(--color-abyss) 70%);
  }

  /* ---- The mark ---- */
  .stage { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .gl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1600ms var(--ease-out); }
  .gl:global(.is-on) { opacity: 1; }
  /* Without WebGL: the same mark in CSS, still. Hidden once the live one is drawing. */
  .mark-fallback {
    position: absolute; left: 77.5%; top: 47%; width: min(21vw, 40vh); aspect-ratio: 1; translate: -50% -50%;
    transition: opacity 1200ms var(--ease-out);
  }
  .gl:global(.is-on) + .mark-fallback, .stage:has(.gl.is-on) .mark-fallback { opacity: 0; }
  .mark-fallback .big {
    position: absolute; inset: 0; border-radius: 4%;
    background: linear-gradient(145deg, #1a3046 0%, #0b1824 45%, #070f17 100%);
    box-shadow: inset 0 1px 0 rgb(232 237 241 / 0.18), inset 1px 0 0 rgb(232 237 241 / 0.08), 0 40px 120px rgb(0 0 0 / 0.5);
  }
  .mark-fallback .small {
    position: absolute; width: 26%; aspect-ratio: 1; right: -32%; top: -32%; border-radius: 8%;
    background: var(--color-coral);
    box-shadow: 0 0 60px 10px rgb(var(--glow) / 0.55), 0 0 200px 60px rgb(var(--glow) / 0.22);
  }

  /* ---- The words ---- */
  .inner { position: relative; padding-top: 140px; padding-bottom: clamp(40px, 6vh, 72px); }
  /* Lines in one column, their notes lined up in a second column at the same height as each line's baseline. */
  .lines { display: grid; grid-template-columns: auto 1fr; column-gap: clamp(28px, 3.4vw, 64px); row-gap: 0.02em; font-size: clamp(3.1rem, min(10.4vw, 15.5svh), 11rem); max-width: none; }
  .line { display: contents; }
  .mask { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .text { display: block; white-space: nowrap; }
  .note {
    display: inline-flex; align-items: center; gap: 12px; align-self: end; padding-bottom: 0.62em;
    font-size: clamp(0.95rem, 1.05vw, 1.15rem); font-weight: 450; font-stretch: 100%; letter-spacing: -0.005em; line-height: 1.3;
    color: var(--color-haze); white-space: nowrap;
  }
  .note-sq { width: 7px; height: 7px; flex: none; border: 1px solid var(--color-haze); }
  .line:nth-child(2) .note-sq { background: linear-gradient(0deg, var(--color-haze) 50%, transparent 50%); }
  .line:nth-child(3) .note-sq { background: var(--color-coral); border-color: var(--color-coral); }

  .foot {
    margin-top: clamp(36px, 6vh, 72px); padding-top: 28px; border-top: 1px solid var(--color-line-dark);
    display: grid; gap: 28px 56px; align-items: end;
  }
  .subhead { max-width: 52ch; font-size: clamp(1.05rem, 1.25vw, 1.25rem); line-height: 1.55; color: var(--color-haze); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 32px; }
  .btn-lg { min-height: 58px; padding: 0 30px 0 26px; font-size: 1.05rem; }
  .see { font-weight: 560; color: var(--color-mist); }
  .location { font-size: var(--text-small); color: var(--color-haze); }

  /* One orchestrated entrance: the lines rise out of their masks, then their notes; the mark ignites behind. */
  @media (prefers-reduced-motion: no-preference) {
    .text { animation: rise 1300ms var(--ease-out) both; animation-delay: calc(120ms + var(--i) * 130ms); }
    .note { animation: fade 1000ms var(--ease-out) both; animation-delay: calc(700ms + var(--i) * 150ms); }
    .foot { animation: fade 1100ms var(--ease-out) 1000ms both; }
    .mark-fallback { animation: fade 1600ms var(--ease-out) 300ms both; }
  }
  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes fade { from { opacity: 0; transform: translateY(10px); } }

  @media (min-width: 1100px) {
    .foot { grid-template-columns: minmax(0, 1fr) auto; }
  }
  @media (max-width: 1099px) {
    .lines { grid-template-columns: 1fr; }
    .note { display: none; }
    .mark-fallback { left: 72%; top: 28%; width: 38vw; }
  }
  @media (max-width: 639px) {
    .hero { align-items: flex-end; }
    .inner { padding-top: 46svh; }
    .lines { font-size: clamp(2.9rem, 15vw, 4.6rem); }
    .mark-fallback { left: 50%; top: 31%; width: 40vw; }
  }
</style>
