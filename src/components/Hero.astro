---
import EmailLink from './EmailLink.astro';
import Emph from './Emph.astro';
import Icon, { type IconName } from './Icon.astro';
import { fill, flags } from '../config';
import { content } from '../content/site';
const c = content.hero;

/**
 * Decorative floating bubbles, grouped on the right like the link-preview image:
 * the kinds of back-office work Me² takes on. Positions are % of the bubble field.
 */
type Bubble = { icon?: IconName; size: number; x: string; y: string; delay: number; phone?: [size: number, x: string, y: string] };
const bubbles: Bubble[] = [
  { icon: 'report', size: 168, x: '46%', y: '24%', delay: 0, phone: [64, '86%', '34%'] },
  { icon: 'personCheck', size: 112, x: '18%', y: '66%', delay: 1.4, phone: [44, '70%', '18%'] },
  { icon: 'inbox', size: 74, x: '82%', y: '72%', delay: 0.7, phone: [36, '94%', '82%'] },
  { icon: 'coins', size: 62, x: '90%', y: '44%', delay: 2.2 },
  { icon: 'chat', size: 56, x: '58%', y: '90%', delay: 1.1 },
  { size: 16, x: '12%', y: '22%', delay: 0.4 },
  { size: 12, x: '72%', y: '48%', delay: 1.8 },
  { size: 10, x: '36%', y: '96%', delay: 2.6 },
];
---
<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="field" aria-hidden="true">
    <span class="halo"></span>
    {bubbles.map((b) => (
      <span
        class:list={['bubble', { dot: !b.icon, 'show-phone': !!b.phone }]}
        style={`--ds:${b.size}px;--dx:${b.x};--dy:${b.y};animation-delay:-${b.delay}s` +
          (b.phone ? `;--ps:${b.phone[0]}px;--px:${b.phone[1]};--py:${b.phone[2]}` : '')}
      >
        {b.icon && <Icon name={b.icon} size={24} />}
      </span>
    ))}
  </div>
  <div class="wrap inner">
    <h1 id="hero-title"><Emph text={c.h1} /></h1>
    <p class="subhead">{fill(c.subhead)}</p>
    <div class="actions">
      <EmailLink subject={content.ui.subjects.general} class="btn btn-primary">{c.primary}</EmailLink>
      <a href="#how" class="btn btn-outline-light">{c.secondary}</a>
    </div>
    {flags.showLocations && <p class="location">{c.location}</p>}
  </div>
</section>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(55% 75% at 88% 8%, rgb(36 82 122 / 0.6), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, rgb(27 56 83 / 0.8), transparent 70%),
      var(--color-ink);
    min-height: min(820px, 100svh);
    display: flex;
    align-items: center;
  }
  .inner {
    position: relative;
    padding-top: 150px;
    padding-bottom: 120px;
  }
  /* Two lines: "AI does the volume." light, "People own the outcome." bold in pale blue. */
  h1 { max-width: 13ch; color: #fff; font-size: clamp(2.6rem, 6.4vw, 5.25rem); line-height: 1.04; }
  h1 :global(strong) { display: block; color: var(--color-pale); }
  .subhead {
    margin-top: 28px;
    max-width: 52ch;
    color: var(--color-on-dark);
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
  }
  .actions { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 14px; }
  .location { margin-top: 28px; color: var(--color-on-dark); font-size: var(--text-small); }

  /* The bubble field sits on the right half; text never sits over a bubble on desktop. */
  .field {
    position: absolute; z-index: -1; pointer-events: none;
    top: 0; bottom: 0; right: 0; width: 46%;
  }
  .halo {
    position: absolute;
    width: 560px; height: 560px; right: -200px; top: 70px;
    border-radius: 50%;
    border: 1px solid rgb(185 211 224 / 0.14);
  }
  .bubble {
    /* Desktop size/position from the inline --ds/--dx/--dy; phones swap in --ps/--px/--py. */
    --s: var(--ds); --x: var(--dx); --y: var(--dy);
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--color-pale);
    background: radial-gradient(circle at 30% 25%, #26445f, #172a3c 70%);
    box-shadow: 0 0 0 1px rgb(185 211 224 / 0.14), 0 18px 40px -18px rgb(0 0 0 / 0.6);
    animation: float 9s ease-in-out infinite;
    will-change: transform; /* own layer: the float never repaints the page */
  }
  .bubble :global(svg) { width: 36%; height: 36%; }
  .bubble.dot { background: #2b4964; box-shadow: none; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) { .bubble { animation: none; } }

  /* Phones and tablets: three small, faint bubbles along the top-right edge, clear of the text. */
  @media (max-width: 899px) {
    .field { width: 100%; height: 150px; bottom: auto; top: 64px; }
    .halo, .bubble:not(.show-phone) { display: none; }
    .bubble { opacity: 0.55; --s: var(--ps); --x: var(--px); --y: var(--py); }
    .inner { padding-top: 200px; padding-bottom: 88px; }
  }
</style>
