---
import EmailLink from './EmailLink.astro';
import Emph from './Emph.astro';
import Icon, { type IconName } from './Icon.astro';
import { fill, flags } from '../config';
import { content } from '../content/site';
const c = content.hero;

/** Decorative floating bubbles: the kinds of back-office work Me² takes on. */
const bubbles: { icon?: IconName; size: number; x: string; y: string; phone?: boolean; delay: number }[] = [
  { icon: 'inbox', size: 92, x: '9%', y: '24%', phone: true, delay: 0 },
  { icon: 'report', size: 120, x: '86%', y: '20%', phone: true, delay: 1.2 },
  { icon: 'coins', size: 76, x: '14%', y: '74%', delay: 2.1 },
  { icon: 'personCheck', size: 104, x: '82%', y: '72%', phone: true, delay: 0.6 },
  { icon: 'chat', size: 64, x: '30%', y: '12%', delay: 1.8 },
  { icon: 'chart', size: 58, x: '68%', y: '88%', delay: 2.6 },
  { size: 14, x: '22%', y: '44%', delay: 0.4 },
  { size: 10, x: '74%', y: '40%', delay: 1.5 },
  { size: 18, x: '58%', y: '10%', delay: 2.2 },
  { size: 12, x: '40%', y: '90%', delay: 0.9 },
];
---
<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="bubbles" aria-hidden="true">
    {bubbles.map((b) => (
      <span
        class:list={['bubble', { dot: !b.icon, 'show-phone': b.phone }]}
        style={`--s:${b.size}px;left:${b.x};top:${b.y};animation-delay:-${b.delay}s`}
      >
        {b.icon && <Icon name={b.icon} size={Math.round(b.size * 0.38)} />}
      </span>
    ))}
    <span class="halo halo-1"></span>
    <span class="halo halo-2"></span>
  </div>
  <div class="wrap inner">
    <h1 id="hero-title"><Emph text={c.h1} /></h1>
    <p class="subhead">{fill(c.subhead)}</p>
    <div class="actions">
      <EmailLink subject={content.ui.subjects.general} class="btn btn-primary">{c.primary}</EmailLink>
      <a href="#how" class="btn btn-outline-light">{c.secondary}</a>
    </div>
    {flags.showLocations && <p class="location">{c.location}</p>}
  </div>
</section>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(60% 70% at 85% 10%, rgb(36 82 122 / 0.45), transparent 70%),
      radial-gradient(50% 60% at 5% 95%, rgb(27 56 83 / 0.7), transparent 70%),
      var(--color-ink);
    min-height: min(860px, 100svh);
    display: flex;
    align-items: center;
  }
  .inner {
    position: relative;
    text-align: center;
    padding-top: 150px;
    padding-bottom: 120px;
  }
  h1 { max-width: 17ch; margin-inline: auto; color: #fff; }
  h1 :global(strong) { color: var(--color-pale); }
  .subhead {
    margin: 26px auto 0;
    max-width: 58ch;
    color: var(--color-on-dark);
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
  }
  .actions { margin-top: 40px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .location { margin-top: 28px; color: var(--color-on-dark); font-size: var(--text-small); }

  .bubbles { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .bubble {
    position: absolute;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--color-pale);
    background: radial-gradient(circle at 30% 25%, #26445f, #172a3c 70%);
    box-shadow: 0 0 0 1px rgb(185 211 224 / 0.14), 0 18px 40px -18px rgb(0 0 0 / 0.6);
    animation: float 9s ease-in-out infinite;
  }
  .bubble :global(svg) { width: 38%; height: 38%; }
  .bubble.dot { background: #2b4964; box-shadow: none; }
  .halo {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgb(185 211 224 / 0.09);
  }
  .halo-1 { width: 460px; height: 460px; right: -250px; top: 110px; }
  .halo-2 { width: 300px; height: 300px; left: -150px; bottom: -150px; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) { .bubble { animation: none; } }

  @media (max-width: 899px) {
    .bubble:not(.show-phone), .halo { display: none; }
    .bubble { --s: 56px !important; opacity: 0.85; }
    .bubble:nth-child(1) { left: 12% !important; top: 15% !important; }
    .bubble:nth-child(2) { left: 88% !important; top: 18% !important; }
    .bubble:nth-child(4) { left: 86% !important; top: 92% !important; }
    .inner { padding-top: 132px; padding-bottom: 96px; }
  }
</style>
