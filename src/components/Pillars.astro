---
import { content } from '../content/site';
---
<section class="pillars bg-white" aria-label="At a glance">
  <ul class="wrap row">
    {content.pillars.map((p) => (
      <li>
        <span class="big">{p.big}</span>
        <span class="small">{p.small}</span>
      </li>
    ))}
  </ul>
</section>
<style>
  .pillars { border-bottom: 1px solid var(--color-line); }
  .row {
    list-style: none; margin-block: 0;
    display: grid; grid-template-columns: repeat(2, 1fr);
    padding-block: 36px; row-gap: 28px;
  }
  li { display: grid; gap: 4px; text-align: center; padding-inline: 12px; }
  .big { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem, 2.6vw, 2.1rem); line-height: 1.1; color: var(--color-navy); letter-spacing: -0.01em; }
  .small { color: var(--color-muted); font-size: 0.95rem; }
  @media (min-width: 900px) {
    .row { grid-template-columns: repeat(4, 1fr); padding-block: 44px; }
    li + li { border-left: 1px solid var(--color-line); }
  }
  @media (max-width: 899px) {
    li:nth-child(even) { border-left: 1px solid var(--color-line); }
  }
</style>
