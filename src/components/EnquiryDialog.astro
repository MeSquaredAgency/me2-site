---
/**
 * The dialog the enquiry form moves into when someone presses "Talk to us" or "Ask about…" away from the
 * form (EnquiryForm.astro has the script). It sits outside the contact section so it can open even while
 * that section hasn't been laid out yet.
 */
import { content } from '../content/site';
const f = content.form;
---
<dialog class="enquiry-dialog" data-enquiry-dialog aria-labelledby="enq-dialog-title">
  <div class="dlg">
    <div class="dlg-head">
      <h2 id="enq-dialog-title">{f.title}</h2>
      <button type="button" class="dlg-close" data-dialog-close aria-label={f.close}><span aria-hidden="true"></span></button>
    </div>
    <div data-dialog-slot></div>
  </div>
</dialog>

<style>
  /* The dialog: the same form, over a dimmed page. */
  .enquiry-dialog {
    width: min(560px, calc(100vw - 32px)); max-height: calc(100svh - 32px); overflow: auto; overscroll-behavior: contain; margin: auto; padding: 0; border: 0; border-radius: 18px;
    background: linear-gradient(160deg, #10202f, var(--color-abyss) 70%); color: var(--color-mist);
    box-shadow: 0 40px 120px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(244 239 231 / 0.08);
  }
  .enquiry-dialog::backdrop { background: rgb(4 9 14 / 0.62); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .enquiry-dialog[open] { animation: dlg-in 500ms var(--ease-out); }
  @keyframes dlg-in { from { opacity: 0; transform: translateY(16px) scale(0.98); } }
  @media (prefers-reduced-motion: reduce) { .enquiry-dialog[open] { animation: none; } }
  .dlg { padding: 24px clamp(20px, 4vw, 36px) 32px; }
  .dlg-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 22px; }
  .dlg-head h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); letter-spacing: -0.035em; }
  .dlg-close {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; flex: none;
    background: none; color: var(--color-mist); border: 1px solid rgb(244 239 231 / 0.24); cursor: pointer; padding: 0;
  }
  .dlg-close span { position: relative; width: 14px; height: 14px; }
  .dlg-close span::before, .dlg-close span::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; margin-top: -0.75px; background: currentColor; }
  .dlg-close span::before { transform: rotate(45deg); }
  .dlg-close span::after { transform: rotate(-45deg); }
  .dlg-close:focus-visible { outline: 2px solid var(--color-mist); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .dlg-close:hover { border-color: var(--color-mist); } }
  :global(html.dialog-open) { overflow: hidden; }
</style>
