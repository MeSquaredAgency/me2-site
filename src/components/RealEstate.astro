---
import { Image } from 'astro:assets';
import keysPhoto from '../assets/photos/real-estate-keys.jpg';
import Emph from './Emph.astro';
import { fixtureText, flags } from '../config';
import { content } from '../content/site';
interface Props { n: number }
const { n } = Astro.props;
const c = content.realEstate;
---
<section id="real-estate" class="section estate on-dark" aria-labelledby="re-title">
  <div class="wrap">
    <p class="label">{c.eyebrow}<sup>{n}</sup></p>
    <div class="layout">
      <div class="text">
        <h2 id="re-title"><Emph text={c.h2} /></h2>
        <p class="lede">{c.body}</p>
        <figure class="photo reveal">
          <Image
            src={keysPhoto}
            alt={c.imageAlt}
            widths={[480, 720, 1080]}
            sizes="(min-width: 1000px) 480px, 100vw"
            class="img"
          />
        </figure>
      </div>
      <div class="roles">
        <p class="roles-title">{c.listIntro}</p>
        <ol>
          {c.list.map((item, i) => (
            <li class="reveal" style={`--d:${i % 3}`}>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
        <p class="closing">{c.closing}</p>
        {flags.showProof && <blockquote class="proof">{fixtureText.proof ?? c.proof}</blockquote>}
      </div>
    </div>
  </div>
</section>

<style>
  .layout { margin-top: 56px; display: grid; gap: 64px; }
  .text { display: grid; gap: 28px; align-content: start; }
  .text h2 { max-width: 10ch; }
  .photo { margin: 24px 0 0; aspect-ratio: 4 / 5; overflow: hidden; max-width: 480px; }
  .photo :global(.img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: grayscale(1) contrast(1.05) brightness(0.85);
    transition: filter 900ms var(--ease), transform 1400ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .photo:hover :global(.img) { filter: grayscale(0.2) contrast(1.02) brightness(0.95); transform: scale(1.03); }
  }
  .roles-title { font-size: var(--text-label); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-muted-dark); padding-bottom: 16px; border-bottom: 1px solid var(--color-on-dark); }
  ol { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid; grid-template-columns: 56px 1fr; gap: 16px; align-items: baseline;
    padding: 24px 0; border-bottom: 1px solid var(--color-line-dark);
    font-family: var(--font-display); font-size: clamp(1.5rem, 2.3vw, 2.05rem); line-height: 1.15;
  }
  .num { font-style: italic; font-size: 1.1rem; color: var(--color-coral); }
  .closing { margin-top: 48px; color: var(--color-muted-dark); font-size: 1.1rem; max-width: 44ch; }
  .proof { margin: 40px 0 0; padding-left: 24px; border-left: 1px solid var(--color-coral); font-family: var(--font-display); font-size: 1.6rem; line-height: 1.3; }
  @media (min-width: 1000px) {
    .layout { grid-template-columns: 1fr 1.25fr; gap: 120px; }
  }
</style>
