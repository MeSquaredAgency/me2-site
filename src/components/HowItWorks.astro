---
import Emph from './Emph.astro';
import EmailLink from './EmailLink.astro';
import Icon, { type IconName } from './Icon.astro';
import { fill } from '../config';
import { content } from '../content/site';
const c = content.how;
const icons: IconName[] = ['map', 'spark', 'personCheck'];
---
<section id="how" class="section bg-mist" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{c.eyebrow}</span>
      <h2 id="how-title"><Emph text={c.h2} /></h2>
      <p>{c.intro}</p>
    </div>
    <ol class="steps">
      {c.steps.map((s, i) => (
        <li class="card">
          <span class="well"><Icon name={icons[i]} size={26} /></span>
          <span class="step-no">{c.stepLabel} {i + 1}</span>
          <h3>{s.title}</h3>
          <p>{fill(s.body)}</p>
        </li>
      ))}
    </ol>
    <div class="cta">
      <EmailLink subject={content.ui.subjects.general} class="btn btn-primary">{c.cta}</EmailLink>
    </div>
  </div>
</section>
<style>
  #how { scroll-margin-top: 0; }
  .steps { list-style: none; margin: 56px 0 0; padding: 0; display: grid; gap: 20px; }
  .card {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 36px 30px 34px;
    box-shadow: var(--shadow-card);
    display: grid; gap: 10px; align-content: start;
    text-align: center; justify-items: center;
  }
  .well {
    display: grid; place-items: center;
    width: 60px; height: 60px; border-radius: 50%;
    background: var(--color-navy); color: #fff;
    margin-bottom: 10px;
  }
  .step-no {
    font-family: var(--font-display); font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-steel);
  }
  h3 { color: var(--color-text); }
  .card p { color: var(--color-muted); max-width: 32ch; }
  .cta { margin-top: 48px; display: flex; justify-content: center; }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 64px; }
  }
</style>
