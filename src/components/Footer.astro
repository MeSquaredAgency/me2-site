---
import Logo from './Logo.astro';
import { config, fill, flags } from '../config';
import { content } from '../content/site';
const c = content.footer;
---
<footer class="site-footer on-dark">
  <div class="wrap top">
    <div class="brand">
      <Logo tone="light" height={56} />
    </div>
    <div class="col">
      <h2 class="col-title">{c.contactHeading}</h2>
      <a href={`mailto:${config.CONTACT_EMAIL}`} class="tlink mail">{config.CONTACT_EMAIL}</a>
    </div>
    <nav class="col" aria-label={c.navHeading}>
      <h2 class="col-title">{c.navHeading}</h2>
      <ul>
        {content.header.nav.map((item) => <li><a href={`/${item.href}`}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap bottom">
    <p>{fill(c.copyright)}</p>
    {flags.showLegalEntity && <p>{config.LEGAL_ENTITY}</p>}
    {flags.showPrivacyPage && <a href="/privacy/">{c.privacy}</a>}
  </div>
  <!-- The wordmark, edge to edge: the last thing on the page. Decorative (the logo above is the link). -->
  <div class="wrap giant" aria-hidden="true"><Logo tone="light" height={400} /></div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--color-line-dark); }
  .top { display: grid; gap: 48px; padding-top: 88px; padding-bottom: 72px; }
  .col { display: grid; gap: 16px; align-content: start; }
  .col-title { font-family: var(--font-sans); font-size: var(--text-label); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-muted-dark); }
  .mail { font-family: var(--font-display); font-size: 1.6rem; justify-self: start; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  ul a { display: inline-flex; min-height: 32px; align-items: center; color: var(--color-on-dark); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { ul a:hover { color: #fff; text-decoration: underline; text-underline-offset: 0.25em; text-decoration-thickness: 1px; } }
  .bottom {
    position: relative; display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: center;
    padding-top: 24px; padding-bottom: 32px; font-size: var(--text-small); color: var(--color-muted-dark);
  }
  .bottom::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); border-top: 1px solid var(--color-line-dark); }
  .bottom a { color: var(--color-on-dark); }
  /* A quiet, tonal wordmark that sinks into the bottom edge of the page. */
  .giant { padding-top: clamp(32px, 5vw, 72px); overflow: hidden; height: calc(min(100vw, var(--content-max) + 2 * var(--gutter)) * 0.39); box-sizing: border-box; }
  .giant :global(.logo) { display: block; opacity: 0.07; }
  .giant :global(.logo .logo-svg) { width: 100%; height: auto; }
  @media (min-width: 900px) { .top { grid-template-columns: 2fr 1.2fr 1fr; } }
</style>
