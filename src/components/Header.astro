---
import Logo from './Logo.astro';
import EmailLink from './EmailLink.astro';
import { fill } from '../config';
import { content } from '../content/site';
const c = content.header;
---
<a class="skip-link" href="#main">{content.ui.skipLink}</a>
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="home" aria-label={fill(content.ui.logoHomeLabel)}>
      <Logo tone="light" height={34} />
    </a>
    <nav aria-label={c.navLabel} class="nav">
      <ul>
        {c.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <EmailLink subject={content.ui.subjects.general} class="btn cta">{c.button}</EmailLink>
  </div>
</header>
<script>
  // A quiet frosted bar once the page leaves the top.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const set = () => header.classList.toggle('is-scrolled', scrollY > 24);
    addEventListener('scroll', set, { passive: true });
    set();
  }
</script>
<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 20; color: var(--color-on-dark);
    transition: background-color 400ms var(--ease), box-shadow 400ms var(--ease);
  }
  .site-header.is-scrolled {
    background: rgb(13 17 22 / 0.82);
    backdrop-filter: blur(16px) saturate(130%);
    -webkit-backdrop-filter: blur(16px) saturate(130%);
    box-shadow: 0 1px 0 var(--color-line-dark);
  }
  .bar { display: flex; align-items: center; gap: 28px; padding-block: 26px; transition: padding 400ms var(--ease); }
  .is-scrolled .bar { padding-block: 14px; }
  .home { display: inline-flex; margin-right: auto; padding: 4px 0; }
  .nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px;
    font-size: 0.9rem; letter-spacing: 0.01em; color: var(--color-muted-dark); text-decoration: none;
    transition: color 250ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) { .nav a:hover { color: var(--color-on-dark); } }
  .bar :global(.cta) { min-height: 44px; padding: 0 22px; font-size: 0.9rem; border-color: rgb(236 231 222 / 0.35); color: var(--color-on-dark); }
  @media (hover: hover) and (pointer: fine) { .bar :global(.cta:hover) { border-color: var(--color-on-dark); } }
  .site-header :global(:focus-visible) { outline-color: var(--color-on-dark); }
  @media (max-width: 999px) { .nav { display: none; } }
  @media (max-width: 639px) {
    .bar { padding-block: 16px; }
    .home :global(.logo-svg) { height: 28px; }
  }
</style>
