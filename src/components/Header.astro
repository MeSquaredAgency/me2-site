---
import Logo from './Logo.astro';
import EmailLink from './EmailLink.astro';
import { fill } from '../config';
import { content } from '../content/site';
const c = content.header;
---
<a class="skip-link" href="#main">{content.ui.skipLink}</a>
<header class="site-header on-dark">
  <div class="wrap bar">
    <a href="/" class="home" aria-label={fill(content.ui.logoHomeLabel)}>
      <Logo tone="light" height={36} class="header-logo" />
    </a>
    <nav aria-label={c.navLabel} class="nav">
      <ul>
        {c.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <EmailLink subject={content.ui.subjects.general} class="btn btn-primary header-cta">{c.button}</EmailLink>
  </div>
</header>
<style>
  .site-header { position: absolute; inset: 0 0 auto; z-index: 10; }
  .bar { display: flex; align-items: center; gap: 24px; padding-block: 20px; }
  .home { display: inline-flex; padding: 4px 0; margin-right: auto; }
  .home :global(.header-logo) { height: 36px; }
  .nav ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px;
    font-family: var(--font-display); font-size: 0.95rem; font-weight: 500;
    color: rgb(255 255 255 / 0.86); text-decoration: none; border-radius: 8px;
  }
  @media (hover: hover) and (pointer: fine) { .nav a:hover { color: #fff; background: rgb(255 255 255 / 0.08); } }
  .header-cta { min-height: 44px; padding: 0 20px; font-size: 0.95rem; }
  @media (max-width: 899px) {
    .nav { display: none; }
  }
  @media (max-width: 639px) {
    .bar { padding-block: 14px; }
    .home :global(.header-logo) { height: 30px; }
  }
</style>
