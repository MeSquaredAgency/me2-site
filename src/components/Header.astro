---
import Logo from './Logo.astro';
import EnquireLink from './EnquireLink.astro';
import { fill, shown } from '../config';
import { content } from '../content/site';
const c = content.header;
/** "paper" over a light first section (the home page's hero); "dark" (the default) over a dark one. */
const { tone = 'dark' } = Astro.props as { tone?: 'dark' | 'paper' };
---
<a class="skip-link" href="#main">{content.ui.skipLink}</a>
<header class:list={['site-header', `tone-${tone}`]} data-header>
  <div class="wrap bar">
    <a href="/" class="home" aria-label={fill(content.ui.logoHomeLabel)}>
      <Logo tone={tone === 'paper' ? 'navy' : 'light'} height={32} />
    </a>
    <nav aria-label={c.navLabel} class="nav">
      <ul>
        {shown(c.nav).map((item) => <li><a href={`/${item.href}`}>{item.label}</a></li>)}
      </ul>
    </nav>
    <EnquireLink source="header" class={`btn ${tone === 'paper' ? 'btn-dark' : 'btn-light'} cta`}><span class="dot" aria-hidden="true"></span>{c.button}</EnquireLink>
  </div>
</header>
<script>
  // Clear over the hero; a frosted bar once the page moves. It tucks away while you read down and comes back when you scroll up.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let lastY = scrollY;
    const set = () => {
      const y = scrollY;
      header.classList.toggle('is-scrolled', y > 24);
      if (Math.abs(y - lastY) > 6) {
        header.classList.toggle('is-tucked', y > lastY && y > innerHeight * 0.9 && !header.contains(document.activeElement));
        lastY = y;
      }
    };
    addEventListener('scroll', set, { passive: true });
    header.addEventListener('focusin', () => header.classList.remove('is-tucked'));
    set();
  }
</script>
<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 40; color: var(--color-mist);
    transition: background-color 500ms var(--ease-out), box-shadow 500ms var(--ease-out), transform 600ms var(--ease-out);
  }
  .site-header.is-scrolled {
    background: rgb(18 29 40 / 0.78);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 1px 0 var(--color-line-dark);
  }
  /* Over a light hero: ink type, and a frosted warm-paper bar once the page moves. */
  .tone-paper { color: var(--color-ink); }
  .tone-paper .nav a, .tone-paper.is-scrolled .nav a { color: var(--color-ink); }
  .tone-paper.is-scrolled { background: rgb(247 242 234 / 0.86); box-shadow: 0 1px 0 var(--color-line); }
  .tone-paper :global(:focus-visible) { outline-color: var(--color-ink); }
  .site-header.is-tucked { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .site-header.is-tucked { transform: none; } }
  .bar { display: flex; align-items: center; gap: 28px; padding-block: 24px; transition: padding 500ms var(--ease-out); }
  .is-scrolled .bar { padding-block: 12px; }
  .home { display: inline-flex; margin-right: auto; padding: 6px 0; }
  .nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px;
    font-size: 0.95rem; font-weight: 500; color: var(--color-haze); text-decoration: none;
    transition: color 300ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) { .nav a:hover { color: var(--color-mist); } }
  /* Over a paper section the frosted bar is mid-grey, where haze falls short of 4.5:1; mist reads at 8:1. */
  .is-scrolled .nav a { color: var(--color-mist); }
  .bar :global(.cta) { min-height: 46px; padding: 0 20px 0 18px; font-size: 0.95rem; }
  .site-header :global(:focus-visible) { outline-color: var(--color-mist); }
  @media (max-width: 899px) { .nav { display: none; } }
  @media (max-width: 639px) {
    .bar { padding-block: 14px; }
    .home { padding: 9px 0; }
    .home :global(.logo-svg) { height: 26px; }
    .bar :global(.cta) { min-height: 44px; padding: 0 16px 0 14px; font-size: 0.9rem; }
  }
</style>
