---
import Emph from './Emph.astro';
import { content } from '../content/site';
interface Props { n: number }
const { n } = Astro.props;
const c = content.compare;
---
<section class="section compare bg-ivory" aria-labelledby="compare-title">
  <div class="wrap">
    <p class="label">{c.eyebrow}<sup>{n}</sup></p>
    <div class="head">
      <h2 id="compare-title"><Emph text={c.h2} /></h2>
      <p class="lede">{c.intro}</p>
    </div>
    <div class="ctable reveal" role="table" aria-label={c.tableLabel}>
      <div class="row thead" role="row">
        <span role="columnheader"><span class="sr-only">{c.colTopic}</span></span>
        <span role="columnheader">{c.colThem}</span>
        <span role="columnheader" class="us-head">{c.colUs}</span>
      </div>
      {c.rows.map((r) => (
        <div class="row" role="row">
          <span role="rowheader" class="topic">{r.topic}</span>
          <span role="cell" class="them"><i class="o" aria-hidden="true"></i>{r.them}</span>
          <span role="cell" class="us"><i class="f" aria-hidden="true"></i>{r.us}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { margin-top: 56px; display: grid; gap: 28px; align-items: end; }
  .head h2 { max-width: 13ch; }
  .ctable { margin-top: 96px; border-top: 1px solid var(--color-text); }
  .row { display: grid; gap: 10px; padding: 24px 0; border-bottom: 1px solid var(--color-line); }
  .thead { display: none; }
  .topic { font-size: var(--text-label); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-muted); }
  .them, .us { display: flex; gap: 14px; align-items: baseline; }
  .them { color: var(--color-muted); }
  .us { font-family: var(--font-display); font-size: clamp(1.35rem, 2vw, 1.7rem); line-height: 1.2; }
  .o, .f { flex: none; width: 9px; height: 9px; display: inline-block; transform: translateY(-1px); }
  .o { border: 1px solid var(--color-muted); }
  .f { background: var(--color-text); }
  @media (min-width: 900px) {
    .head { grid-template-columns: 1.2fr 1fr; }
    .row { grid-template-columns: 1fr 1.2fr 1.6fr; gap: 40px; align-items: baseline; padding: 30px 0; }
    .thead {
      display: grid; padding: 0 0 16px;
      font-size: var(--text-label); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-muted);
    }
    .ctable { border-top: 0; }
    .thead { border-bottom: 1px solid var(--color-text); }
    .us-head { color: var(--color-text); }
  }
</style>
