---
import Emph from './Emph.astro';
import { content } from '../content/site';
const c = content.compare;
---
<section class="section compare on-dark" aria-labelledby="compare-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{c.eyebrow}</span>
      <h2 id="compare-title"><Emph text={c.h2} /></h2>
      <p>{c.intro}</p>
    </div>
    <div class="ctable reveal" role="table" aria-label={c.tableLabel}>
      <div class="row head" role="row">
        <span role="columnheader"><span class="sr-only">{c.colTopic}</span></span>
        <span role="columnheader" class="them">{c.colThem}</span>
        <span role="columnheader" class="us">{c.colUs}</span>
      </div>
      {c.rows.map((r) => (
        <div class="row" role="row">
          <span role="rowheader" class="topic">{r.topic}</span>
          <span role="cell" class="them"><span class="x" aria-hidden="true"></span>{r.them}</span>
          <span role="cell" class="us"><span class="tick" aria-hidden="true"></span>{r.us}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .compare {
    background:
      radial-gradient(45% 60% at 85% 20%, rgb(36 82 122 / 0.45), transparent 70%),
      var(--color-abyss);
  }
  .compare :global(.section-head h2) { color: #fff; }
  .compare :global(.section-head h2 strong) { color: var(--color-pale); }
  .compare :global(.section-head p) { color: var(--color-on-dark); }
  .ctable { margin: 56px auto 0; max-width: 1000px; display: grid; gap: 10px; }
  .row { display: grid; gap: 10px; padding: 18px 20px; border-radius: 16px; background: rgb(255 255 255 / 0.04); border: 1px solid var(--color-line-dark); }
  .row.head { background: none; border: 0; padding-block: 0; display: none; }
  .topic { font-family: var(--font-display); font-weight: 600; color: #fff; }
  .them, .us { display: flex; gap: 12px; align-items: flex-start; }
  .them { color: var(--color-on-dark); }
  .us { color: #fff; font-weight: 500; }
  .head .them, .head .us { font-family: var(--font-display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; }
  .head .us { color: var(--color-pale); }
  .x, .tick { flex: none; width: 20px; height: 20px; border-radius: 50%; margin-top: 2px; position: relative; }
  .x { background: rgb(255 255 255 / 0.08); }
  .x::before, .x::after { content: ''; position: absolute; left: 5px; top: 9px; width: 10px; height: 1.6px; background: rgb(255 255 255 / 0.5); transform: rotate(45deg); }
  .x::after { transform: rotate(-45deg); }
  .tick { background: var(--color-coral); }
  .tick::after { content: ''; position: absolute; left: 7px; top: 4px; width: 5px; height: 9px; border: solid var(--color-abyss); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  @media (min-width: 800px) {
    .row { grid-template-columns: 1fr 1.3fr 1.3fr; align-items: center; gap: 24px; padding: 22px 28px; }
    .row.head { display: grid; }
  }
</style>
