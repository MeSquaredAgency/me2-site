---
import Emph from './Emph.astro';
import EmailLink from './EmailLink.astro';
import { fill } from '../config';
import { content } from '../content/site';
import { visibleFaq } from '../lib/faq';
interface Props { n: number }
const { n } = Astro.props;
const c = content.faq;
const items = visibleFaq();
---
<section id="faq" class="section bg-ivory" aria-labelledby="faq-title">
  <div class="wrap">
    <p class="label">{c.eyebrow}<sup>{n}</sup></p>
    <div class="layout">
      <div class="head">
        <h2 id="faq-title"><Emph text={c.h2} /></h2>
        <p class="aside">{c.aside}</p>
        <EmailLink subject={content.ui.subjects.general} class="tlink ask">{c.asideButton}</EmailLink>
      </div>
      <div class="items">
        {items.map((item) => (
          <details>
            <summary>
              <span class="q">{item.q}</span>
              <span class="toggle" aria-hidden="true"></span>
            </summary>
            <p>{fill(item.a)}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .layout { margin-top: 56px; display: grid; gap: 56px; }
  .head { display: grid; gap: 24px; align-content: start; justify-items: start; }
  .head h2 { max-width: 9ch; }
  .aside { color: var(--color-muted); max-width: 30ch; }
  .head :global(.ask) { font-weight: 500; }
  .items { border-top: 1px solid var(--color-text); }
  details { border-bottom: 1px solid var(--color-line); }
  summary {
    list-style: none; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 28px 0; min-height: 44px;
    font-family: var(--font-display); font-size: clamp(1.4rem, 2.1vw, 1.85rem); line-height: 1.2;
  }
  summary::-webkit-details-marker { display: none; }
  .toggle { position: relative; flex: none; width: 18px; height: 18px; }
  .toggle::before, .toggle::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 18px; height: 1px; background: var(--color-text);
    transition: transform 400ms var(--ease);
  }
  .toggle::after { transform: rotate(90deg); }
  details[open] .toggle::after { transform: rotate(0deg); }
  details p { padding: 0 0 30px; color: var(--color-muted); max-width: 58ch; font-size: 1.05rem; }
  @media (prefers-reduced-motion: reduce) { .toggle::before, .toggle::after { transition: none; } }
  @media (min-width: 1000px) {
    .layout { grid-template-columns: 1fr 1.6fr; gap: 120px; }
    .head { position: sticky; top: 120px; align-self: start; }
  }
</style>
