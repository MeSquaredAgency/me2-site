---
import EnquireLink from './EnquireLink.astro';
import { fill } from '../config';
import { content } from '../content/site';
import { visibleFaq } from '../lib/faq';
const c = content.faq;
const items = visibleFaq();
---
<section id="faq" class="faq on-paper render-later" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div class="side">
      <p class="kicker">{c.kicker}</p>
      <h2 id="faq-title">{c.h2}</h2>
      <p class="aside">{c.aside.split(/(?<=[.?!])\s+/).map((s, i) => <>{i > 0 && ' '}<span>{s}</span></>)}</p>
      <EnquireLink source="questions" class="btn btn-dark"><span class="dot" aria-hidden="true"></span>{c.asideButton}</EnquireLink>
    </div>
    <div class="list">
      {items.map((item) => (
        <details>
          <summary><span class="q">{fill(item.q)}</span><span class="pm" aria-hidden="true"></span></summary>
          <p class="a">{fill(item.a)}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-block: var(--section-y); }
  .grid { display: grid; gap: 56px; }
  .side { display: grid; gap: 24px; align-content: start; justify-items: start; }
  .aside { color: var(--color-slate); max-width: 30ch; font-size: 1.08rem; }
  /* Each sentence wraps as a whole where it can ("Ask us directly." never splits after "Ask"). */
  .aside span { display: inline-block; }
  .list { border-top: 1px solid var(--color-ink); }
  details { border-bottom: 1px solid var(--color-line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    min-height: 44px; padding: 26px 0;
  }
  summary::-webkit-details-marker { display: none; }
  .q { font-size: clamp(1.2rem, 1.6vw, 1.55rem); font-weight: 520; letter-spacing: -0.02em; line-height: 1.25; }
  /* Plus that turns into a minus. */
  .pm { position: relative; width: 16px; height: 16px; flex: none; }
  .pm::before, .pm::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; margin-top: -0.75px; background: currentColor; transition: transform 400ms var(--ease-out); }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm::after { transform: rotate(0deg); }
  .a { padding: 0 0 30px; max-width: 60ch; color: var(--color-slate); font-size: 1.08rem; }
  @media (hover: hover) and (pointer: fine) { summary:hover .q { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; } }
  @media (min-width: 1000px) {
    .grid { grid-template-columns: 1fr 1.5fr; column-gap: clamp(48px, 6vw, 112px); }
    .side { position: sticky; top: 120px; align-self: start; }
  }
</style>
