---
import { content } from '../content/site';
const c = content.how;
---
<section id="how" class="how on-dark render-later" aria-labelledby="how-title">
  <div class="wrap">
    <div class="head">
      <p class="kicker">{c.kicker}</p>
      <h2 id="how-title">{c.h2}</h2>
    </div>
    <ul class="items">
      {c.items.map((it) => (
        <li class="item">
          <h3 class="title">{it.title}</h3>
          <p class="body">{it.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .how {
    padding-block: var(--section-y);
    background:
      radial-gradient(50% 60% at 100% 0%, rgb(var(--glow) / 0.08), transparent 70%),
      var(--color-abyss);
  }
  .head { display: grid; gap: 28px; margin-bottom: clamp(56px, 7vw, 104px); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--color-line-dark); }
  .item { display: grid; gap: 14px; padding: 36px 0 44px; border-bottom: 1px solid var(--color-line-dark); }
  .title { font-size: clamp(1.6rem, 2.6vw, 2.6rem); font-weight: 520; font-stretch: 90%; letter-spacing: -0.035em; line-height: 1.05; max-width: 18ch; }
  .body { color: var(--color-haze); max-width: 44ch; font-size: 1.08rem; }
  @media (min-width: 1000px) {
    .head { grid-template-columns: 1fr 2.4fr; align-items: start; }
    .head .kicker { margin-top: 0.9em; }
    .items { grid-template-columns: 1fr 1fr; column-gap: clamp(48px, 6vw, 112px); }
    .item { padding: 44px 0 56px; }
  }
</style>
