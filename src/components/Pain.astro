---
import { fill } from '../config';
import { content } from '../content/site';
const c = content.pain;
// "Finance · owned by Me²" → what is picked up, and by whom (two lines on desktop).
const stamp = (text: string) => { const [what, who] = fill(text).split(' · '); return { what, who }; };
---
<!--
  Where your week goes: four pains, one per row. As each row settles on screen it lights up and is
  "picked up": its square goes outline → half → solid coral (the Command Centre board's stages) and the stamp appears.
  Without JavaScript or with reduced motion, everything is shown, stamps already landed.
-->
<section class="pain on-dark" aria-labelledby="pain-title" data-pain>
  <div class="wrap">
    <h2 id="pain-title" class="kicker">{c.label}</h2>
    <ol class="rows">
      {c.rows.map((r) => (
        <li class="row" data-pain-row>
          <p class="line">{r.line}</p>
          <p class="cost">{r.cost}</p>
          <p class="stamp"><span class="sq" aria-hidden="true"></span><span class="stamp-text"><span class="what">{stamp(r.stamp).what}</span><span class="sep"> · </span><span class="who">{stamp(r.stamp).who}</span></span></p>
        </li>
      ))}
    </ol>
    <div class="turn">
      <p class="turn-line">{fill(c.turn)}</p>
      <p class="lede turn-body">{c.turnBody}</p>
      <a href="#services" class="tlink">{c.link}</a>
    </div>
  </div>
</section>

<script>
  // Rows only dim once the visitor scrolls toward the section, so nobody (and no checker) meets faint text they aren't
  // scrolling to. Rows already on screen at that moment are left lit and stamped; the rest light up as they rise into view.
  const el = document.querySelector<HTMLElement>('[data-pain]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rows = [...el.querySelectorAll<HTMLElement>('[data-pain-row]')];
    // A row lights as its line reaches the middle of the screen.
    const lightUp = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.closest('[data-pain-row]')!.classList.add('is-on'); lightUp.unobserve(e.target); }
    }, { rootMargin: '0px 0px -50% 0px' });
    const start = () => {
      removeEventListener('scroll', start);
      rows.forEach((r) => { if (r.getBoundingClientRect().top < innerHeight) r.classList.add('is-on', 'is-early'); });
      el.classList.add('is-live');
      rows.forEach((r) => { if (!r.classList.contains('is-on')) lightUp.observe(r.querySelector('.line')!); });
    };
    const near = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      near.disconnect();
      addEventListener('scroll', start, { passive: true });
    }, { rootMargin: '0px 0px 15% 0px' });
    near.observe(el);
  }
</script>

<style>
  .pain { padding-block: clamp(110px, 16vh, 200px) clamp(96px, 14vh, 180px); border-top: 1px solid var(--color-line-dark); }
  /* An h2 for screen readers, set like every other section label. */
  .kicker { margin-bottom: clamp(24px, 4vw, 48px); font-stretch: 100%; line-height: 1.6; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: grid; justify-items: start; gap: 18px; padding-block: clamp(44px, 8vh, 88px); border-top: 1px solid var(--color-line-dark); }
  .line {
    font-size: clamp(2.1rem, 5.2vw, 5.4rem); font-weight: 520; font-stretch: 88%;
    letter-spacing: -0.045em; line-height: 1; max-width: 17ch; color: var(--color-mist); text-wrap: balance;
  }
  .cost { max-width: 52ch; font-size: clamp(1.05rem, 1.4vw, 1.3rem); line-height: 1.55; color: var(--color-haze); }
  /* The stamp: what is picked up, and by whom underneath (so a long one never breaks at the dot), the square on its first line. */
  .stamp { display: inline-flex; align-items: flex-start; gap: 12px; margin-top: 8px; font-weight: 560; line-height: 1.3; color: var(--color-mist); }
  .stamp .what, .stamp .who { display: block; }
  .stamp .sep { display: none; }
  .stamp .who { white-space: nowrap; color: var(--color-haze); font-weight: 500; }
  .sq { width: 14px; height: 14px; flex: none; margin-top: calc(0.65em - 7px); box-sizing: border-box; background: var(--color-coral); box-shadow: 0 0 20px 3px rgb(var(--glow) / 0.5); }
  .turn { display: grid; justify-items: start; gap: 22px; padding-top: clamp(64px, 10vh, 120px); border-top: 1px solid var(--color-line-dark); }
  .turn-line {
    font-size: clamp(2.4rem, 6vw, 6.2rem); font-weight: 540; font-stretch: 88%;
    letter-spacing: -0.05em; line-height: 0.98; max-width: 14ch; color: var(--color-mist); text-wrap: balance;
  }
  .turn-body { max-width: 46ch; }

  /* Desktop: the pain on the left, the stamp landing opposite it. */
  @media (min-width: 1000px) {
    .row {
      min-height: 62vh; align-content: center; column-gap: clamp(40px, 5vw, 96px);
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); grid-template-areas: 'line stamp' 'cost stamp';
    }
    .line { grid-area: line; }
    .cost { grid-area: cost; }
    .stamp { grid-area: stamp; align-self: center; margin-top: 0; gap: 16px; font-size: clamp(1.1rem, 1.5vw, 1.4rem); }
    .stamp .sq { width: 18px; height: 18px; margin-top: calc(0.65em - 9px); }
  }

  /* Motion: a row is faint until it reaches the upper part of the screen, then lights and is picked up. */
  .is-live .line, .is-live .cost { opacity: 0.18; transform: translateY(24px); transition: opacity 700ms var(--ease), transform 900ms var(--ease-out); }
  .is-live .row.is-on .line, .is-live .row.is-on .cost { opacity: 1; transform: none; }
  .is-live .row.is-on .cost { transition-delay: 150ms; }
  .is-live .sq { background: transparent; border: 1.5px dashed rgb(232 237 241 / 0.5); box-shadow: none; }
  .is-live .row.is-on .sq { animation: pick 1000ms var(--ease-out) 500ms forwards; }
  .is-live .stamp-text { opacity: 0; transition: opacity 600ms var(--ease) 1100ms; }
  .is-live .row.is-on .stamp-text { opacity: 1; }
  /* Already on screen when the motion started: stays as it was, no replay. */
  .is-live .row.is-early .sq { animation: none; border: 0; background: var(--color-coral); box-shadow: 0 0 20px 3px rgb(var(--glow) / 0.5); }
  .is-live .row.is-early .stamp-text, .is-live .row.is-early .line, .is-live .row.is-early .cost { transition: none; }
  @keyframes pick {
    45% { border-style: solid; border-color: var(--color-coral); background: linear-gradient(0deg, var(--color-coral) 50%, transparent 50%); }
    100% { border-style: solid; border-color: var(--color-coral); background: var(--color-coral); box-shadow: 0 0 20px 3px rgb(var(--glow) / 0.5); }
  }
</style>
