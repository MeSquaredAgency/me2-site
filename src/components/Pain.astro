---
import { fill } from '../config';
import { content } from '../content/site';
const c = content.pain;
// "Finance · owned by Me²" → what is picked up, and by whom (two lines on desktop).
const stamp = (text: string) => { const [what, who] = fill(text).split(' · '); return { what, who }; };
const stamps = c.rows.map((r) => stamp(r.stamp));
// The board's header reuses the hero's person: the same Me² person who messaged you is the one picking these up.
const person = fill(content.hero.chat.who);
---
<!--
  Where your week goes: five pains, one per row. As each row settles on screen it lights up and is
  "picked up": its square goes outline → half → solid coral (the Command Centre board's stages) and the stamp appears.
  On wide screens the stamps gather on a board that stays beside the rows as they scroll (your Me² person's board
  for the week), so the right half of the screen is never empty; on narrower screens each row carries its own stamp.
  Without JavaScript or with reduced motion, everything is shown, stamps already landed.
-->
<section class="pain on-dark" aria-labelledby="pain-title" data-pain>
  <div class="wrap">
    <h2 id="pain-title" class="kicker">{c.label}</h2>
    <div class="stage">
      <ol class="rows">
        {c.rows.map((r, i) => (
          <li class="row" data-pain-row>
            <p class="line">{r.line}</p>
            <p class="cost">{r.cost}</p>
            <p class="stamp"><span class="sq" aria-hidden="true"></span><span class="stamp-text"><span class="what">{stamps[i].what}</span><span class="sep"> · </span><span class="who">{stamps[i].who}</span></span></p>
          </li>
        ))}
      </ol>
      <div class="turn">
        <p class="turn-line">{fill(c.turn)}</p>
        <p class="lede turn-body">{c.turnBody}</p>
        <a href="#services" class="tlink">{c.link}</a>
      </div>
      <!-- The board repeats the stamps for the eye only; screen readers get each row's own stamp. -->
      <aside class="board-col" aria-hidden="true" data-markdown="skip">
        <div class="board" data-pain-board>
          <div class="board-top">
            <span class="avatar"><span class="avatar-sq"></span></span>
            <span class="board-who"><span class="board-name">{person}</span><span class="board-role">{c.label}</span></span>
          </div>
          <span class="rail">{stamps.map(() => <i data-pain-rail></i>)}</span>
          <ol class="items">
            {stamps.map((s) => (
              <li class="item" data-pain-item>
                <span class="item-sq"></span>
                <span class="item-text"><span class="item-what">{s.what}</span><span class="item-who">{s.who}</span></span>
              </li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  // Rows only dim once the visitor scrolls toward the section, so nobody (and no checker) meets faint text they aren't
  // scrolling to. Rows already on screen at that moment are left lit and stamped; the rest light up as they rise into view.
  // The board's items light with their rows.
  const el = document.querySelector<HTMLElement>('[data-pain]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rows = [...el.querySelectorAll<HTMLElement>('[data-pain-row]')];
    const items = [...el.querySelectorAll<HTMLElement>('[data-pain-item]')];
    const rail = [...el.querySelectorAll<HTMLElement>('[data-pain-rail]')];
    const light = (row: HTMLElement, ...cls: string[]) => {
      row.classList.add(...cls);
      items[rows.indexOf(row)]?.classList.add(...cls);
      rail[rows.indexOf(row)]?.classList.add(...cls);
    };
    // A row lights as its line reaches the middle of the screen.
    const lightUp = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { light(e.target.closest<HTMLElement>('[data-pain-row]')!, 'is-on'); lightUp.unobserve(e.target); }
    }, { rootMargin: '0px 0px -50% 0px' });
    const start = () => {
      removeEventListener('scroll', start);
      rows.forEach((r) => { if (r.getBoundingClientRect().top < innerHeight) light(r, 'is-on', 'is-early'); });
      el.classList.add('is-live');
      rows.forEach((r) => { if (!r.classList.contains('is-on')) lightUp.observe(r.querySelector('.line')!); });
    };
    const near = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      near.disconnect();
      addEventListener('scroll', start, { passive: true });
    }, { rootMargin: '0px 0px 15% 0px' });
    near.observe(el);
  }
</script>

<style>
  .pain { padding-block: clamp(96px, 14vh, 176px) clamp(96px, 14vh, 180px); border-top: 1px solid var(--color-line-dark); }
  /* An h2 for screen readers, set like every other section label. */
  .kicker { margin-bottom: clamp(24px, 4vw, 48px); font-stretch: 100%; line-height: 1.6; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: grid; justify-items: start; gap: 18px; padding-block: clamp(44px, 8vh, 88px); border-top: 1px solid var(--color-line-dark); }
  .line {
    font-size: clamp(2.1rem, 5.2vw, 5.4rem); font-weight: 520; font-stretch: 88%;
    letter-spacing: -0.045em; line-height: 1; max-width: 17ch; color: var(--color-mist); text-wrap: balance;
  }
  .cost { max-width: 52ch; font-size: clamp(1.05rem, 1.4vw, 1.3rem); line-height: 1.55; color: var(--color-haze); }
  /* The stamp: what is picked up, and by whom underneath (so a long one never breaks at the dot), the square on its first line. */
  .stamp { display: inline-flex; align-items: flex-start; gap: 12px; margin-top: 8px; font-weight: 560; line-height: 1.3; color: var(--color-mist); }
  .stamp .what, .stamp .who { display: block; }
  .stamp .sep { display: none; }
  .stamp .who { white-space: nowrap; color: var(--color-haze); font-weight: 500; }
  .sq { width: 14px; height: 14px; flex: none; margin-top: calc(0.65em - 7px); box-sizing: border-box; background: var(--color-coral); box-shadow: 0 0 20px 3px rgb(var(--glow) / 0.5); }
  .turn { display: grid; justify-items: start; gap: 22px; padding-top: clamp(56px, 8vh, 104px); border-top: 1px solid var(--color-line-dark); }
  .turn-line {
    font-size: clamp(2.4rem, 6vw, 6.2rem); font-weight: 540; font-stretch: 88%;
    letter-spacing: -0.05em; line-height: 0.98; max-width: 14ch; color: var(--color-mist); text-wrap: balance;
  }
  .turn-body { max-width: 46ch; }

  /* The board only exists on wide screens. */
  .board-col { display: none; }

  /* Desktop: the pains on the left; the board stays beside them, collecting each one as it is picked up. */
  @media (min-width: 1000px) {
    .stage { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(300px, 0.9fr); grid-template-rows: auto auto; column-gap: clamp(40px, 5vw, 96px); align-items: start; }
    .rows { grid-column: 1; }
    .turn { grid-column: 1; }
    .board-col { grid-column: 2; grid-row: 1 / span 2; }
    .row { min-height: 52vh; align-content: center; padding-block: clamp(32px, 5vh, 56px); }
    .rows .row:first-child { border-top: 0; }
    /* Each row's own stamp stays for screen readers; the eye reads it on the board. */
    .stamp { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .board-col { display: block; position: sticky; top: max(88px, calc(50vh - 260px)); align-self: start; padding-top: 12px; }
    .board {
      position: relative; border-radius: 18px; padding: clamp(20px, 2vw, 28px);
      background: linear-gradient(160deg, rgb(16 32 47 / 0.92), rgb(18 29 40 / 0.92));
      box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.7), inset 0 1px 0 rgb(244 239 231 / 0.09), inset 0 0 0 1px rgb(244 239 231 / 0.06);
    }
    .board-top { display: flex; align-items: center; gap: 12px; padding: 2px 2px 16px; }
    /* The rail: one small square per item, each lit as the item is picked up. */
    .rail { display: grid; grid-auto-flow: column; gap: 6px; padding-bottom: 16px; border-bottom: 1px solid var(--color-line-dark); }
    .rail i { display: block; height: 3px; background: var(--color-coral); box-shadow: 0 0 10px 1px rgb(var(--glow) / 0.4); }
    .avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--color-navy); display: grid; place-items: center; flex: none; box-shadow: inset 0 0 0 1px rgb(244 239 231 / 0.08); }
    .avatar-sq { width: 10px; height: 10px; background: var(--color-coral); box-shadow: 0 0 14px 2px rgb(var(--glow) / 0.5); }
    .board-who { display: grid; gap: 2px; }
    .board-name { font-weight: 600; font-size: 0.98rem; letter-spacing: -0.005em; color: var(--color-mist); }
    .board-role { font-size: 0.82rem; color: var(--color-haze); }
    .items { list-style: none; margin: 0; padding: 0; display: grid; }
    .item { display: flex; align-items: flex-start; gap: 16px; padding: 18px 2px; border-bottom: 1px solid var(--color-line-dark); }
    .item:last-child { border-bottom: 0; padding-bottom: 6px; }
    .item-sq { width: 16px; height: 16px; flex: none; margin-top: 3px; box-sizing: border-box; background: var(--color-coral); box-shadow: 0 0 18px 3px rgb(var(--glow) / 0.5); }
    .item-text { display: grid; gap: 2px; min-width: 0; }
    .item-what { font-weight: 560; font-size: 1.05rem; line-height: 1.3; letter-spacing: -0.01em; color: var(--color-mist); }
    .item-who { font-size: 0.9rem; line-height: 1.3; color: var(--color-haze); }
  }

  /* Motion: a row is faint until it reaches the upper part of the screen, then lights and is picked up. */
  .is-live .line, .is-live .cost { opacity: 0.18; transform: translateY(24px); transition: opacity 700ms var(--ease), transform 900ms var(--ease-out); }
  .is-live .row.is-on .line, .is-live .row.is-on .cost { opacity: 1; transform: none; }
  .is-live .row.is-on .cost { transition-delay: 150ms; }
  .is-live .sq { background: transparent; border: 1.5px dashed rgb(244 239 231 / 0.5); box-shadow: none; }
  .is-live .row.is-on .sq { animation: pick 1000ms var(--ease-out) 500ms forwards; }
  .is-live .stamp-text { opacity: 0; transition: opacity 600ms var(--ease) 1100ms; }
  .is-live .row.is-on .stamp-text { opacity: 1; }
  /* Already on screen when the motion started: stays as it was, no replay. */
  .is-live .row.is-early .sq { animation: none; border: 0; background: var(--color-coral); box-shadow: 0 0 20px 3px rgb(var(--glow) / 0.5); }
  .is-live .row.is-early .stamp-text, .is-live .row.is-early .line, .is-live .row.is-early .cost { transition: none; }
  @keyframes pick {
    45% { border-style: solid; border-color: var(--color-coral); background: linear-gradient(0deg, var(--color-coral) 50%, transparent 50%); }
    100% { border-style: solid; border-color: var(--color-coral); background: var(--color-coral); box-shadow: 0 0 20px 3px rgb(var(--glow) / 0.5); }
  }
  /* The board: an item waits (dashed outline, dim) until its row lights, then is picked up the same way. */
  .is-live .rail i { background: rgb(244 239 231 / 0.12); box-shadow: none; transition: background-color 500ms var(--ease) 900ms, box-shadow 500ms var(--ease) 900ms; }
  .is-live .rail i.is-on { background: var(--color-coral); box-shadow: 0 0 10px 1px rgb(var(--glow) / 0.4); }
  .is-live .rail i.is-early { transition: none; }
  .is-live .item-sq { background: transparent; border: 1.5px dashed rgb(244 239 231 / 0.4); box-shadow: none; }
  .is-live .item-what { color: var(--color-haze); transition: color 600ms var(--ease) 500ms; }
  .is-live .item-who { opacity: 0; transform: translateY(4px); transition: opacity 600ms var(--ease) 1100ms, transform 600ms var(--ease-out) 1100ms; }
  .is-live .item.is-on .item-sq { animation: pick 1000ms var(--ease-out) 500ms forwards; }
  .is-live .item.is-on .item-what { color: var(--color-mist); }
  .is-live .item.is-on .item-who { opacity: 1; transform: none; }
  .is-live .item.is-early .item-sq { animation: none; border: 0; background: var(--color-coral); box-shadow: 0 0 18px 3px rgb(var(--glow) / 0.5); }
  .is-live .item.is-early .item-what, .is-live .item.is-early .item-who { transition: none; }
</style>
