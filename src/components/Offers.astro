---
import Emph from './Emph.astro';
import EmailLink from './EmailLink.astro';
import { fixtureText, flags } from '../config';
import { content } from '../content/site';
interface Props { n: number }
const { n } = Astro.props;
const c = content.offers;
---
<section id="offers" class="section offers bg-bone render-later" aria-labelledby="offers-title">
  <div class="wrap">
    <p class="label">{c.eyebrow}<sup>{n}</sup></p>
    <div class="head">
      <h2 id="offers-title"><Emph text={c.h2} /></h2>
      <p class="lede">{c.intro}</p>
    </div>
    <div class="cards">
      {c.cards.map((card, i) => (
        <article class="card reveal" style={`--d:${i}`} aria-labelledby={`offer-${card.key}`}>
          <p class="tier" aria-hidden="true">{i === 0 ? 'I' : 'II'}</p>
          <h3 id={`offer-${card.key}`}>{card.name}</h3>
          <p class="body">{card.body}</p>
          <p class="best">{card.bestFor}</p>
          {flags.showPricing && <p class="price">{fixtureText.price ?? card.price}</p>}
          <EmailLink subject={content.ui.subjects[card.key]} class="btn btn-line">{card.button}</EmailLink>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head { margin-top: 56px; display: grid; gap: 28px; align-items: end; }
  .head h2 { max-width: 10ch; }
  .cards { margin-top: 96px; display: grid; border-top: 1px solid var(--color-text); }
  .card { display: flex; flex-direction: column; gap: 22px; align-items: flex-start; padding: 48px 0 56px; border-bottom: 1px solid var(--color-line); }
  .tier { font-family: var(--font-display); font-style: italic; font-size: 1.4rem; color: var(--color-coral-deep); }
  h3 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.4rem, 4.2vw, 3.6rem); line-height: 1; letter-spacing: -0.015em; }
  .body { font-size: 1.12rem; color: var(--color-muted); max-width: 38ch; }
  .best { margin-top: auto; padding-top: 12px; font-weight: 500; max-width: 38ch; }
  .price { font-family: var(--font-display); font-size: 1.5rem; }
  @media (min-width: 900px) {
    .head { grid-template-columns: 1.2fr 1fr; }
    .cards { grid-template-columns: 1fr 1fr; }
    .card { padding: 56px 64px 64px 0; border-bottom: 0; }
    .card + .card { padding-left: 64px; border-left: 1px solid var(--color-line); }
  }
</style>
