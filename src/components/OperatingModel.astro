---
import Emph from './Emph.astro';
import Icon, { type IconName } from './Icon.astro';
import { fill } from '../config';
import { content } from '../content/site';
const c = content.model;
const icons: IconName[] = ['spark', 'person', 'report', 'check'];
---
<section id="how" class="section model" aria-labelledby="how-title">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="eyebrow">{c.eyebrow}</span>
        <h2 id="how-title"><Emph text={c.h2} /></h2>
      </div>
      <p class="intro">{c.intro}</p>
    </div>

    <ul class="parts">
      {c.parts.map((p, i) => (
        <li class="part reveal" style={`--d:${i}`}>
          <span class="op" aria-hidden="true">{i === 0 ? '' : '+'}</span>
          <span class="well"><Icon name={icons[i]} size={24} /></span>
          <h3>{p.title}</h3>
          <p>{fill(p.body)}</p>
        </li>
      ))}
    </ul>

    <p class="rule reveal"><span class="quote" aria-hidden="true">“</span>{c.rule}</p>

    <div class="steps-wrap">
      <h3 class="steps-title">{c.stepsTitle}</h3>
      <ol class="steps">
        {c.steps.map((s, i) => (
          <li class="step reveal" style={`--d:${i % 4}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h4>{s.title}</h4>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .model { background: #fff; }
  .head { display: grid; gap: 24px; align-items: end; }
  .head h2 { color: var(--color-text); max-width: 14ch; font-size: clamp(2.2rem, 4.6vw, 3.8rem); line-height: 1.04; }
  .head h2 :global(strong) { color: var(--color-navy); }
  .intro { color: var(--color-muted); font-size: 1.125rem; max-width: 44ch; }

  .parts { list-style: none; margin: 64px 0 0; padding: 0; display: grid; gap: 16px; }
  .part {
    position: relative; padding: 30px 26px 30px;
    border-radius: var(--radius-lg); background: var(--color-mist);
    display: grid; gap: 10px; align-content: start;
  }
  .part:nth-child(2) { background: var(--color-abyss); color: #fff; }
  .part:nth-child(2) p { color: var(--color-on-dark); }
  .part:nth-child(2) .well { background: rgb(231 120 92 / 0.16); color: #f4b9a9; }
  .op {
    position: absolute; left: -26px; top: 56px; transform: translateY(-50%);
    width: 28px; height: 28px; border-radius: 50%; display: none; place-items: center;
    background: #fff; color: var(--color-navy); font-weight: 600; box-shadow: var(--shadow-card);
    font-family: var(--font-display);
  }
  .well { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: #fff; color: var(--color-navy); margin-bottom: 8px; }
  h3 { font-size: 1.35rem; color: inherit; }
  .part p { color: var(--color-muted); }

  .rule {
    margin: 72px auto 0; max-width: 20ch; text-align: center;
    font-family: var(--font-display); font-weight: 300; letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 3.8rem); line-height: 1.08; color: var(--color-text); position: relative;
  }
  .quote { display: block; color: var(--color-coral); font-weight: 600; font-size: 1.4em; line-height: 0.6; margin-bottom: 8px; }

  .steps-wrap { margin-top: 96px; }
  .steps-title { font-size: clamp(1.4rem, 2.2vw, 1.8rem); color: var(--color-text); font-weight: 600; }
  .steps { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); border-radius: var(--radius-lg); overflow: hidden; }
  .step { background: #fff; padding: 26px 24px 28px; display: grid; gap: 8px; align-content: start; transition: background 200ms ease; }
  .num { font-family: var(--font-display); font-weight: 600; font-size: 0.85rem; color: var(--color-coral-deep, #b9482d); letter-spacing: 0.08em; }
  h4 { margin: 0; font-family: var(--font-display); font-size: 1.12rem; font-weight: 600; color: var(--color-text); }
  .step p { color: var(--color-muted); font-size: 0.97rem; }
  @media (hover: hover) and (pointer: fine) { .step:hover { background: var(--color-mist); } }

  @media (min-width: 700px) {
    .parts { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1000px) {
    .head { grid-template-columns: 1.2fr 1fr; }
    .parts { grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .op { display: grid; }
    .steps { grid-template-columns: repeat(4, 1fr); }
  }
</style>
