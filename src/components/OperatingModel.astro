---
import Emph from './Emph.astro';
import { fill } from '../config';
import { content } from '../content/site';
interface Props { n: number }
const { n } = Astro.props;
const c = content.model;
---
<section id="how" class="section model bg-bone" aria-labelledby="how-title">
  <div class="wrap">
    <p class="label">{c.eyebrow}<sup>{n}</sup></p>
    <div class="head">
      <h2 id="how-title"><Emph text={c.h2} /></h2>
      <p class="lede">{c.intro}</p>
    </div>

    <!-- AI + judgement + process + checks: read across like a sum. -->
    <ol class="parts">
      {c.parts.map((p, i) => (
        <li class="part reveal" style={`--d:${i}`}>
          <span class="sign" aria-hidden="true">{i === 0 ? '' : '+'}</span>
          <h3>{p.title}</h3>
          <p>{fill(p.body)}</p>
        </li>
      ))}
    </ol>

    <div class="steps-wrap">
      <h3 class="steps-title">{c.stepsTitle}</h3>
      <ol class="steps">
        {c.steps.map((s, i) => (
          <li class="step reveal" style={`--d:${i % 2}`}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h4>{s.title}</h4>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .head { margin-top: 56px; display: grid; gap: 28px; align-items: end; }
  .head h2 { max-width: 12ch; }

  .parts { list-style: none; margin: 96px 0 0; padding: 0; display: grid; border-top: 1px solid var(--color-text); }
  .part { position: relative; padding: 32px 0 40px; border-bottom: 1px solid var(--color-line); display: grid; gap: 14px; align-content: start; }
  .sign { display: none; }
  .part h3 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 3vw, 2.6rem); line-height: 1; letter-spacing: -0.01em; }
  .part:nth-child(2) h3 { font-style: italic; }
  .part p { color: var(--color-muted); max-width: 34ch; }

  .steps-wrap { margin-top: 140px; display: grid; gap: 40px; }
  .steps-title { font-size: var(--text-label); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-muted); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; column-gap: 72px; border-top: 1px solid var(--color-text); }
  .step { display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding: 26px 0; border-bottom: 1px solid var(--color-line); }
  .num { font-family: var(--font-display); font-style: italic; font-size: 1.5rem; line-height: 1.1; color: var(--color-coral-deep); }
  h4 { font-size: 1.08rem; font-weight: 600; }
  .step p { color: var(--color-muted); margin-top: 4px; }

  @media (min-width: 1000px) {
    .head { grid-template-columns: 1.2fr 1fr; }
    .parts { grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--color-line); }
    .part { padding: 40px 36px 48px 0; border-bottom: 0; }
    .part + .part { padding-left: 36px; border-left: 1px solid var(--color-line); }
    .sign {
      display: grid; place-items: center; position: absolute; left: -14px; top: -14px;
      width: 28px; height: 28px; background: var(--color-bone);
      font-family: var(--font-display); font-size: 1.6rem; line-height: 1; color: var(--color-text);
    }
    .part:first-child .sign { display: none; }
    .steps-wrap { grid-template-columns: 1fr 3fr; }
    .steps { grid-template-columns: 1fr 1fr; }
  }
</style>
