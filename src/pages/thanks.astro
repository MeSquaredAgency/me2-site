---
// Where the enquiry form lands once the enquiry has been emailed (worker/index.ts), with or without JavaScript. noindex.
// Its address is the Google Ads "contact received" page, so nothing else links here.
// "What happens next" plays once: each step's square lights, then a coral light runs the line to the next (CSS only;
// with reduced motion it shows the finished state).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../content/site';
const c = content.thanks;
---
<Base path="/thanks/">
  <Header tone="paper" />
  <main id="main" class="done on-paper">
    <div class="wrap inner">
      <span class="sq" aria-hidden="true"></span>
      <h1>{c.h1}</h1>
      <p class="lede">{c.body}</p>
      <section class="next" aria-labelledby="next-h">
        <h2 id="next-h">{c.nextHeading}</h2>
        <ol class="steps">
          {c.next.map((s, i) => (
            <li style={`--i: ${i}`}>
              <span class="node" aria-hidden="true"></span>
              {i < c.next.length - 1 && <span class="seg" aria-hidden="true"><span class="run"></span></span>}
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </section>
      <a href="/" class="btn btn-dark btn-lg"><span class="dot" aria-hidden="true"></span>{c.button}</a>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .done { min-height: 72vh; display: flex; align-items: center; }
  .inner { display: grid; justify-items: start; gap: 24px; padding-top: 160px; padding-bottom: 120px; }
  h1 { font-size: clamp(3rem, 8vw, 7rem); line-height: 0.9; letter-spacing: -0.05em; }
  .lede { color: var(--color-slate); font-size: 1.2rem; }
  .sq { width: 16px; height: 16px; background: var(--color-coral-deep); }
  .btn-lg { min-height: 58px; margin-top: 12px; }

  /* What happens next: three steps in a row (a column on phones), joined by a line from square to square. */
  .next { width: 100%; max-width: 1080px; margin: 32px 0 16px; display: grid; gap: 28px; }
  h2 { font-size: 1.05rem; font-weight: 560; letter-spacing: -0.01em; color: var(--color-slate); }
  .steps {
    --gap: 40px; --node: 14px;
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap);
  }
  .steps li { position: relative; display: grid; gap: 10px; align-content: start; --t: calc(0.5s + var(--i) * 1.2s); }
  h3 { font-size: clamp(1.3rem, 2vw, 1.6rem); font-weight: 560; letter-spacing: -0.03em; line-height: 1.15; margin-top: 14px; }
  .steps p { color: var(--color-slate); font-size: 1rem; line-height: 1.5; max-width: 30ch; }
  .node { display: block; width: var(--node); height: var(--node); background: var(--color-coral-deep); position: relative; z-index: 1; }
  .steps li:last-child .node { background: var(--color-coral); box-shadow: 0 0 18px 5px rgb(var(--glow) / 0.45); }
  .seg {
    position: absolute; top: calc(var(--node) / 2 - 0.75px); left: var(--node); height: 1.5px;
    width: calc(100% + var(--gap) - var(--node)); background: var(--color-line);
  }
  .run { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: var(--color-coral-deep); }
  /* The light at the head of the line. */
  .run::after {
    content: ''; position: absolute; right: 0; top: 50%; width: 10px; height: 10px; translate: 50% -50%;
    background: var(--color-coral); box-shadow: 0 0 16px 5px rgb(var(--glow) / 0.5); opacity: 0;
  }

  @media (max-width: 759px) {
    .steps { grid-template-columns: 1fr; --gap: 36px; padding-left: 34px; }
    .node { position: absolute; left: -34px; top: 6px; }
    h3 { margin-top: 0; }
    .seg { top: calc(6px + var(--node)); left: calc(-34px + var(--node) / 2 - 0.75px); width: 1.5px; height: calc(100% + var(--gap) - var(--node)); }
    .run::after { right: auto; top: auto; left: 50%; bottom: 0; translate: -50% 50%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .node { animation: light-up 450ms var(--ease-out) var(--t) both; }
    .steps li:last-child .node { animation: light-up 450ms var(--ease-out) var(--t) both, glow-in 600ms var(--ease-out) var(--t) both, breathe 2.6s ease-in-out calc(var(--t) + 0.6s) infinite; }
    .run { animation: run-x 900ms cubic-bezier(0.65, 0, 0.35, 1) calc(var(--t) + 0.3s) both; }
    .run::after { animation: head 900ms linear calc(var(--t) + 0.3s) both; }
    h3, .steps p { animation: rise 600ms var(--ease-out) calc(var(--t) - 0.1s) both; }
    .steps p { animation-delay: calc(var(--t) + 0.05s); }
    @media (max-width: 759px) { .run { animation-name: run-y; } }
  }
  @keyframes light-up { from { background: var(--color-paper); outline: 1.5px solid var(--color-line); outline-offset: -1.5px; scale: 0.6; } to { scale: 1; } }
  @keyframes glow-in { from { box-shadow: 0 0 0 0 rgb(var(--glow) / 0); } }
  @keyframes breathe { 50% { box-shadow: 0 0 30px 10px rgb(var(--glow) / 0.22); } }
  @keyframes run-x { from { width: 0; } }
  @keyframes run-y { from { height: 0; } }
  @keyframes head { 0% { opacity: 0; } 10%, 85% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes rise { from { opacity: 0; translate: 0 10px; } }
</style>
