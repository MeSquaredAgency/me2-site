---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { fill, fixtureText, flags } from '../config';
import { content } from '../content/site';
// The privacy page at /privacy/. A dynamic route so it is only built when showPrivacyPage is on.
// The text is in site.ts (reviewed by EC, 16 Oct 2026).
export function getStaticPaths() {
  return flags.showPrivacyPage ? [{ params: { page: 'privacy' } }] : [];
}
const c = content.privacy;
---
<Base path="/privacy/">
  <Header tone="paper" />
  <main id="main">
    <section class="head on-paper"><div class="wrap"><h1>{c.h1}</h1><p class="updated">{c.updated}</p></div></section>
    <section class="section on-paper">
      <div class="wrap body">
        {fixtureText.privacy
          ? <p>{fixtureText.privacy}</p>
          : c.sections.map((s) => (
            <section class="part">
              <h2>{s.h}</h2>
              {s.p.map((t) => <p>{fill(t)}</p>)}
            </section>
          ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  /* Warm paper, like the home page (EC, 21 Oct 2026); a hairline parts the title from the policy. */
  .head { padding: 170px 0 72px; border-bottom: 1px solid var(--color-line); }
  h1 { font-size: clamp(3rem, 8vw, 7rem); line-height: 0.9; letter-spacing: -0.05em; }
  .updated { margin-top: 20px; color: var(--color-slate); }
  .body { display: grid; gap: 40px; }
  .part { display: grid; gap: 12px; }
  .part h2 { font-size: clamp(1.4rem, 2vw, 1.8rem); letter-spacing: -0.025em; line-height: 1.2; }
  .part p { color: var(--color-slate); font-size: 1.08rem; line-height: 1.65; max-width: 68ch; }
</style>
