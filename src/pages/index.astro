---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Statement from '../components/Statement.astro';
import Demo from '../components/Demo.astro';
import OperatingModel from '../components/OperatingModel.astro';
import Compare from '../components/Compare.astro';
import Offers from '../components/Offers.astro';
import RealEstate from '../components/RealEstate.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { homeSchema } from '../lib/schema';
// Section labels carry a superscript index (the "²" idea): pass each section its number.
---
<Base path="/" schema={homeSchema()}>
  <Header />
  <main id="main">
    <Hero />
    <Marquee />
    <Statement n={1} />
    <Demo n={2} />
    <OperatingModel n={3} />
    <Compare n={4} />
    <Offers n={5} />
    <RealEstate n={6} />
    <Faq n={7} />
    <FinalCta />
  </main>
  <Footer />
</Base>
