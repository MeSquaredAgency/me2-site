---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Statement from '../components/Statement.astro';
import Demo from '../components/Demo.astro';
import OperatingModel from '../components/OperatingModel.astro';
import Compare from '../components/Compare.astro';
import Offers from '../components/Offers.astro';
import RealEstate from '../components/RealEstate.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { homeSchema } from '../lib/schema';
// Redesign proof (round 3): new hero, marquee, statement, live demo, operating model and comparison.
// Offers, real estate, FAQ and CTA are the existing sections, to be redesigned after approval.
---
<Base path="/" schema={homeSchema()}>
  <Header />
  <main id="main">
    <Hero />
    <Marquee />
    <Statement />
    <Demo />
    <OperatingModel />
    <Compare />
    <Offers />
    <RealEstate />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
