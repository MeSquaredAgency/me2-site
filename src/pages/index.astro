---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pain from '../components/Pain.astro';
import Work from '../components/Work.astro';
import Offer from '../components/Offer.astro';
import How from '../components/How.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { homeSchema } from '../lib/schema';
import { flags } from '../config';
---
<Base path="/" schema={homeSchema()}>
  <Header tone="paper" />
  <main id="main">
    <Hero />
    <Pain />
    {flags.showProof && <Work />}
    <Offer />
    <How />
    <Faq />
    <Contact />
  </main>
  <Footer />
  {flags.enableChat && <ChatWidget />}
</Base>
