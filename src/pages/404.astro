---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../content/site';
const c = content.notFound;
---
<Base path="/404.html">
  <Header tone="paper" />
  <main id="main" class="not-found on-paper">
    <div class="wrap inner">
      <h1>{c.h1}</h1>
      <p>{c.body}</p>
      <a href="/" class="btn btn-dark btn-lg">{c.button}</a>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .not-found {
    min-height: 72vh; display: flex; align-items: center;
  }
  .inner { text-align: center; display: grid; justify-items: center; gap: 22px; padding-top: 140px; padding-bottom: 96px; }
  h1 { color: var(--color-ink); }
  p { color: var(--color-slate); }
</style>
