---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../content/site';
const c = content.notFound;
---
<Base path="/404.html">
  <Header />
  <main id="main" class="not-found on-dark">
    <div class="wrap inner">
      <h1>{c.h1}</h1>
      <p>{c.body}</p>
      <a href="/" class="btn btn-light btn-lg">{c.button}</a>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .not-found {
    min-height: 72vh; display: flex; align-items: center;
    background: var(--color-abyss);
  }
  .inner { text-align: center; display: grid; justify-items: center; gap: 22px; padding-top: 140px; padding-bottom: 96px; }
  h1 { color: var(--color-mist); }
  p { color: var(--color-haze); }
</style>
