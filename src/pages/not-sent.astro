---
// Where the enquiry form lands without JavaScript if the enquiry couldn't be checked or emailed. noindex.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { config, fill } from '../config';
import { content } from '../content/site';
const c = content.thanks;
const [before, after] = fill(c.failBody).split(config.CONTACT_EMAIL);
---
<Base path="/not-sent/">
  <Header />
  <main id="main" class="done on-dark">
    <div class="wrap inner">
      <h1>{c.failH1}</h1>
      <p>{before}<a href={`mailto:${config.CONTACT_EMAIL}`} class="tlink">{config.CONTACT_EMAIL}</a>{after}</p>
      <a href="/" class="btn btn-line btn-lg">{c.button}</a>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .done { min-height: 72vh; display: flex; align-items: center; }
  .inner { display: grid; justify-items: start; gap: 24px; padding-top: 160px; padding-bottom: 120px; }
  h1 { font-size: clamp(2.6rem, 6vw, 5.5rem); line-height: 0.95; letter-spacing: -0.05em; }
  p { color: var(--color-haze); font-size: 1.2rem; }
  p a { color: var(--color-mist); }
  .btn-lg { min-height: 58px; margin-top: 12px; }
</style>
