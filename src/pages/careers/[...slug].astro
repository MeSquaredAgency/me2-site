---
// The careers section: /careers/, a page per listed role, and where the form lands without JavaScript
// (/careers/thanks/, /careers/not-sent/). Built only while showCareers is on; titles live in routes.json.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CareersIndex from '../../components/careers/CareersIndex.astro';
import RolePage from '../../components/careers/RolePage.astro';
import ApplicationOutcome from '../../components/careers/ApplicationOutcome.astro';
import { flags } from '../../config';
import { findRole, listedRoles } from '../../content/careers';
import { careersBreadcrumbSchema, jobPostingSchema } from '../../lib/schema';

export function getStaticPaths() {
  if (!flags.showCareers) return [];
  return [
    { params: { slug: undefined } },
    ...listedRoles().map((r) => ({ params: { slug: r.slug } })),
    { params: { slug: 'thanks' } },
    { params: { slug: 'not-sent' } },
  ];
}

const { slug } = Astro.params;
const role = slug ? findRole(slug) : undefined;
const path = slug ? `/careers/${slug}/` : '/careers/';
---
<Base path={path} schema={role ? [jobPostingSchema(role), careersBreadcrumbSchema(role)] : !slug ? [careersBreadcrumbSchema()] : []}>
  <Header tone="paper" />
  {!slug ? <CareersIndex /> : role ? <RolePage role={role} /> : <ApplicationOutcome kind={slug === 'thanks' ? 'thanks' : 'not-sent'} />}
  <Footer />
</Base>
