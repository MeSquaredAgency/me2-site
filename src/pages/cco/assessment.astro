---
// Me² Command Centre Operator work sample: role-specific assessment and candidate experience.
// A standalone page: its own look, not part of the sales site; noindex and not in routes.json, so it stays out of the sitemap.
// Fonts are self-hosted (the CSP allows font-src 'self' only); draft answers stay in the candidate's browser while they work; completed responses are stored after submission and a receipt is confirmed.
import '@fontsource-variable/instrument-sans';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101d2a">
<meta name="description" content="Me² Command Centre Operator pre-interview assessment"><title>Command Centre Operator Assessment — Me²</title>
<meta name="robots" content="noindex, nofollow">
<style is:inline>
:root{--navy:#101d2a;--deep:#0a141f;--panel:#172938;--line:#304452;--ink:#e9eef1;--muted:#aab7c0;--coral:#ff866c;--mint:#a9d7bd;--paper:#f5f3ee;--text:#182632;--sub:#66737c;--sans:"Instrument Sans Variable",system-ui,sans-serif;--display:"Instrument Sans Variable",system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--navy);color:var(--ink);font:15px/1.65 var(--sans);-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit}.top{max-width:1120px;margin:auto;padding:22px 28px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff18}.brand{font:700 20px var(--display);letter-spacing:-1px}.brand sup{color:var(--coral);font-size:11px}.top a{color:var(--muted);font-size:13px;text-decoration:none}.wrap{max-width:900px;margin:auto;padding:62px 24px 88px}.eyebrow{font-size:11px;letter-spacing:.16em;color:var(--coral);font-weight:700;text-transform:uppercase}.hero h1{font:600 clamp(38px,6vw,58px)/1.08 var(--display);letter-spacing:-.055em;margin:14px 0}.hero p{max-width:710px;color:#bdc7cd;margin:12px 0}.meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.pill{border:1px solid #ffffff23;border-radius:30px;padding:7px 12px;color:#d4dbdf;font-size:12px}.card{background:var(--paper);color:var(--text);border-radius:18px;padding:clamp(22px,5vw,42px);margin-top:32px;box-shadow:0 26px 70px #02080d55}.progress-top{display:flex;justify-content:space-between;align-items:center;color:#68747b;font-size:12px;font-weight:700;letter-spacing:.06em}.track{height:4px;background:#e2e0d8;border-radius:9px;margin:13px 0 29px;overflow:hidden}.track span{display:block;height:100%;width:0;background:var(--coral);transition:width .25s}.section-title{font:700 27px/1.2 var(--display);letter-spacing:-.04em;margin:0 0 7px}.section-intro{color:var(--sub);margin:0 0 24px}.field{margin:18px 0}.field label,.label{display:block;font-weight:700;margin:0 0 7px}.field small,.hint{display:block;color:var(--sub);font-size:13px;margin-top:5px}.field input,.field textarea,.field select{display:block;width:100%;border:1px solid #d6d8d3;border-radius:9px;background:#fff;padding:12px 13px;color:#1b2b36;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:#df816b;box-shadow:0 0 0 3px #e5796122}.field textarea{min-height:105px;resize:vertical}.field textarea.long{min-height:180px}.field select{cursor:pointer}.rule{background:#eae9e2;border-radius:11px;padding:17px 19px;margin:18px 0}.rule h3{margin:0 0 7px;font-size:12px;letter-spacing:.1em}.rule p{margin:5px 0}.scenario{white-space:pre-line}.row{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}.toolbar{display:flex;justify-content:space-between;gap:12px;margin-top:28px}.btn{border:0;border-radius:9px;padding:12px 20px;font-weight:700;cursor:pointer}.btn.primary{background:#172a38;color:#fff}.btn.primary:hover{background:#253d4e}.btn.secondary{background:#e8e7e0;color:#34434c}.btn:disabled{opacity:.45;cursor:not-allowed}.save{color:#78837f;font-size:12px;text-align:right;margin-top:12px}.check{display:flex;gap:10px;align-items:flex-start}.check input{margin-top:6px;accent-color:#d77d67}.foot{color:#94a2ab;font-size:12px;margin-top:25px}.hide{display:none!important}.timerbox{background:#122332;border:1px solid #ffffff1d;border-radius:12px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;color:#c0ccd2;font-size:13px}.timer{font:700 18px var(--display);color:var(--mint);font-variant-numeric:tabular-nums}.timer.warn{color:#ff9a7f}.link{color:#386e82}.privacy{font-size:12px;color:#67747b}.done{text-align:center;padding:25px 5px}.done .mark{font-size:38px;color:#478668}.done h2{font:700 30px var(--display);margin:8px 0}.done p{color:#627078}@media(max-width:650px){.wrap{padding:42px 15px 65px}.top{padding:17px 19px}.row{grid-template-columns:1fr}.card{border-radius:14px}.toolbar .btn{padding:11px 14px}}
.activity-kicker{display:inline-flex;align-items:center;gap:8px;color:#b56c59;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-bottom:9px}.activity-kicker:before{content:"";width:7px;height:7px;background:#f08a6e;border-radius:50%}.choice-set{border:0;margin:22px 0;padding:0}.choice-set legend{font-weight:700;margin-bottom:9px}.choice-list{display:grid;gap:9px}.choice-card{display:flex;gap:11px;align-items:flex-start;padding:12px 14px;border:1px solid #d9dad4;border-radius:10px;background:#fff;cursor:pointer;transition:border-color .15s,background .15s}.choice-card:hover{border-color:#c88976}.choice-card:has(input:checked){border-color:#dc816b;background:#fff8f4}.choice-card input{accent-color:#d77d67;margin:4px 0 0;flex:none}.choice-card span{line-height:1.45}.choice-set small{display:block;color:var(--sub);margin-top:7px}.work-note{background:#fff8f4;border-left:3px solid var(--coral);padding:11px 14px;border-radius:0 9px 9px 0;color:#4b5a60;margin:16px 0}.data-table{width:100%;border-collapse:collapse;margin:6px 0}.data-table th,.data-table td{text-align:left;padding:9px 7px;border-bottom:1px solid #d6d6cf}.data-table th{font-size:12px;color:#627078}.data-table td:last-child,.data-table th:last-child{text-align:right}.data-table caption{text-align:left;font-weight:700;margin-bottom:5px}.queue{display:grid;gap:10px;margin:15px 0}.queue-item{display:grid;grid-template-columns:auto 1fr;gap:10px;padding:12px 14px;background:#fff;border:1px solid #dedfd8;border-radius:10px}.queue-tag{font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:#a85e4e;padding-top:3px}.queue-item p{margin:0}.queue-item small{display:block;color:#68757c}.choice-set:focus-within legend{color:#9b5948}.field textarea{line-height:1.5}.fineprint{font-size:12px;color:#66737c}.toolbar{position:sticky;bottom:0;background:linear-gradient(transparent,var(--paper) 22%);padding:18px 0 2px}.btn.primary{background:#a85f4e}.btn.primary:hover{background:#8e4d40}.btn.secondary{background:#e6e4dc}.save{font-size:12px}.section-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px}.section-meta .activity-kicker{margin:0}.time-tag{font-size:11px;font-weight:700;color:#69757a;background:#e9e8e1;border-radius:30px;padding:4px 9px}.scale-set{border:0;padding:0;margin:20px 0 23px}.scale-set legend{font-weight:700;margin-bottom:10px}.scale-anchors{display:flex;justify-content:space-between;gap:14px;color:#626f76;font-size:13px;margin-bottom:9px}.scale-options{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.scale-option{position:relative;cursor:pointer}.scale-option input{position:absolute;opacity:0;inset:0}.scale-option span{display:grid;place-items:center;min-height:46px;border:1px solid #d6d8d3;border-radius:9px;background:#fff;font-weight:700;color:#53616a;transition:all .15s}.scale-option:hover span{border-color:#c88976}.scale-option input:checked+span{border-color:#dc816b;background:#fff2ec;color:#823f32;box-shadow:inset 0 0 0 1px #dc816b}.scale-option input:focus-visible+span{outline:3px solid #d77d6770;outline-offset:2px}.scale-hint{display:flex;justify-content:space-between;color:#7a858a;font-size:11px;margin-top:6px}.priority-board{margin:18px 0 24px}.board-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.board-head span{font-size:12px;color:#6c777d}.priority-list{list-style:none;padding:0;margin:0;display:grid;gap:9px}.priority-card{display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:12px;border:1px solid #d9dad4;background:#fff;border-radius:11px;padding:11px 12px}.priority-number{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#f2ece5;color:#9a5748;font-weight:800;font-size:13px}.priority-copy strong{font-size:14px}.priority-copy p{margin:2px 0 0;color:#58666e;font-size:13px;line-height:1.4}.priority-controls{display:flex;gap:5px}.move-btn{width:36px;height:36px;border:1px solid #d8d9d3;border-radius:8px;background:#f8f7f3;color:#253844;font-size:18px;cursor:pointer}.move-btn:hover:not(:disabled){border-color:#c88976;background:#fff5ef}.move-btn:focus-visible{outline:3px solid #d77d6770;outline-offset:2px}.move-btn:disabled{opacity:.35;cursor:default}.board-foot{font-size:12px;color:#758087;margin:8px 0 0}@media(max-width:560px){.scale-anchors{font-size:12px}.priority-card{grid-template-columns:30px 1fr auto;gap:8px;padding:10px}.priority-copy p{font-size:12px}.move-btn{width:32px;height:34px}.section-title{font-size:25px}}</style></head>
<body><header class="top"><div class="brand">Me<sup>²</sup></div><a href="mailto:people@mesquaredagency.com">Questions? Contact the people team ↗</a></header>
<main class="wrap"><section class="hero"><div class="eyebrow">ME² · COMMAND CENTRE OPERATOR</div><h1>A little look at<br>how you work.</h1><p>Five short activities built around the real job. Everything you need to answer is on the page; no property-management experience is needed.</p><div class="meta"><span class="pill">About 20 minutes</span><span class="pill">Pause and return</span><span class="pill">Calculator & spellcheck welcome</span></div></section>
<section class="card" id="app" aria-live="polite"></section><p class="foot">All case details are fictional. Your draft is saved on this device until submission is confirmed.</p></main>
<script is:inline>
(()=>{'use strict';
const key='me2-operator-assessment-v5', total=6;
const initial={page:0,answers:{},submissionId:null,submitted:null};
let state;
try{
 const saved=JSON.parse(localStorage.getItem(key)||'null');
 if(saved) state={...initial,...saved,answers:{...initial.answers,...(saved.answers||{})}};
 else {
  let legacy=null;
  try{legacy=JSON.parse(localStorage.getItem('me2-operator-assessment-v4')||'null')||JSON.parse(localStorage.getItem('me2-operator-assessment-v3')||'null')||JSON.parse(localStorage.getItem('me2-operator-assessment-v2')||'null')}catch{}
  const old=legacy&&legacy.answers?legacy.answers:{};
  state={...initial,answers:{name:old.name||'',email:old.email||'',location:old.location||''}};
 }
}catch{state={...initial,answers:{}}}
if(state.page===total&&!state.submitted){state.submitting=false;state.submitError=state.submitError||'We could not confirm receipt. Your draft is still saved on this device. Please retry when you’re ready.'}const app=document.querySelector('#app');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const val=n=>esc(state.answers[n]||'');
function save(){try{localStorage.setItem(key,JSON.stringify(state))}catch{}const el=document.querySelector('.save');if(el)el.textContent='Saved on this device';}
function field(id,label,opt={}){
 const v=val(id),required=opt.required?' required':'',hint=opt.hint?'<small>'+opt.hint+'</small>':'';
 let input;
 if(opt.area)input='<textarea id="'+id+'" maxlength="'+(opt.max||1000)+'"'+required+' placeholder="'+esc(opt.placeholder||'')+'">'+v+'</textarea>';
 else input='<input id="'+id+'" type="'+(opt.type||'text')+'" value="'+v+'"'+required+(opt.type==='number'?' min="0" step="0.01"':'')+' placeholder="'+esc(opt.placeholder||'')+'">';
 return '<div class="field"><label for="'+id+'">'+label+(opt.required?' *':'')+'</label>'+input+hint+'</div>';
}
function area(id,label,placeholder,max=700,required=true){return field(id,label,{area:true,placeholder,max,required})}
function choices(id,label,options,help=''){
 const selected=state.answers[id]||'';
 return '<fieldset class="choice-set"><legend>'+label+'</legend><div class="choice-list">'+options.map((o,i)=>'<label class="choice-card"><input type="radio" name="'+id+'" id="'+id+'-'+i+'" value="'+esc(o.value)+'"'+(selected===o.value?' checked':'')+' required><span>'+o.label+'</span></label>').join('')+'</div>'+(help?'<small>'+help+'</small>':'')+'</fieldset>';
}
function checks(id,label,options){
 const selected=Array.isArray(state.answers[id])?state.answers[id]:[];
 return '<fieldset class="choice-set" data-required-group="'+id+'"><legend>'+label+'</legend><div class="choice-list">'+options.map((o,i)=>'<label class="choice-card"><input type="checkbox" name="'+id+'" id="'+id+'-'+i+'" value="'+esc(o.value)+'"'+(selected.includes(o.value)?' checked':'')+'><span>'+o.label+'</span></label>').join('')+'</div><small>Select every line you would pause before sending.</small></fieldset>';
}
function scale(id,label,left,right){
 const selected=String(state.answers[id]||'');
 return '<fieldset class="scale-set"><legend>'+label+'</legend><div class="scale-anchors"><span>'+left+'</span><span>'+right+'</span></div><div class="scale-options">'+[1,2,3,4,5].map(n=>'<label class="scale-option"><input type="radio" name="'+id+'" id="'+id+'-'+n+'" value="'+n+'"'+(selected===String(n)?' checked':'')+' required><span>'+n+'</span></label>').join('')+'</div></fieldset>';
}
function priorityBoard(){
 const items=[
  {id:'leak',title:'Active leak',detail:'Water is pouring under the sink. The tenant cannot stop it.'},
  {id:'rent',title:'11:00 check-in',detail:'Brett needs a rent summary; two accounts need follow-up.'},
  {id:'hotwater',title:'No hot water',detail:'No hot water since Friday. Contractor quoted $2,400 for replacement.'},
  {id:'report',title:'Owner report due',detail:'Due today. The draft contains lines that still need checking.'}
 ];
 const saved=Array.isArray(state.answers.queueOrder)?state.answers.queueOrder:[];
 const order=[...saved.filter(id=>items.some(item=>item.id===id)),...items.map(item=>item.id).filter(id=>!saved.includes(id))];
 state.answers.queueOrder=order;
 return '<div class="priority-board"><div class="board-head"><strong>Put these in the order you’d handle them</strong><span>Use the arrows</span></div><ol class="priority-list">'+order.map((id,index)=>{const item=items.find(x=>x.id===id);return '<li class="priority-card" data-task="'+id+'"><span class="priority-number">'+(index+1)+'</span><div class="priority-copy"><strong>'+item.title+'</strong><p>'+item.detail+'</p></div><div class="priority-controls"><button class="move-btn" id="move-'+id+'-up" data-move="'+id+':-1" aria-label="Move '+item.title+' up" '+(index===0?'disabled':'')+'>↑</button><button class="move-btn" id="move-'+id+'-down" data-move="'+id+':1" aria-label="Move '+item.title+' down" '+(index===order.length-1?'disabled':'')+'>↓</button></div></li>'}).join('')+'</ol><p class="board-foot" id="rank-announcer" aria-live="polite">Your order saves automatically.</p></div>';
}
function card(title,content){return '<div class="rule"><h3>'+title+'</h3><div class="scenario">'+content+'</div></div>'}
function header(n,title,sub,mins){return '<div class="progress-top"><span>STEP '+String(n).padStart(2,'0')+' OF '+String(total).padStart(2,'0')+'</span><span>'+Math.round(n/total*100)+'% complete</span></div><div class="track"><span style="width:'+(n/total*100)+'%"></span></div><div class="section-meta"><div class="activity-kicker">WORK SAMPLE</div><span class="time-tag">~'+mins+' min</span></div><h2 class="section-title">'+title+'</h2><p class="section-intro">'+sub+'</p>'}

function render(){
 if(state.submitted){showStatus();return}
 if(state.page===total){showStatus(state.submitError||'',!!state.submitting);return}
 let body='';
 if(state.page===0){
  body=header(1,'Welcome to the work sample','A little about you and your starting point. You can pause and return on this device.',1)+
   '<div class="row">'+field('name','What should we call you?',{required:true,placeholder:'Your name'})+field('email','Email address',{required:true,type:'email',placeholder:'name@example.com'})+'</div>'+
   field('location','Where are you based?',{required:true,placeholder:'City and country'})+
   card('A FEW QUICK NOTES','About 20 minutes · No timer · Calculator and spellcheck welcome · All scenarios are fictional.')+
   '<p class="fineprint">Need another format or extra time? Email <a class="link" href="mailto:people@mesquaredagency.com">people@mesquaredagency.com</a>. Your answers are saved on this device as you go.</p>';
 }
 if(state.page===1){
  body=header(2,'Your best-work snapshot','Just preferences, not a score. Pick the point that feels most like you.',2)+
   scale('workRhythm','I feel at my best when the day has…','A clear plan','Room to adjust')+
   scale('workFocus','I enjoy…','A good stretch of focus','A mix of different tasks')+
   scale('workTalk','I tend to work things out by…','Thinking it through','Talking it through')+
   area('reliedOn','What do people count on you for?','One sentence is plenty.',250,false)+
   '<p class="fineprint">There is no preferred profile. We use this to make the conversation useful.</p>';
 }
 if(state.page===2){
  body=header(3,'Quick numbers check','Use a calculator if you like. Work out rent overdue only; keep the separate instalment out of the total.',4)+
   card('MONDAY · 12 OCTOBER','Count calendar days after the paid-through date, including 12 October. Daily rent = weekly rent ÷ 7, rounded to cents.<table class="data-table"><caption>Three rent accounts</caption><thead><tr><th>Account</th><th>Weekly rent</th><th>Paid through</th></tr></thead><tbody><tr><td>Patel</td><td>$560</td><td>10 Oct</td></tr><tr><td>Taylor</td><td>$630</td><td>5 Oct</td></tr><tr><td>Doyle</td><td>$490</td><td>28 Sep</td></tr></tbody></table>Doyle also has a separate $140 instalment due 9 October.')+
   '<div class="row">'+field('patelAmount','Patel · rent overdue ($)',{required:true,type:'number'})+field('taylorAmount','Taylor · rent overdue ($)',{required:true,type:'number'})+field('doyleAmount','Doyle · rent overdue ($)',{required:true,type:'number'})+field('rentTotal','Total rent overdue ($)',{required:true,type:'number'})+'</div>'+
   choices('planAction','How would you handle the missed instalment?',[{value:'separate',label:'Record it separately and flag it to the Property Manager'},{value:'add',label:'Add it to rent overdue'},{value:'skip',label:'Leave it out of the summary'}]);
 }
 if(state.page===3){
  body=header(4,'Spot what needs a second look','Compare the notes with the draft. Pick every line you would pause before sending.',4)+
   card('CONFIRMED NOTES','• A ceiling stain appeared after a storm; the cause is unknown.<br>• A hallway smoke alarm chirps and could not be tested.<br>• The bathroom fan is not working.<br>• The tenant privately mentioned reduced work hours.')+
   card('DRAFT UPDATE','“The tenant caused the stain and will pay. All alarms passed testing. The tenant may struggle to pay rent. No maintenance is needed.”')+
   checks('riskyLines','Which draft statements need checking?',[{value:'blame',label:'The tenant caused the stain and will pay.'},{value:'alarm',label:'All alarms passed testing.'},{value:'private',label:'The tenant may struggle to pay rent.'},{value:'maintenance',label:'No maintenance is needed.'}])+
   area('ownerSummary','Write the owner update','Two clear sentences. Use confirmed facts and note the follow-up.',400);
 }
 if(state.page===4){
  body=header(5,'A busy morning','You can handle routine work and arrange urgent work up to $1,000. Brett, the Property Manager, approves permanent repairs above that.',5)+
   priorityBoard()+
   choices('quoteMove','The contractor’s $2,400 replacement quote arrives. What do you do?',[{value:'escalate',label:'Ask Brett to decide; arrange urgent work within your $1,000 limit'},{value:'approve',label:'Approve the full quote so work can begin'},{value:'wait',label:'Wait until your next check-in with Brett'}])+
   area('queuePlan','What would you tell Brett before 11:00?','A sentence or two is plenty.',350);
 }
 if(state.page===5){
  body=header(6,'Your voice. Your follow-through.','Two short prompts. Examples from work, study, volunteering or everyday life all count.',6)+
   card('A TENANT MESSAGE','“The contractor was rude and left a mess. Nobody takes this seriously.”')+
   area('tenantReply','Write the reply you would send','Acknowledge the concern and say what you’ll do next.',400)+
   area('initiative','Tell us about a time you noticed something needed doing and followed through','What was happening, what did you do, and what changed or did you learn?',600)+
   area('motivation','What would you be curious to learn first in this role?','Optional · one sentence.',250,false)+
   '<p class="fineprint">Your answers go to the Me² hiring team when you choose Finish. You’ll see a receipt once they are stored.</p>';
 }
 app.innerHTML=body+'<div class="toolbar"><button class="btn secondary" id="back" '+(state.page===0?'disabled':'')+'>Back</button><div><button class="btn primary" id="next">'+(state.page===total-1?'Finish':'Continue')+'</button></div></div><div class="save">Saved on this device</div>';
 app.querySelectorAll('input,textarea').forEach(el=>{el.addEventListener('input',onChange);el.addEventListener('change',onChange)});
 app.querySelector('#back').onclick=()=>{state.submissionId=null;state.submitError='';state.page=Math.max(0,state.page-1);save();render();scrollTo(0,0)};
 app.querySelector('#next').onclick=next;
 app.querySelectorAll('[data-move]').forEach(btn=>btn.onclick=()=>{const [id,delta]=btn.dataset.move.split(':');const list=app.querySelector('.priority-list'),item=list.querySelector('[data-task="'+id+'"]'),step=Number(delta),neighbor=step<0?item.previousElementSibling:item.nextElementSibling;if(!neighbor)return;if(step<0)list.insertBefore(item,neighbor);else list.insertBefore(neighbor,item);const cards=[...list.querySelectorAll('[data-task]')],position=cards.indexOf(item);state.answers.queueOrder=cards.map(card=>card.dataset.task);cards.forEach((card,index)=>{card.querySelector('.priority-number').textContent=String(index+1);card.querySelector('[data-move="'+card.dataset.task+':-1"]').disabled=index===0;card.querySelector('[data-move="'+card.dataset.task+':1"]').disabled=index===cards.length-1;});save();const focusDirection=(step<0&&position===0)||(step>0&&position===cards.length-1)?(step<0?'down':'up'):(step<0?'up':'down');document.querySelector('#move-'+id+'-'+focusDirection).focus();document.querySelector('#rank-announcer').textContent='Moved '+item.querySelector('.priority-copy strong').textContent+' to priority '+(position+1)+'.';});
}
function onChange(event){
 const el=event.target;
 if(el.type==='radio'){if(el.checked)state.answers[el.name]=el.value}
 else if(el.type==='checkbox'){
  const key=el.name,current=Array.isArray(state.answers[key])?state.answers[key]:[];
  state.answers[key]=el.checked?[...new Set([...current,el.value])]:current.filter(v=>v!==el.value);
 }else state.answers[el.id]=el.value;
 save();
}
function next(){
 for(const el of app.querySelectorAll('[required]')){
  if(!el.checkValidity()){el.reportValidity();return}
  if(el.type==='radio'){if(el.checked)state.answers[el.name]=el.value}
  else state.answers[el.id]=el.value;
 }
 const requiredGroup=app.querySelector('[data-required-group]');
 if(requiredGroup&&!(state.answers[requiredGroup.dataset.requiredGroup]||[]).length){
  alert('Choose at least one line you would pause before sending.');requiredGroup.scrollIntoView({behavior:'smooth',block:'center'});return;
 }
 if(state.page<total-1){state.page++;state.submissionId=null;state.submitError='';save();render();scrollTo(0,0)}
 else submitAssessment();
}
async function submitAssessment(){
 state.submissionId||=crypto.randomUUID();state.page=total;state.submitting=true;state.submitError='';save();showStatus('',true);
 try{
  const payload={submissionId:state.submissionId,assessment:'Me² — Command Centre Operator Work Sample',completedAt:new Date().toISOString(),candidate:{name:state.answers.name||'',email:state.answers.email||'',location:state.answers.location||''},responses:state.answers};
  const response=await fetch('/api/assessments',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  const result=await response.json().catch(()=>({}));
  if(!response.ok||result.ok!==true||!result.receiptId)throw new Error('not_confirmed');
  state.submitted={receiptId:result.receiptId,submittedAt:new Date().toISOString()};state.answers={};state.submitting=false;
  try{localStorage.removeItem('me2-operator-assessment-v2');localStorage.removeItem('me2-operator-assessment-v3');localStorage.removeItem('me2-operator-assessment-v4')}catch{}
  save();showStatus();
 }catch{
  state.submitting=false;state.submitError='We could not confirm receipt. Your draft is still saved on this device. Please try again when you’re ready.';save();showStatus(state.submitError,false);
 }
}
function showStatus(message='',pending=false){
 if(state.submitted){
  app.innerHTML='<div class="done"><div class="mark">✓</div><h2>Thanks — we’ve got it.</h2><p>Your work sample has been received by the Me² hiring team.</p><p><strong>Receipt:</strong> '+esc(state.submitted.receiptId)+'</p><p class="privacy">You can close this page now.</p></div>';return;
 }
 if(pending){
  app.innerHTML='<div class="done"><div class="mark">…</div><h2>Sending your work sample</h2><p>Please wait while we confirm it has been stored.</p></div>';return;
 }
 app.innerHTML='<div class="done"><div class="mark">!</div><h2>One small hiccup</h2><p>'+esc(message||'We could not confirm receipt.')+'</p><div class="toolbar"><button class="btn secondary" id="return">Review answers</button><button class="btn primary" id="retry">Try again</button></div></div>';
 const retry=document.querySelector('#retry');if(retry)retry.onclick=submitAssessment;
 const back=document.querySelector('#return');if(back)back.onclick=()=>{state.page=total-1;state.submissionId=null;state.submitError='';save();render();scrollTo(0,0)};
}
render();})();
</body></html>
