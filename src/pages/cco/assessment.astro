---
// A short, welcoming pre-interview assessment for Command Centre Operator candidates.
// A standalone page: its own look, not part of the sales site; noindex and not in routes.json, so it stays out of the sitemap.
// Fonts are self-hosted (the CSP allows font-src 'self' only); draft answers stay in the candidate's browser while they work; completed responses are stored after submission and a receipt is confirmed.
import '@fontsource-variable/instrument-sans';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101d2a">
<meta name="description" content="Me² Command Centre Operator pre-interview assessment"><title>Command Centre Operator Assessment — Me²</title>
<meta name="robots" content="noindex, nofollow">
<style is:inline>
:root{--navy:#101d2a;--deep:#0a141f;--panel:#172938;--line:#304452;--ink:#e9eef1;--muted:#aab7c0;--coral:#ff866c;--mint:#a9d7bd;--paper:#f5f3ee;--text:#182632;--sub:#66737c;--sans:"Instrument Sans Variable",system-ui,sans-serif;--display:"Instrument Sans Variable",system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--navy);color:var(--ink);font:15px/1.65 var(--sans);-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit}.top{max-width:1120px;margin:auto;padding:22px 28px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff18}.brand{font:700 20px var(--display);letter-spacing:-1px}.brand sup{color:var(--coral);font-size:11px}.top a{color:var(--muted);font-size:13px;text-decoration:none}.wrap{max-width:900px;margin:auto;padding:62px 24px 88px}.eyebrow{font-size:11px;letter-spacing:.16em;color:var(--coral);font-weight:700;text-transform:uppercase}.hero h1{font:600 clamp(38px,6vw,58px)/1.08 var(--display);letter-spacing:-.055em;margin:14px 0}.hero p{max-width:710px;color:#bdc7cd;margin:12px 0}.meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.pill{border:1px solid #ffffff23;border-radius:30px;padding:7px 12px;color:#d4dbdf;font-size:12px}.card{background:var(--paper);color:var(--text);border-radius:18px;padding:clamp(22px,5vw,42px);margin-top:32px;box-shadow:0 26px 70px #02080d55}.progress-top{display:flex;justify-content:space-between;align-items:center;color:#68747b;font-size:12px;font-weight:700;letter-spacing:.06em}.track{height:4px;background:#e2e0d8;border-radius:9px;margin:13px 0 29px;overflow:hidden}.track span{display:block;height:100%;width:0;background:var(--coral);transition:width .25s}.section-title{font:700 27px/1.2 var(--display);letter-spacing:-.04em;margin:0 0 7px}.section-intro{color:var(--sub);margin:0 0 24px}.field{margin:18px 0}.field label,.label{display:block;font-weight:700;margin:0 0 7px}.field small,.hint{display:block;color:var(--sub);font-size:13px;margin-top:5px}.field input,.field textarea,.field select{display:block;width:100%;border:1px solid #d6d8d3;border-radius:9px;background:#fff;padding:12px 13px;color:#1b2b36;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:#df816b;box-shadow:0 0 0 3px #e5796122}.field textarea{min-height:105px;resize:vertical}.field textarea.long{min-height:180px}.field select{cursor:pointer}.rule{background:#eae9e2;border-radius:11px;padding:17px 19px;margin:18px 0}.rule h3{margin:0 0 7px;font-size:12px;letter-spacing:.1em}.rule p{margin:5px 0}.scenario{white-space:pre-line}.row{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}.toolbar{display:flex;justify-content:space-between;gap:12px;margin-top:28px}.btn{border:0;border-radius:9px;padding:12px 20px;font-weight:700;cursor:pointer}.btn.primary{background:#172a38;color:#fff}.btn.primary:hover{background:#253d4e}.btn.secondary{background:#e8e7e0;color:#34434c}.btn:disabled{opacity:.45;cursor:not-allowed}.save{color:#78837f;font-size:12px;text-align:right;margin-top:12px}.check{display:flex;gap:10px;align-items:flex-start}.check input{margin-top:6px;accent-color:#d77d67}.foot{color:#94a2ab;font-size:12px;margin-top:25px}.hide{display:none!important}.timerbox{background:#122332;border:1px solid #ffffff1d;border-radius:12px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;color:#c0ccd2;font-size:13px}.timer{font:700 18px var(--display);color:var(--mint);font-variant-numeric:tabular-nums}.timer.warn{color:#ff9a7f}.link{color:#386e82}.privacy{font-size:12px;color:#67747b}.done{text-align:center;padding:25px 5px}.done .mark{font-size:38px;color:#478668}.done h2{font:700 30px var(--display);margin:8px 0}.done p{color:#627078}@media(max-width:650px){.wrap{padding:42px 15px 65px}.top{padding:17px 19px}.row{grid-template-columns:1fr}.card{border-radius:14px}.toolbar .btn{padding:11px 14px}}
</style></head>
<body><header class="top"><div class="brand">Me<sup>²</sup></div><a href="mailto:people@mesquaredagency.com">Questions? Contact the people team ↗</a></header>
<main class="wrap"><section class="hero"><div class="eyebrow">A short pre-interview activity</div><h1>Let’s see how<br>you think.</h1><p>A few small, fictional work moments to show us your judgement, communication and eye for detail. About 20 minutes. No trick questions. No need to overthink it.</p><div class="meta"><span class="pill">About 20 minutes</span><span class="pill">5 short steps</span><span class="pill">Calculator welcome</span></div></section>
<section class="card" id="app" aria-live="polite"></section><p class="foot">The work examples are fictional. Your draft is saved on this device while you complete the assessment.</p></main>
<script is:inline>
(()=>{'use strict';
const key='me2-operator-assessment-v3', sections=['A quick hello','How you work','Quick thinking','Spot the slip','Your approach'];
const initial={page:0,answers:{},submissionId:null,submitted:null};let state;
try{const saved=JSON.parse(localStorage.getItem(key)||'{}');state={...initial,...saved,answers:{...initial.answers,...(saved.answers||{})}}}catch{state={...initial,answers:{}}}
const app=document.querySelector('#app');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const val=n=>esc(state.answers[n]||'');
function save(){localStorage.setItem(key,JSON.stringify(state));const s=document.querySelector('.save');if(s)s.textContent='Saved as you go';}
function field(id,label,opt={}){const v=val(id),req=opt.required?' required':'';let control=opt.options?'<select id="'+id+'"'+req+'><option value="">Choose what feels closest</option>'+opt.options.map(x=>'<option'+(v===x?' selected':'')+'>'+esc(x)+'</option>').join('')+'</select>':opt.area?'<textarea id="'+id+'" maxlength="'+(opt.max||1200)+'"'+req+' placeholder="'+esc(opt.placeholder||'')+'">'+v+'</textarea>':'<input id="'+id+'" type="'+(opt.type||'text')+'" value="'+v+'"'+req+(opt.type==='number'?' min="0" step="0.01"':'')+' placeholder="'+esc(opt.placeholder||'')+'">';
return '<div class="field"><label for="'+id+'">'+label+(opt.required?' *':'')+'</label>'+control+(opt.hint?'<small>'+opt.hint+'</small>':'')+'</div>'}
function area(id,label,hint='',max=800,required=true){return field(id,label,{area:true,max,required,placeholder:hint})}
function sectionHeader(title,sub){const n=state.page+1;return '<div class="progress-top"><span>STEP '+String(n).padStart(2,'0')+' OF 05</span><span>'+String(n).padStart(2,'0')+' / 05</span></div><div class="track"><span style="width:'+(n/5*100)+'%"></span></div><h2 class="section-title">'+title+'</h2><p class="section-intro">'+sub+'</p>'}
function card(title,txt){return '<div class="rule"><h3>'+title+'</h3><div class="scenario">'+txt+'</div></div>'}
function render(){
 if(state.page===5){renderSubmissionStatus(state.submissionId&&!state.submitted?'We couldn’t confirm the previous attempt. Your answers are still saved here; retry when you’re ready.':'');return}
 let body='';
 if(state.page===0)body=sectionHeader('A quick hello','This takes about 20 minutes. We’re interested in how you think, communicate and make work better. No trick questions, and a rough draft is fine.')+
 '<div class="row">'+field('name','What should we call you?',{required:true,placeholder:'Your name'})+field('email','Where can we reach you?',{required:true,type:'email',placeholder:'Email address'})+'</div>'+
 field('location','Where are you based?',{required:true,placeholder:'City and country'})+
 card('YOUR ROLE IN A LINE','You’ll support a property manager: handle routine follow-up, keep people informed, and bring safety, legal or higher-cost decisions to them. A calculator is welcome. We’re looking for thoughtful choices and care with details, not perfect wording or speed.');
 if(state.page===1)body=sectionHeader('How you work','There’s no “right personality” here. Pick what feels most like you, then tell us a little more.')+
 field('busy','When a few things land at once, what’s your natural first move?',{required:true,options:['Make a quick list and check deadlines','Check whether anyone needs help right now','Clarify priorities with the person responsible','Start with the smallest useful next step']})+
 field('reward','Which part of a good workday feels most satisfying?',{required:true,options:['Helping someone get unstuck','Noticing and fixing a detail others missed','Making a process run smoothly','Learning a new skill or tool','Making a reliable contribution to a team']})+
 area('feedback','A teammate points out something you missed. What would you do next?','A few sentences is plenty.',500);
 if(state.page===2)body=sectionHeader('Quick thinking','A small number check. Use a calculator if you like; we care about your approach, not mental arithmetic.')+
 card('THREE RENT ACCOUNTS','It’s Monday 12 October. Count days after the paid-through date up to and including 12 October. Daily rent = weekly rent ÷ 7.<br><br><strong>Patel</strong> · $560/week · paid through 10 Oct<br><strong>Taylor</strong> · $630/week · paid through 5 Oct<br><strong>Doyle</strong> · $490/week · paid through 28 Sep<br><br>Doyle also missed a separate $140 payment-plan instalment due 9 Oct.')+
 '<div class="row">'+field('patelAmt','Patel: rent overdue ($)',{required:true,type:'number'})+field('taylorAmt','Taylor: rent overdue ($)',{required:true,type:'number'})+field('doyleAmt','Doyle: rent overdue ($)',{required:true,type:'number'})+field('total','Total rent overdue ($)',{required:true,type:'number'})+'</div>'+
 field('doyleAction','What would you do with Doyle’s missed instalment?',{required:true,options:['Add it to the rent calculation','Record it separately and flag it to the manager','Ignore it because rent is overdue too','Send a formal notice myself']})+
 '<small>For this exercise, calculate rent only; keep the instalment separate.</small>';
 if(state.page===3)body=sectionHeader('Spot the slip','A quick accuracy check. Use the notes as your source of truth; you don’t need to rewrite a long report.')+
 card('INSPECTION NOTES','Bedroom 2 has a ceiling stain near the window after a storm; the cause is unknown. The bathroom fan isn’t working. A hallway smoke alarm chirps and could not be tested. The tenant privately mentioned their work hours were reduced.')+
 card('DRAFT SUMMARY','“The tenant caused the ceiling stain. All alarms were tested and working. The tenant may struggle to pay rent. No maintenance is needed.”')+
 area('problems','What would you correct or check?','Name the key issues you spotted. Short bullets are welcome.',500)+
 area('ownerNote','Write a short, factual update for the owner.','Two or three sentences is plenty.',500);
 if(state.page===4)body=sectionHeader('Your approach','One last realistic moment, then we’re done.')+
 card('A BUSY MORNING','Water is pouring under a tenant’s kitchen sink. Another tenant has had no hot water since Friday; a contractor sent a $2,400 replacement quote. An owner’s routine report is due today.')+
 area('priority','What would you do first, and what would you pass to the manager?','Tell us your first few steps and why. A short list is fine.',700)+
 card('A HUMAN MOMENT','A tenant writes: “The contractor was rude and left a mess. No one takes this seriously.”')+
 area('reply','Write a kind, clear reply.','Two to four sentences.',500)+
 area('motivation','What would you be excited to learn or get better at in this role?','A sentence or two is enough.',400)+
 '<div class="rule"><h3>THANK YOU</h3><p>Your responses are used by the Me² hiring team to review your application. They’re saved as you go on this device and submitted securely when you finish.</p></div>';
 app.innerHTML=body+'<div class="toolbar"><button class="btn secondary" id="back" '+(state.page===0?'disabled':'')+'>Back</button><div><button class="btn primary" id="next">'+(state.page===4?'Finish':'Continue')+'</button></div></div><div class="save">Saved as you go</div>';
 app.querySelectorAll('input,textarea,select').forEach(el=>{el.addEventListener('input',()=>{state.answers[el.id]=el.value;save()});el.addEventListener('change',()=>{state.answers[el.id]=el.value;save()})});
 app.querySelector('#back').onclick=()=>{state.page=Math.max(0,state.page-1);save();render();scrollTo(0,0)};
 app.querySelector('#next').onclick=next;
}
function next(){for(const el of app.querySelectorAll('[required]')){if(!el.checkValidity()){el.reportValidity();return}state.answers[el.id]=el.value}
 if(state.page<4){state.page++;save();render();scrollTo(0,0)}else submitAssessment()}
async function submitAssessment(){state.submissionId||=crypto.randomUUID();state.page=5;state.submitted=null;save();renderSubmissionStatus('',true);
 try{const payload={submissionId:state.submissionId,assessment:'Me² — Command Centre Operator Assessment',completedAt:new Date().toISOString(),candidate:{name:state.answers.name||'',email:state.answers.email||'',location:state.answers.location||''},responses:state.answers};
 const response=await fetch('/api/assessments',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
 const result=await response.json().catch(()=>({}));if(!response.ok||result.ok!==true||!result.receiptId)throw new Error(result.error||'We couldn’t confirm receipt.');
 state.submitted={receiptId:result.receiptId,submittedAt:new Date().toISOString()};state.answers={};localStorage.removeItem('me2-operator-assessment-v2');save();renderSubmissionStatus()
 }catch(error){renderSubmissionStatus('We couldn’t confirm receipt. Your answers are still saved in this browser. Check your connection and retry when ready.')}}
function renderSubmissionStatus(message='',pending=false){if(state.submitted){app.innerHTML='<div class="done"><div class="mark">✓</div><h2>All done!</h2><p>Your assessment has been received. Thank you for taking the time.</p><p><strong>Receipt:</strong> '+esc(state.submitted.receiptId)+'</p><p class="privacy">You can close this page now.</p></div>';return}
 app.innerHTML='<div class="done"><div class="mark">'+(message?'!':'…')+'</div><h2>'+(message?'One small hiccup':'Sending your answers')+'</h2><p>'+esc(message||'Please wait while we confirm your response was received.')+'</p>'+(message?'<button class="btn primary" id="retry">Try again</button>':'')+'</div>';
 const retry=document.querySelector('#retry');if(retry)retry.onclick=submitAssessment}
render();})();
</body></html>
