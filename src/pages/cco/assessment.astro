---
// Me² Command Centre Operator work sample: role-specific assessment and candidate experience.
// A standalone page: its own look, not part of the sales site; noindex and not in routes.json, so it stays out of the sitemap.
// Fonts are self-hosted (the CSP allows font-src 'self' only); draft answers stay in the candidate's browser while they work; completed responses are stored after submission and a receipt is confirmed.
import '@fontsource-variable/instrument-sans';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101d2a">
<meta name="description" content="Me² Command Centre Operator pre-interview assessment"><title>Command Centre Operator Assessment — Me²</title>
<meta name="robots" content="noindex, nofollow">
<style is:inline>
:root{--navy:#101d2a;--deep:#0a141f;--panel:#172938;--line:#304452;--ink:#e9eef1;--muted:#aab7c0;--coral:#ff866c;--mint:#a9d7bd;--paper:#f5f3ee;--text:#182632;--sub:#66737c;--sans:"Instrument Sans Variable",system-ui,sans-serif;--display:"Instrument Sans Variable",system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--navy);color:var(--ink);font:15px/1.65 var(--sans);-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit}.top{max-width:1120px;margin:auto;padding:22px 28px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff18}.brand{font:700 20px var(--display);letter-spacing:-1px}.brand sup{color:var(--coral);font-size:11px}.top a{color:var(--muted);font-size:13px;text-decoration:none}.wrap{max-width:900px;margin:auto;padding:62px 24px 88px}.eyebrow{font-size:11px;letter-spacing:.16em;color:var(--coral);font-weight:700;text-transform:uppercase}.hero h1{font:600 clamp(38px,6vw,58px)/1.08 var(--display);letter-spacing:-.055em;margin:14px 0}.hero p{max-width:710px;color:#bdc7cd;margin:12px 0}.meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.pill{border:1px solid #ffffff23;border-radius:30px;padding:7px 12px;color:#d4dbdf;font-size:12px}.card{background:var(--paper);color:var(--text);border-radius:18px;padding:clamp(22px,5vw,42px);margin-top:32px;box-shadow:0 26px 70px #02080d55}.progress-top{display:flex;justify-content:space-between;align-items:center;color:#68747b;font-size:12px;font-weight:700;letter-spacing:.06em}.track{height:4px;background:#e2e0d8;border-radius:9px;margin:13px 0 29px;overflow:hidden}.track span{display:block;height:100%;width:0;background:var(--coral);transition:width .25s}.section-title{font:700 27px/1.2 var(--display);letter-spacing:-.04em;margin:0 0 7px}.section-intro{color:var(--sub);margin:0 0 24px}.field{margin:18px 0}.field label,.label{display:block;font-weight:700;margin:0 0 7px}.field small,.hint{display:block;color:var(--sub);font-size:13px;margin-top:5px}.field input,.field textarea,.field select{display:block;width:100%;border:1px solid #d6d8d3;border-radius:9px;background:#fff;padding:12px 13px;color:#1b2b36;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:#df816b;box-shadow:0 0 0 3px #e5796122}.field textarea{min-height:105px;resize:vertical}.field textarea.long{min-height:180px}.field select{cursor:pointer}.rule{background:#eae9e2;border-radius:11px;padding:17px 19px;margin:18px 0}.rule h3{margin:0 0 7px;font-size:12px;letter-spacing:.1em}.rule p{margin:5px 0}.scenario{white-space:pre-line}.row{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}.toolbar{display:flex;justify-content:space-between;gap:12px;margin-top:28px}.btn{border:0;border-radius:9px;padding:12px 20px;font-weight:700;cursor:pointer}.btn.primary{background:#172a38;color:#fff}.btn.primary:hover{background:#253d4e}.btn.secondary{background:#e8e7e0;color:#34434c}.btn:disabled{opacity:.45;cursor:not-allowed}.save{color:#78837f;font-size:12px;text-align:right;margin-top:12px}.check{display:flex;gap:10px;align-items:flex-start}.check input{margin-top:6px;accent-color:#d77d67}.foot{color:#94a2ab;font-size:12px;margin-top:25px}.hide{display:none!important}.timerbox{background:#122332;border:1px solid #ffffff1d;border-radius:12px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;color:#c0ccd2;font-size:13px}.timer{font:700 18px var(--display);color:var(--mint);font-variant-numeric:tabular-nums}.timer.warn{color:#ff9a7f}.link{color:#386e82}.privacy{font-size:12px;color:#67747b}.done{text-align:center;padding:25px 5px}.done .mark{font-size:38px;color:#478668}.done h2{font:700 30px var(--display);margin:8px 0}.done p{color:#627078}@media(max-width:650px){.wrap{padding:42px 15px 65px}.top{padding:17px 19px}.row{grid-template-columns:1fr}.card{border-radius:14px}.toolbar .btn{padding:11px 14px}}
.activity-kicker{display:inline-flex;align-items:center;gap:8px;color:#b56c59;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-bottom:9px}.activity-kicker:before{content:"";width:7px;height:7px;background:#f08a6e;border-radius:50%}.choice-set{border:0;margin:22px 0;padding:0}.choice-set legend{font-weight:700;margin-bottom:9px}.choice-list{display:grid;gap:9px}.choice-card{display:flex;gap:11px;align-items:flex-start;padding:12px 14px;border:1px solid #d9dad4;border-radius:10px;background:#fff;cursor:pointer;transition:border-color .15s,background .15s}.choice-card:hover{border-color:#c88976}.choice-card:has(input:checked){border-color:#dc816b;background:#fff8f4}.choice-card input{accent-color:#d77d67;margin:4px 0 0;flex:none}.choice-card span{line-height:1.45}.choice-set small{display:block;color:var(--sub);margin-top:7px}.work-note{background:#fff8f4;border-left:3px solid var(--coral);padding:11px 14px;border-radius:0 9px 9px 0;color:#4b5a60;margin:16px 0}.data-table{width:100%;border-collapse:collapse;margin:6px 0}.data-table th,.data-table td{text-align:left;padding:9px 7px;border-bottom:1px solid #d6d6cf}.data-table th{font-size:12px;color:#627078}.data-table td:last-child,.data-table th:last-child{text-align:right}.data-table caption{text-align:left;font-weight:700;margin-bottom:5px}.queue{display:grid;gap:10px;margin:15px 0}.queue-item{display:grid;grid-template-columns:auto 1fr;gap:10px;padding:12px 14px;background:#fff;border:1px solid #dedfd8;border-radius:10px}.queue-tag{font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:#a85e4e;padding-top:3px}.queue-item p{margin:0}.queue-item small{display:block;color:#68757c}.choice-set:focus-within legend{color:#9b5948}.field textarea{line-height:1.5}.fineprint{font-size:12px;color:#66737c}.toolbar{position:sticky;bottom:0;background:linear-gradient(transparent,var(--paper) 22%);padding:18px 0 2px}.btn.primary{background:#a85f4e}.btn.primary:hover{background:#8e4d40}.btn.secondary{background:#e6e4dc}.save{font-size:12px}</style></head>
<body><header class="top"><div class="brand">Me<sup>²</sup></div><a href="mailto:people@mesquaredagency.com">Questions? Contact the people team ↗</a></header>
<main class="wrap"><section class="hero"><div class="eyebrow">ME² · COMMAND CENTRE OPERATOR</div><h1>Meet a few moments<br>from the job.</h1><p>A friendly work sample to show us how you notice details, make decisions and communicate with people. Allow about 30 minutes; there is no countdown or webcam. We care about thoughtful work, not speed or test-taking polish.</p><div class="meta"><span class="pill">About 30 minutes</span><span class="pill">6 short parts</span><span class="pill">Pause and return</span><span class="pill">Calculator welcome</span></div></section>
<section class="card" id="app" aria-live="polite"></section><p class="foot">All case details are fictional. Your draft is saved on this device until submission is confirmed.</p></main>
<script is:inline>
(()=>{'use strict';
const key='me2-operator-assessment-v4', total=6;
const initial={page:0,answers:{},submissionId:null,submitted:null};
let state;
try{
 const saved=JSON.parse(localStorage.getItem(key)||'null');
 if(saved) state={...initial,...saved,answers:{...initial.answers,...(saved.answers||{})}};
 else {
  let legacy=null;
  try{legacy=JSON.parse(localStorage.getItem('me2-operator-assessment-v3')||'null')||JSON.parse(localStorage.getItem('me2-operator-assessment-v2')||'null')}catch{}
  const old=legacy&&legacy.answers?legacy.answers:{};
  state={...initial,answers:{name:old.name||'',email:old.email||'',location:old.location||''}};
 }
}catch{state={...initial,answers:{}}}
if(state.page===total&&!state.submitted){state.submitting=false;state.submitError=state.submitError||'We could not confirm receipt. Your draft is still saved on this device. Please retry when you’re ready.'}const app=document.querySelector('#app');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const val=n=>esc(state.answers[n]||'');
function save(){try{localStorage.setItem(key,JSON.stringify(state))}catch{}const el=document.querySelector('.save');if(el)el.textContent='Saved on this device';}
function field(id,label,opt={}){
 const v=val(id),required=opt.required?' required':'',hint=opt.hint?'<small>'+opt.hint+'</small>':'';
 let input;
 if(opt.area)input='<textarea id="'+id+'" maxlength="'+(opt.max||1000)+'"'+required+' placeholder="'+esc(opt.placeholder||'')+'">'+v+'</textarea>';
 else input='<input id="'+id+'" type="'+(opt.type||'text')+'" value="'+v+'"'+required+(opt.type==='number'?' min="0" step="0.01"':'')+' placeholder="'+esc(opt.placeholder||'')+'">';
 return '<div class="field"><label for="'+id+'">'+label+(opt.required?' *':'')+'</label>'+input+hint+'</div>';
}
function area(id,label,placeholder,max=700,required=true){return field(id,label,{area:true,placeholder,max,required})}
function choices(id,label,options,help=''){
 const selected=state.answers[id]||'';
 return '<fieldset class="choice-set"><legend>'+label+'</legend><div class="choice-list">'+options.map((o,i)=>'<label class="choice-card"><input type="radio" name="'+id+'" id="'+id+'-'+i+'" value="'+esc(o.value)+'"'+(selected===o.value?' checked':'')+' required><span>'+o.label+'</span></label>').join('')+'</div>'+(help?'<small>'+help+'</small>':'')+'</fieldset>';
}
function checks(id,label,options){
 const selected=Array.isArray(state.answers[id])?state.answers[id]:[];
 return '<fieldset class="choice-set" data-required-group="'+id+'"><legend>'+label+'</legend><div class="choice-list">'+options.map((o,i)=>'<label class="choice-card"><input type="checkbox" name="'+id+'" id="'+id+'-'+i+'" value="'+esc(o.value)+'"'+(selected.includes(o.value)?' checked':'')+'><span>'+o.label+'</span></label>').join('')+'</div><small>Select every line you would pause before sending.</small></fieldset>';
}
function card(title,content){return '<div class="rule"><h3>'+title+'</h3><div class="scenario">'+content+'</div></div>'}
function header(n,title,sub){return '<div class="progress-top"><span>PART '+String(n).padStart(2,'0')+' OF '+String(total).padStart(2,'0')+'</span><span>'+Math.round(n/total*100)+'% complete</span></div><div class="track"><span style="width:'+(n/total*100)+'%"></span></div><div class="activity-kicker">YOUR WORK SAMPLE</div><h2 class="section-title">'+title+'</h2><p class="section-intro">'+sub+'</p>'}
function render(){
 if(state.submitted){showStatus();return}
 if(state.page===total){showStatus(state.submitError||'',!!state.submitting);return}
 let body='';
 if(state.page===0){
  body=header(1,'Let’s get started','A little about you, then a few short activities to show what you notice and how you work.')+
   '<div class="row">'+field('name','Your name',{required:true,placeholder:'Name you go by'})+field('email','Email address',{required:true,type:'email',placeholder:'name@example.com'})+'</div>'+
   field('location','Where are you based?',{required:true,placeholder:'City and country'})+
   card('WHAT TO EXPECT','About 30 minutes, in six short parts. No countdown or webcam. You can pause and come back on this device. A calculator, spell-check and accessibility tools are welcome. Every scenario is fictional.')+
   '<p class="fineprint">If you’d like another format or extra time, email <a class="link" href="mailto:people@mesquaredagency.com">people@mesquaredagency.com</a> before starting. You do not need to share a diagnosis.</p>';
 }
 if(state.page===1){
  body=header(2,'How you like to work','A small snapshot of your preferences. There are no right answers here, and this part is for conversation rather than a score.')+
   choices('workday','Which kind of work gives you the most energy?',[
    {value:'people',label:'Helping someone feel supported and clear about what happens next'},
    {value:'details',label:'Spotting a detail that could cause trouble and fixing it'},
    {value:'systems',label:'Making a useful routine run more smoothly'},
    {value:'learning',label:'Learning a new tool or figuring out a fresh problem'}
   ])+
   choices('busyStyle','When several requests arrive together, what usually helps you get oriented?',[
    {value:'list',label:'Make a short list and check the deadlines'},
    {value:'risk',label:'Look first for anyone’s safety or an urgent service issue'},
    {value:'clarify',label:'Check priorities with the person responsible'},
    {value:'start',label:'Take the first useful step, then update people as I go'}
   ])+
   choices('feedbackStyle','When you receive a correction, what helps you most?',[
    {value:'example',label:'A concrete example of what to change'},
    {value:'context',label:'The reason it matters and the outcome we want'},
    {value:'space',label:'A little time to try the correction, then compare notes'},
    {value:'talk',label:'A quick conversation so I can ask questions'}
   ])+
   area('reliedOn','What do people tend to rely on you for?','A sentence or two is plenty.',350,false);
 }
 if(state.page===2){
  body=header(3,'The numbers, at a glance','A short accuracy check. Use a calculator if you like. Enter rent overdue only; keep the separate payment-plan amount out of the rent total.')+
   card('MONDAY · 12 OCTOBER','Count calendar days after the paid-through date up to and including 12 October. Daily rent = weekly rent ÷ 7, rounded to the nearest cent.<table class="data-table"><caption>Three rent accounts</caption><thead><tr><th>Account</th><th>Weekly rent</th><th>Paid through</th></tr></thead><tbody><tr><td>Patel</td><td>$560</td><td>10 Oct</td></tr><tr><td>Taylor</td><td>$630</td><td>5 Oct</td></tr><tr><td>Doyle</td><td>$490</td><td>28 Sep</td></tr></tbody></table>Doyle also missed a separate $140 instalment due 9 October.')+
   '<div class="row">'+field('patelAmount','Patel · rent overdue ($)',{required:true,type:'number'})+field('taylorAmount','Taylor · rent overdue ($)',{required:true,type:'number'})+field('doyleAmount','Doyle · rent overdue ($)',{required:true,type:'number'})+field('rentTotal','Rent overdue across all three ($)',{required:true,type:'number'})+'</div>'+
   choices('planAction','How would you record Doyle’s missed instalment?',[
    {value:'separate',label:'Keep it separate from rent overdue and flag it to the Property Manager'},
    {value:'add',label:'Add $140 to the rent-overdue total'},
    {value:'notice',label:'Send a formal notice myself'},
    {value:'ignore',label:'Leave it out of the summary entirely'}
   ]);
 }
 if(state.page===3){
  body=header(4,'Can you catch the risky lines?','Compare the notes with the draft. Mark anything you would correct or check before it goes to the owner.')+
   card('VERIFIED NOTES','• Bedroom 2 has a ceiling stain after a storm; the cause is unknown.<br>• The hallway smoke alarm chirps and could not be tested.<br>• The bathroom fan is not working.<br>• The tenant privately mentioned their work hours were reduced.')+
   card('DRAFT FROM AN AUTOMATED TOOL','“The tenant caused the stain and will pay for the repair. All alarms passed testing. The tenant may struggle to pay rent. No maintenance is needed.”')+
   checks('riskyLines','Which draft lines would you pause before sending?',[
    {value:'blame',label:'“The tenant caused the stain and will pay for the repair.”'},
    {value:'alarm',label:'“All alarms passed testing.”'},
    {value:'private',label:'“The tenant may struggle to pay rent.”'},
    {value:'maintenance',label:'“No maintenance is needed.”'}
   ])+
   area('ownerSummary','Now write a short owner update using only the verified notes.','Two or three clear sentences. Include any follow-up needed.',500);
 }
 if(state.page===4){
  body=header(5,'Your morning queue','You’re supporting a Property Manager. You can organise routine work and send approved updates. You can book make-safe work up to $1,000; Brett must approve permanent work above that.')+
   '<div class="queue">'+
    '<div class="queue-item"><span class="queue-tag">Now</span><div><p><strong>Tenant · kitchen</strong> — Water is pouring under the sink; they cannot stop it.</p><small>Message arrived 8:52am</small></div></div>'+
    '<div class="queue-item"><span class="queue-tag">Today</span><div><p><strong>Tenant · hot water</strong> — No hot water since Friday. Contractor asks approval for a $2,400 replacement.</p><small>Quote received this morning</small></div></div>'+
    '<div class="queue-item"><span class="queue-tag">11:00</span><div><p><strong>Brett · Property Manager</strong> — Wants the rent summary before your check-in.</p><small>Two accounts need follow-up</small></div></div>'+
    '<div class="queue-item"><span class="queue-tag">Due</span><div><p><strong>Owner · inspection report</strong> — The report is due today and the draft has a few unverified lines.</p><small>Ready to review</small></div></div>'+
   '</div>'+
   choices('firstMove','What needs your first attention?',[
    {value:'leak',label:'Contact the kitchen tenant and start the approved make-safe process; update Brett'},
    {value:'quote',label:'Approve the $2,400 replacement so the contractor can start'},
    {value:'rent',label:'Finish the rent summary before doing anything else'},
    {value:'report',label:'Send the owner report as drafted to meet the deadline'}
   ])+
   choices('quoteMove','What would you do with the $2,400 quote?',[
    {value:'escalate',label:'Ask Brett to decide on the permanent repair; arrange immediate make-safe work within your limit'},
    {value:'approve',label:'Approve the full amount because the tenant needs hot water'},
    {value:'wait',label:'Wait for the next routine check-in before responding'},
    {value:'decline',label:'Decline the quote and tell the tenant to contact the owner'}
   ])+
   area('queuePlan','In a few bullets, what would you do next and who would you update?','Think about the next hour, the 11:00 check-in and what can safely wait.',650);
 }
 if(state.page===5){
  body=header(6,'Your voice and what drives you','Two short prompts. There is no need to have worked in property management before.')+
   card('A TENANT MESSAGE','“The contractor was rude and left a mess. Nobody takes this seriously.”')+
   area('tenantReply','Write a reply you would send.','A few sentences: acknowledge the concern and say what you’ll do next.',500)+
   area('initiative','Tell us about a time you followed something through or made a small process better.','It can be from work, study, volunteering or everyday life. What was happening, what did you do, and what changed or did you learn?',750)+
   area('motivation','What would you be curious to learn first in this role?','Optional · a sentence is fine.',300,false)+
   area('aiUse','If you used generative AI, what did you use it for and how did you check its output?','Optional · “I didn’t use AI” is fine too.',300,false)+
   '<div class="work-note"><strong>Before you finish:</strong> Write in your own words. If an AI tool helped, tell us what you used it for and how you checked the result.</div>'+
   '<p class="fineprint">Your answers are used by the Me² hiring team to review your application. They are sent when you choose Finish; you’ll see a receipt once storage is confirmed.</p>';
 }
 app.innerHTML=body+'<div class="toolbar"><button class="btn secondary" id="back" '+(state.page===0?'disabled':'')+'>Back</button><div><button class="btn primary" id="next">'+(state.page===total-1?'Finish':'Continue')+'</button></div></div><div class="save">Saved on this device</div>';
 app.querySelectorAll('input,textarea').forEach(el=>{el.addEventListener('input',onChange);el.addEventListener('change',onChange)});
 app.querySelectorAll('[data-required-group]').forEach(el=>{});
 app.querySelector('#back').onclick=()=>{state.submissionId=null;state.submitError='';state.page=Math.max(0,state.page-1);save();render();scrollTo(0,0)};
 app.querySelector('#next').onclick=next;
}
function onChange(event){
 const el=event.target;
 if(el.type==='radio'){if(el.checked)state.answers[el.name]=el.value}
 else if(el.type==='checkbox'){
  const key=el.name,current=Array.isArray(state.answers[key])?state.answers[key]:[];
  state.answers[key]=el.checked?[...new Set([...current,el.value])]:current.filter(v=>v!==el.value);
 }else state.answers[el.id]=el.value;
 save();
}
function next(){
 for(const el of app.querySelectorAll('[required]')){
  if(!el.checkValidity()){el.reportValidity();return}
  if(el.type==='radio'){if(el.checked)state.answers[el.name]=el.value}
  else state.answers[el.id]=el.value;
 }
 const requiredGroup=app.querySelector('[data-required-group]');
 if(requiredGroup&&!(state.answers[requiredGroup.dataset.requiredGroup]||[]).length){
  alert('Choose at least one line you would pause before sending.');requiredGroup.scrollIntoView({behavior:'smooth',block:'center'});return;
 }
 if(state.page<total-1){state.page++;state.submissionId=null;state.submitError='';save();render();scrollTo(0,0)}
 else submitAssessment();
}
async function submitAssessment(){
 state.submissionId||=crypto.randomUUID();state.page=total;state.submitting=true;state.submitError='';save();showStatus('',true);
 try{
  const payload={submissionId:state.submissionId,assessment:'Me² — Command Centre Operator Work Sample',completedAt:new Date().toISOString(),candidate:{name:state.answers.name||'',email:state.answers.email||'',location:state.answers.location||''},responses:state.answers};
  const response=await fetch('/api/assessments',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  const result=await response.json().catch(()=>({}));
  if(!response.ok||result.ok!==true||!result.receiptId)throw new Error('not_confirmed');
  state.submitted={receiptId:result.receiptId,submittedAt:new Date().toISOString()};state.answers={};state.submitting=false;
  try{localStorage.removeItem('me2-operator-assessment-v2');localStorage.removeItem('me2-operator-assessment-v3')}catch{}
  save();showStatus();
 }catch{
  state.submitting=false;state.submitError='We could not confirm receipt. Your draft is still saved on this device. Please try again when you’re ready.';save();showStatus(state.submitError,false);
 }
}
function showStatus(message='',pending=false){
 if(state.submitted){
  app.innerHTML='<div class="done"><div class="mark">✓</div><h2>Thanks — we’ve got it.</h2><p>Your work sample has been received by the Me² hiring team.</p><p><strong>Receipt:</strong> '+esc(state.submitted.receiptId)+'</p><p class="privacy">You can close this page now.</p></div>';return;
 }
 if(pending){
  app.innerHTML='<div class="done"><div class="mark">…</div><h2>Sending your work sample</h2><p>Please wait while we confirm it has been stored.</p></div>';return;
 }
 app.innerHTML='<div class="done"><div class="mark">!</div><h2>One small hiccup</h2><p>'+esc(message||'We could not confirm receipt.')+'</p><div class="toolbar"><button class="btn secondary" id="return">Review answers</button><button class="btn primary" id="retry">Try again</button></div></div>';
 const retry=document.querySelector('#retry');if(retry)retry.onclick=submitAssessment;
 const back=document.querySelector('#return');if(back)back.onclick=()=>{state.page=total-1;state.submissionId=null;state.submitError='';save();render();scrollTo(0,0)};
}
render();})();
</body></html>
