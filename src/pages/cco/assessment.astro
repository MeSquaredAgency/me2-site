---
// Command Centre Operator pre-interview assessment for candidates (supplied by EC, 12 Oct 2026).
// A standalone page: its own look, not part of the sales site; noindex and not in routes.json, so it stays out of the sitemap.
// Fonts are self-hosted (the CSP allows font-src 'self' only); answers stay in the candidate's browser until they download them.
import '@fontsource-variable/instrument-sans';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#101d2a">
<meta name="description" content="Me² Command Centre Operator pre-interview assessment"><title>Command Centre Operator Assessment — Me²</title>
<meta name="robots" content="noindex, nofollow">
<style is:inline>
:root{--navy:#101d2a;--deep:#0a141f;--panel:#172938;--line:#304452;--ink:#e9eef1;--muted:#aab7c0;--coral:#ff866c;--mint:#a9d7bd;--paper:#f5f3ee;--text:#182632;--sub:#66737c;--sans:"Instrument Sans Variable",system-ui,sans-serif;--display:"Instrument Sans Variable",system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--navy);color:var(--ink);font:15px/1.65 var(--sans);-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit}.top{max-width:1120px;margin:auto;padding:22px 28px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff18}.brand{font:700 20px var(--display);letter-spacing:-1px}.brand sup{color:var(--coral);font-size:11px}.top a{color:var(--muted);font-size:13px;text-decoration:none}.wrap{max-width:900px;margin:auto;padding:62px 24px 88px}.eyebrow{font-size:11px;letter-spacing:.16em;color:var(--coral);font-weight:700;text-transform:uppercase}.hero h1{font:600 clamp(38px,6vw,58px)/1.08 var(--display);letter-spacing:-.055em;margin:14px 0}.hero p{max-width:710px;color:#bdc7cd;margin:12px 0}.meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.pill{border:1px solid #ffffff23;border-radius:30px;padding:7px 12px;color:#d4dbdf;font-size:12px}.card{background:var(--paper);color:var(--text);border-radius:18px;padding:clamp(22px,5vw,42px);margin-top:32px;box-shadow:0 26px 70px #02080d55}.progress-top{display:flex;justify-content:space-between;align-items:center;color:#68747b;font-size:12px;font-weight:700;letter-spacing:.06em}.track{height:4px;background:#e2e0d8;border-radius:9px;margin:13px 0 29px;overflow:hidden}.track span{display:block;height:100%;width:0;background:var(--coral);transition:width .25s}.section-title{font:700 27px/1.2 var(--display);letter-spacing:-.04em;margin:0 0 7px}.section-intro{color:var(--sub);margin:0 0 24px}.field{margin:18px 0}.field label,.label{display:block;font-weight:700;margin:0 0 7px}.field small,.hint{display:block;color:var(--sub);font-size:13px;margin-top:5px}.field input,.field textarea,.field select{display:block;width:100%;border:1px solid #d6d8d3;border-radius:9px;background:#fff;padding:12px 13px;color:#1b2b36;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:#df816b;box-shadow:0 0 0 3px #e5796122}.field textarea{min-height:105px;resize:vertical}.field textarea.long{min-height:180px}.field select{cursor:pointer}.rule{background:#eae9e2;border-radius:11px;padding:17px 19px;margin:18px 0}.rule h3{margin:0 0 7px;font-size:12px;letter-spacing:.1em}.rule p{margin:5px 0}.scenario{white-space:pre-line}.row{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}.toolbar{display:flex;justify-content:space-between;gap:12px;margin-top:28px}.btn{border:0;border-radius:9px;padding:12px 20px;font-weight:700;cursor:pointer}.btn.primary{background:#172a38;color:#fff}.btn.primary:hover{background:#253d4e}.btn.secondary{background:#e8e7e0;color:#34434c}.btn:disabled{opacity:.45;cursor:not-allowed}.save{color:#78837f;font-size:12px;text-align:right;margin-top:12px}.check{display:flex;gap:10px;align-items:flex-start}.check input{margin-top:6px;accent-color:#d77d67}.foot{color:#94a2ab;font-size:12px;margin-top:25px}.hide{display:none!important}.timerbox{background:#122332;border:1px solid #ffffff1d;border-radius:12px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;color:#c0ccd2;font-size:13px}.timer{font:700 18px var(--display);color:var(--mint);font-variant-numeric:tabular-nums}.timer.warn{color:#ff9a7f}.link{color:#386e82}.privacy{font-size:12px;color:#67747b}.done{text-align:center;padding:25px 5px}.done .mark{font-size:38px;color:#478668}.done h2{font:700 30px var(--display);margin:8px 0}.done p{color:#627078}@media(max-width:650px){.wrap{padding:42px 15px 65px}.top{padding:17px 19px}.row{grid-template-columns:1fr}.card{border-radius:14px}.toolbar .btn{padding:11px 14px}}
</style></head>
<body><header class="top"><div class="brand">Me<sup>²</sup></div><a href="mailto:people@mesquaredagency.com">Questions? Contact the people team ↗</a></header>
<main class="wrap"><section class="hero"><div class="eyebrow">Pre-interview assessment</div><h1>Command Centre<br>Operator</h1><p>A realistic slice of a Monday morning at the Me² Command Centre. We care more about accuracy and judgement than speed or polish. There are no trick questions, but there are deliberate mistakes for you to find.</p><div class="meta"><span class="pill">10 min set-up · not timed</span><span class="pill">60 min assessment</span><span class="pill">3 practical scenarios</span></div></section>
<section class="card" id="app" aria-live="polite"></section><p class="foot">All names, properties and figures are fictional. Your draft is saved in this browser on this device. Avoid shared devices.</p></main>
<script is:inline>
(()=>{'use strict';
const key='me2-operator-assessment-v2', sections=['About you','Before you begin','Scenario 1A · Arrears run','Scenario 1B · Report quality check','Scenario 2 · Triage and judgement','Scenario 3 · Communication','Wrap-up'];
const initial={page:0,answers:{},startedAt:null,remaining:3600,pausedAt:null};let state;try{state={...initial,...JSON.parse(localStorage.getItem(key)||'{}'),answers:{...initial.answers,...(JSON.parse(localStorage.getItem(key)||'{}').answers||{})}}}catch{state={...initial,answers:{}}}
const app=document.querySelector('#app');let clock=null;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const val=n=>esc(state.answers[n]||'');
function save(){localStorage.setItem(key,JSON.stringify(state));const s=document.querySelector('.save');if(s)s.textContent='Draft saved in this browser';}
function field(id,label,opt={}){const v=val(id),req=opt.required?' required':'';let control=opt.options?`<select id="${id}"${req}><option value="">Choose an option</option>${opt.options.map(x=>`<option${v===x?' selected':''}>${esc(x)}</option>`).join('')}</select>`:opt.area?`<textarea id="${id}" class="${opt.long?'long':''}" maxlength="${opt.max||5000}"${req} placeholder="${esc(opt.placeholder||'')}">${v}</textarea>`:`<input id="${id}" type="${opt.type||'text'}" value="${v}"${req} ${opt.min!==undefined?`min="${opt.min}"`:''} ${opt.max!==undefined?`max="${opt.max}"`:''} ${opt.step?`step="${opt.step}"`:''} placeholder="${esc(opt.placeholder||'')}">`;
return `<div class="field"><label for="${id}">${label}${opt.required?' *':''}</label>${control}${opt.hint?`<small>${opt.hint}</small>`:''}</div>`}
function area(id,label,hint='',max=5000,required=false){return field(id,label,{area:true,long:true,hint,max,required})}
function sectionHeader(title,sub){return `<div class="progress-top"><span>STEP ${String(state.page+1).padStart(2,'0')} OF 07</span><span>${String(state.page+1).padStart(2,'0')} / 07</span></div><div class="track"><span style="width:${(state.page+1)/7*100}%"></span></div><h2 class="section-title">${title}</h2><p class="section-intro">${sub}</p>`}
function card(title,txt){return `<div class="rule"><h3>${title}</h3><div class="scenario">${txt}</div></div>`}
const operator=`You CAN:\n• Send approved SMS and email templates.\n• Call tenants and contractors.\n• Book approved, non-emergency work up to $1,000.\n• Update records and draft documents for PM approval.\n\nYou CANNOT:\n• Approve non-emergency spend over $1,000.\n• Issue legal notices, agree to lease breaks or payment plans, or give legal advice. Refer these decisions to Brett (PM).\n\nEMERGENCIES — burst pipes, gas, electrical hazards, no hot water or security risks:\nContact the approved emergency contractor immediately for make-safe or temporary restoration work up to $1,000. Notify Brett as soon as practical. If a permanent repair or quote exceeds $1,000, do not approve that work; escalate it to Brett while the immediate safety or service issue is managed.`;
const ledger=`RENT LEDGER · Monday 12 October 2026\n\n1. R. Patel · 2/14 Hawthorn St, Mitcham\n   $560/wk · Paid to 10 Oct 2026\n\n2. S. Taylor · 7 Kent Ave, Glenelg\n   $630/wk · Paid to 5 Oct 2026\n\n3. K. Doyle · 33 Rose Tce, Prospect\n   $490/wk · Paid to 28 Sep 2026\n   Payment plan agreed by Brett on 6 Oct: normal rent + $140/wk off arrears. First instalment due 9 Oct.\n\n4. A. Morris · 12 Ferris St, Norwood\n   $700/wk · Paid to 9 Oct 2026\n   Direct debit failed on 9 Oct.\n\n5. L. Chen · 5/88 Main North Rd, Prospect\n   $420/wk · Paid to 15 Oct 2026\n\n6. D. Hughes · 21 Wattle Way, Seaton\n   $595/wk · Paid to 22 Sep 2026\n   No escalation logged.`;
const notes=`Property: 7 Kent Ave, Glenelg · Inspection: 9 October 2026\nOwner: Margaret Lee · Tenant on site: S. Taylor\n\n• Overall clean and tidy.\n• Kitchen good. Rangehood filter greasy: tenant to clean.\n• Bathroom exhaust fan not working: maintenance required.\n• Bedroom 2: water stain on ceiling, about 30cm, near the window. Possible roof leak; check after rain. Tenant says it appeared after last month's storm. Cause is not confirmed.\n• Hallway smoke alarm chirping, low battery; could not test it. Living room alarm tested OK.\n• Lawn overgrown: tenant's responsibility under the lease; tenant reminded.\n• Tenant mentioned their hours were cut at work and they may be late with rent. This is confidential and must not appear in the owner report.\n• Next routine inspection: April 2027.`;
const draft=`ROUTINE INSPECTION REPORT · 7 Kent Avenue, Glenelg\nPrepared for: Margaret Lee (owner)\nInspection date: 9 October 2026 | Tenant: Sam Taylor | Mobile: 0412 555 019\n\nOverall: The property is presented in excellent condition. Carpets have been professionally cleaned.\nKitchen: Good condition. Rangehood filter requires cleaning (tenant to action).\nBathroom: Good condition.\nBedroom 2: Water stain on ceiling near window caused by tenant. Tenant will be charged for the repair.\nSafety: All smoke alarms tested and compliant.\nGrounds: Lawn overgrown; tenant reminded of lease obligations.\nNotes: Tenant seemed stressed about finances and may fall behind on rent.\nMaintenance required: None.\nNext inspection: October 2027.`;
const inbox=`It is 9:00am Adelaide time on Monday 12 October 2026. These ten items are waiting. Your check-in with Brett is at 11:00am.\n\n#1 · 8:52am · Tenant, 12 Ferris St\nSMS: “Water pouring from under the kitchen sink; I can't turn it off.”\n\n#2 · 8:30am · Brett (PM)\nWants the arrears summary before 11:00am.\n\n#3 · Friday 4:40pm · Plumber\nTenant at 21 Wattle Way has had no hot water since Friday. The plumber sent a $2,400 quote to replace the system and wants approval to start today.\n\n#4 · 8:15am · Tenant, 5/88 Main North Rd\n“Can I break my lease? I've got a job in Melbourne.”\n\n#5 · 8:05am · Owner, 7 Kent Ave\n“I haven't received my inspection report. It was due Friday.”\n\n#6 · 7:00am · Inspection bot\nThree of Friday's reports were generated without photos.\n\n#7 · Sunday 6:10pm · Tenant, 2/14 Hawthorn St\nSays a contractor was rude and left a mess; threatens to complain to Consumer and Business Services.\n\n#8 · Saturday · Leasing inbox\nTwo rental applications for vacant 3 Pine St. Applicant information is private; do not rank applicants or send their details to an AI tool.\n\n#9 · Friday · Marketing\nReview the owner newsletter draft by Friday 16 October.\n\n#10 · 8:40am · Electrician\nCan't attend Tuesday's job at 2/14 Hawthorn St; wants to reschedule.`;
function render(){if(clock)clearInterval(clock);let body='';
if(state.page===0)body=sectionHeader('About you','We use your details only to assess this application.')+`<div class="row">${field('name','Full name',{required:true})}${field('email','Email address',{required:true,type:'email',hint:'We will use this to reply to you.'})}</div>${field('location','Where are you based?',{required:true,hint:'City and country, e.g. Phnom Penh, Cambodia'})}<p class="privacy">No typing test or external account is required. The practical exercises below are designed to show how you work.</p>`;
if(state.page===1)body=sectionHeader('Before you begin','The practical assessment has three scenarios and a suggested total time of 60 minutes. The on-screen clock is a guide, not a cutoff. You can pause it, take a break, or submit what you have if time runs short.')+card('THE SETTING','You support Adelaide Property Network (APN), a property management agency in Adelaide, South Australia. Your Property Manager (PM) is Brett. The scenario takes place on Monday 12 October 2026. Adelaide business hours begin at 9:00am (5:30am in Phnom Penh). All names, properties and figures are fictional.')+card('YOUR ROLE & DECISION LIMITS',operator)+`<div class="rule"><h3>TOOLS, ACCESSIBILITY & ADJUSTMENTS</h3><p>You may use calculators, Google and AI tools. We score the quality and safety of your final answers, not whether you used AI. Check any AI output carefully. Never paste tenant, owner or applicant details into an unapproved tool; practice privacy-safe handling even though the case details here are fictional.</p><p>We welcome different communication and working styles. There are no “culture fit” answers; we assess how you communicate, handle feedback, protect people’s information and make decisions. If you need an adjustment, extra time or another format, email <a class="link" href="mailto:people@mesquaredagency.com">people@mesquaredagency.com</a> before you start. You do not need to disclose a diagnosis in this assessment.</p><p>Your draft is saved in this browser on this device until cleared. Avoid a shared device. At the end, download your responses and email them to the people team.</p></div><div class="field check"><input id="confirm" type="checkbox" ${state.answers.confirm?'checked':''}><label for="confirm">I have read the instructions and authority limits.</label></div>`;
if(state.page===2){body=sectionHeader('Scenario 1A · Arrears run','Suggested time: 12 minutes. Work out each rent arrears amount, choose the policy action and calculate the total.')+card('CALCULATION RULE','For this exercise, the paid-to date is the last date rent was paid through. Count calendar days from the following day up to and including Monday 12 October. Daily rent = weekly rent ÷ 7, rounded to the nearest cent. Amount in arrears = daily rent × unpaid days. A future paid-to date means $0 in arrears. Enter rent arrears only; do not add an existing arrears balance or plan instalment that is not shown in the ledger.')+card('POLICY','Day 1–2: record and monitor; no reminder yet.\nDay 3–6: send the approved SMS reminder.\nDay 7–13: send the approved email and make a phone call.\nDay 14+: escalate to Brett for a decision; do not issue a breach notice yourself.\nIf an agreed payment-plan instalment is overdue, tell Brett as a separate issue. For K. Doyle, flag both the overdue instalment and the 14-day rent arrears in one escalation; Brett decides the next step. Do not add the $140 plan instalment to the rent-arrears calculation.')+card('RENT LEDGER',ledger);const people=[['patel','R. Patel, 2/14 Hawthorn St'],['taylor','S. Taylor, 7 Kent Ave'],['doyle','K. Doyle, 33 Rose Tce'],['morris','A. Morris, 12 Ferris St'],['chen','L. Chen, 5/88 Main North Rd'],['hughes','D. Hughes, 21 Wattle Way']];for(const [id,label] of people)body+=`<div class="row">${field(id+'Amt',`${label}: amount in arrears ($)`,{required:true,type:'number',min:0,step:'0.01',hint:'Enter 0 if the tenant is in credit.'})}${field(id+'Action',`${label}: policy action`,{required:true,options:['Record and monitor; no reminder yet','Send approved SMS reminder','Send approved email + phone call','Escalate to Brett: day 14+; Brett decides next step','Escalate both: overdue plan instalment + day 14+ arrears','In credit; no action']})}</div>`;body+=field('total','Total rent arrears across all six tenancies ($)',{required:true,type:'number',min:0,step:'0.01'})+field('ledgerNote','What should Brett know from this ledger, beyond the total? (optional)',{area:true});}
if(state.page===3)body=sectionHeader('Scenario 1B · Check the AI draft','Suggested time: 13 minutes. Brett’s notes are the source of truth. Identify factual errors, unsupported claims, privacy concerns and needed follow-up. Do not spend time editing style unless it changes meaning.')+card('BRETT’S FIELD NOTES',notes)+card('AI DRAFT FOR THE OWNER',draft)+area('problems','What needs correcting or checking?','List each issue and the correction or follow-up. Include any details the AI invented or any information that should remain confidential.',5000,true)+area('corrected','Your corrected owner report','Write a concise, factual report based only on verified notes. State what needs maintenance and what remains unconfirmed.',5000,true);
if(state.page===4)body=sectionHeader('Scenario 2 · Triage and judgement','Suggested time: 20 minutes. Show what you would do first, what you would delegate or schedule, and what must go to Brett. There can be more than one defensible order; explain your risk and deadline choices.')+card('MONDAY INBOX',inbox)+field('first','Which item needs your first action?',{required:true,options:Array.from({length:10},(_,i)=>`#${i+1}`)})+area('priority','How would you handle the ten items?','For each item, state the immediate action, owner (you / Brett / bot) and target time. Put urgent work first; group routine work if useful. Explain any assumptions. You do not need to invent a contractor name.',3200,true)+area('brett','What decisions or approvals do you need from Brett at 11:00am?','Be specific about the $2,400 quote, the arrears escalation, and any other decision that cannot be made within your authority.',1600,true)+area('automation','Choose one recurring task that could be supported by automation. What checks would you add, and what must a person remain accountable for?','3–5 sentences. Do not propose using applicant, tenant or owner private data in an unapproved AI tool.',1200,true);
if(state.page===5)body=sectionHeader('Scenario 3 · Communication','Suggested time: 15 minutes. Draft messages for Brett to review and approve. Nothing is sent from this assessment.')+card('3A · EMAIL TO OWNER MARGARET LEE','Write a concise email to accompany the corrected inspection report from Scenario 1B. Use Australian English, a professional and warm tone, and include a subject line. Maximum 180 words.')+area('emailDraft','Email to owner Margaret Lee','0 / 180 words',2000,true)+card('3B · SLACK MESSAGE TO BRETT','Summarise the arrears, the missed payment-plan instalment, and the decisions you need from Brett. Maximum 6 lines.')+area('slack','Slack message to Brett','0 / 6 lines',1000,true);
if(state.page===6)body=sectionHeader('Final step · Wrap-up','These questions help us understand how you work. There are no “culture fit” answers; be honest about what helps you do good work.')+area('workStyle','When several requests arrive at once, what helps you stay organised and keep people updated?','Use an example from work, study, volunteering or this assessment. A practical approach is fine.',1400,true)+area('feedback','A reviewer returns a draft with corrections you did not expect. How would you respond, and what would you do next?','We are interested in how you clarify feedback, correct the work and prevent repeat errors.',1400,true)+area('support','What would help you do accurate work in your first month in this role? (optional)','For example: clear priorities, a checklist, a named person for escalation, or practice with a system.',1000)+area('ai','Which AI tools did you use, and for what?','Using AI will not lower your score. Write “None” if you did not use any.',1000,true)+area('anything','Anything else you would like the hiring team to know? (optional)','You can note an assumption, an unfinished item, or where you took a different approach.',1200)+`<div class="rule"><h3>PRIVACY & SUBMISSION</h3><p>Your responses are used to assess your application and are seen by the Me² hiring team. They are saved in this browser until downloaded. Download your response file and email it to <a class="link" href="mailto:people@mesquaredagency.com">people@mesquaredagency.com</a>. Please use a private device where possible.</p></div>`;
app.innerHTML=body+`<div class="toolbar"><button class="btn secondary" id="back" ${state.page===0?'disabled':''}>Back</button><div>${state.page===6?'<button class="btn secondary" id="download">Download response</button>':''}<button class="btn primary" id="next">${state.page===6?'Finish':'Continue'}</button></div></div><div class="save">Draft saved in this browser</div>`;
app.querySelectorAll('input:not([type=checkbox]),textarea,select').forEach(el=>{el.addEventListener('input',()=>{state.answers[el.id]=el.value;save()});el.addEventListener('change',()=>{state.answers[el.id]=el.value;save()})});const check=app.querySelector('#confirm');if(check)check.addEventListener('change',()=>{state.answers.confirm=check.checked;save()});if(state.page===5){counter('emailDraft',180,'words');counter('slack',6,'lines')}app.querySelector('#back').onclick=()=>{state.page=Math.max(0,state.page-1);save();render();scrollTo(0,0)};app.querySelector('#next').onclick=next;if(app.querySelector('#download'))app.querySelector('#download').onclick=download;if(state.page>=2&&state.page<=5)showTimer();}
function counter(id,max,kind){const el=document.getElementById(id);if(!el)return;const note=document.createElement('small');note.className='hint';el.after(note);const update=()=>{const n=kind==='words'?(el.value.trim()?el.value.trim().split(/\s+/).length:0):el.value.split('\n').length;note.textContent=`${n} / ${max} ${kind}`;el.setCustomValidity(n>max?`Please keep this response to ${max} ${kind}.`:'' )};el.addEventListener('input',update);update()}
function showTimer(){const box=document.createElement('div');box.className='timerbox';box.innerHTML='<span>Suggested time remaining · pause any time</span><span><span class="timer" id="time"></span> <button class="btn secondary" id="pauseClock" type="button">Pause</button></span>';app.insertBefore(box,app.children[2]);const toggle=()=>{if(!state.startedAt)return;if(state.pausedAt){state.startedAt+=Date.now()-state.pausedAt;state.pausedAt=null;document.querySelector('#pauseClock').textContent='Pause'}else{state.remaining=Math.max(0,3600-Math.floor((Date.now()-state.startedAt)/1000));state.pausedAt=Date.now();document.querySelector('#pauseClock').textContent='Resume'}save();tick()};document.querySelector('#pauseClock').onclick=toggle;tick();clock=setInterval(tick,1000)}function tick(){if(!state.startedAt)return;if(state.pausedAt){const b=document.querySelector('#pauseClock');if(b)b.textContent='Resume';return}let elapsed=Math.floor((Date.now()-state.startedAt)/1000);state.remaining=Math.max(0,3600-elapsed);const el=document.querySelector('#time');if(el){el.textContent=`${String(Math.floor(state.remaining/60)).padStart(2,'0')}:${String(state.remaining%60).padStart(2,'0')}`;if(state.remaining<300)el.classList.add('warn')}if(state.remaining===0){save();clearInterval(clock)}}
function next(){for(const el of app.querySelectorAll('[required]')){if(!el.checkValidity()){el.reportValidity();return}state.answers[el.id]=el.value}if(state.page===1&&!state.answers.confirm){alert('Please confirm that you have read the instructions and authority limits.');return}if(state.page===1&&!state.startedAt){state.startedAt=Date.now();state.remaining=3600}if(state.page<6){state.page++;save();render();scrollTo(0,0)}else{state.page=7;save();app.innerHTML=`<div class="done"><div class="mark">✓</div><h2>Assessment complete</h2><p>Your responses are ready to download. Send the downloaded file to <a class="link" href="mailto:people@mesquaredagency.com">people@mesquaredagency.com</a>.</p><button class="btn primary" id="download">Download response</button><p class="privacy">Your answers remain saved in this browser on this device until cleared.</p></div>`;document.querySelector('#download').onclick=download}}
function download(){const payload={assessment:'Me² — Command Centre Operator Assessment',completedAt:new Date().toISOString(),candidate:{name:state.answers.name||'',email:state.answers.email||'',location:state.answers.location||''},responses:state.answers};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='me2-operator-assessment-response.json';a.click();URL.revokeObjectURL(a.href)}
render();})();
</script></body></html>
