// Cloudflare Workers (static assets) config for the Me² site. See DEPLOY.md.
// Account: Me² (tech: elliot.crabb@mesquaredagency.com). Never deploy this from the APN Real Estate account.
{
  "name": "mesquared",
  "account_id": "813537406785f2957804689d03560623",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The worker runs first so it can redirect www to the bare domain; it hands everything else to the assets.
    "run_worker_first": true
  },
  // Custom domains: Cloudflare creates the DNS records and certificates. www redirects to the bare domain (worker/index.ts).
  "routes": [
    { "pattern": "mesquaredagency.com", "custom_domain": true },
    { "pattern": "www.mesquaredagency.com", "custom_domain": true }
  ],
  // The enquiry form emails through Resend (worker/index.ts), using the RESEND_API_KEY secret set in the
  // Cloudflare dashboard (never in this file). See DEPLOY.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "me2-assessment-submissions",
      "database_id": "6a4427d9-8b99-4c11-8cb4-ecd659b9c795",
      "migrations_dir": "migrations"
    }
  ],
  // Workers Logs: each enquiry logs one line (sent / dropped / failed, the topic, never the person's details).
  "observability": { "enabled": true },
  // The live site is only on mesquaredagency.com; previews come from `npx wrangler versions upload`.
  "workers_dev": false,
  "preview_urls": true
}
